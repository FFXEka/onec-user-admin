#Область ОписаниеПеременных

&НаКлиенте
Перем РазрешеноЗакрытие; // Программное закрытие после завершения операции.

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если РазрешеноЗакрытие = Истина Или ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Истина;
	// Закрытие после отмены выполняется вне текущего события ПередЗакрытием.
	ПодключитьОбработчикОжидания("ЗапроситьОтмену", 0.1, Истина);
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИдентификаторОперации = "";
	
	Если Параметры.Свойство("ИдентификаторОперации") Тогда
		ИдентификаторОперации = Параметры.ИдентификаторОперации;
	КонецЕсли;
	
	Если Параметры.Свойство("ЗаголовокОперации") Тогда
		Заголовок = Параметры.ЗаголовокОперации;
	КонецЕсли;
	
	Если Параметры.Свойство("ПодсказкаОтмены") Тогда
		Элементы.ПодсказкаОтмены.Заголовок = Параметры.ПодсказкаОтмены;
	КонецЕсли;
	
	Элементы.ПодсказкаОтмены.Видимость = Не ПустаяСтрока(Элементы.ПодсказкаОтмены.Заголовок);
	Элементы.ТекстХодаОперации.Заголовок = НСтр("ru='Подготовка…'");
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	СведенияПлатформы = Новый СистемнаяИнформация;
	Версия = СтрРазделить(СведенияПлатформы.ВерсияПриложения, ".");
	
	Если Число(Версия[0]) = 8 И Число(Версия[1]) >= 5 Тогда
		
		Вариант = КлиентскоеПриложение.ТекущийВариантИнтерфейса();
		
		Если Вариант <> ВариантИнтерфейсаКлиентскогоПриложения.Такси
			И Вариант <> ВариантИнтерфейсаКлиентскогоПриложения.Версия8_2 Тогда
			// Воздушный интерфейс добавляет отступы и использует более крупный шрифт.
			Высота = 12;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не ПустаяСтрока(ИдентификаторОперации) Тогда
		Оповестить("АудитПользователей.ХодГотов", ИдентификаторОперации, ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "АудитПользователей.ЗакрытьХод" И Параметр = ИдентификаторОперации Тогда
		Завершить();
	ИначеЕсли ИмяСобытия = "АудитПользователей.Ход" Тогда
		
		Если ТипЗнч(Параметр) <> Тип("Структура") Или Параметр.Идентификатор <> ИдентификаторОперации Тогда
			Возврат;
		КонецЕсли;
		
		Если Параметр.Ожидание Тогда
			ПоказатьОжидание(Параметр.Текст);
		Иначе
			
			Элементы.ИндикаторХодаОперации.Видимость = Истина;
			ПоказатьПрогресс(Параметр.Текст, Параметр.Процент, Параметр.Подробности);
			Элементы.Отменить.Доступность = Параметр.МожноОтменить;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Отменить(Команда)
	
	ЗапроситьОтмену();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПоказатьПрогресс(Текст, Процент, Подробности = "")
	
	ПроцентВыполнения = Мин(100, Макс(0, Процент));
	Элементы.ТекстХодаОперации.Заголовок = Текст;
	Элементы.ПодсказкаОтмены.Заголовок = Подробности;
	Элементы.ПодсказкаОтмены.Видимость = Не ПустаяСтрока(Подробности);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьОжидание(Текст)
	
	Элементы.ТекстХодаОперации.Заголовок = Текст;
	Элементы.ИндикаторХодаОперации.Видимость = Ложь;
	Элементы.ПодсказкаОтмены.Видимость = Ложь;
	Элементы.Отменить.Доступность = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура Завершить()
	
	Если РазрешеноЗакрытие = Истина Тогда
		Возврат;
	КонецЕсли;
	
	РазрешеноЗакрытие = Истина;
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьОтмену()
	
	Если Не Элементы.Отменить.Доступность Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.Отменить.Доступность = Ложь;
	Элементы.ТекстХодаОперации.Заголовок = НСтр("ru='Отмена операции…'");
	Оповестить("АудитПользователей.Отмена", ИдентификаторОперации, ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИдентификаторДиалога = Параметры.ИдентификаторДиалога;
	Настройки = Параметры.Настройки;
	ОжидаемаяДлина = Настройки.МинимальнаяДлина;
	ОжидаемаяСложность = Настройки.Сложность;
	МинимальнаяДлина = Макс(12, ОжидаемаяДлина);
	ПроверятьСложность = Истина;
	Элементы.ФактическиеНастройки.Заголовок
		= СтрШаблон(НСтр("ru='Сейчас: минимум %1 символов; проверка сложности: %2.'"),
		ОжидаемаяДлина, ?(ОжидаемаяСложность, НСтр("ru='включена'"), НСтр("ru='выключена'")));
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия <> "АудитПользователей.РезультатПолитики" Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Параметр) <> Тип("Структура") Или Параметр.Идентификатор <> ИдентификаторДиалога Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПустаяСтрока(Параметр.Ошибка) Тогда
		ПоказатьОшибку(Параметр.Ошибка);
	Иначе
		ПоказатьРезультат(Параметр.Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если Не ЗавершениеРаботы И Не Отказ Тогда
		Оповестить("АудитПользователей.ПолитикаЗакрыта", ИдентификаторДиалога, ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Применить(Команда)
	
	Если ПроверятьСложность И МинимальнаяДлина < 7 Тогда
		
		ПоказатьОшибку(НСтр("ru='При проверке сложности нужно не меньше 7 символов.'"));
		
		Возврат;
		
	КонецЕсли;
	
	Ожидаемые = Новый Структура("МинимальнаяДлина,Сложность", ОжидаемаяДлина, ОжидаемаяСложность);
	Выбранные = Новый Структура("Длина,Сложность,Ожидаемые", МинимальнаяДлина, ПроверятьСложность, Ожидаемые);
	Оповестить("АудитПользователей.ПараметрыПолитики", Новый Структура("Идентификатор,Значения", ИдентификаторДиалога,
		Выбранные), ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура Отменить(Команда)
	
	Закрыть();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПоказатьОшибку(Текст)
	
	Элементы.ФактическиеНастройки.Заголовок = Текст;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьРезультат(Результат)
	
	ОжидаемаяДлина = Результат.МинимальнаяДлина;
	ОжидаемаяСложность = Результат.Сложность;
	
	Если Результат.Успех Тогда
		Закрыть();
	Иначе
		ПоказатьОшибку(Результат.Текст);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область АудитПользователей

&НаСервере
Процедура ПроизвестиАудитПользователейНаСервере()
	
	СброситьСнимокАудита();
	
	// Перечитывается только общий аудит; найденные пароли подтверждаются по прежнему состоянию, без перебора.
	Обработка = РеквизитФормыВЗначение("Объект");
	Обработка.АктуализироватьПослеРекомендации(Ложь, ПорогНеактивности, АдресПодтвержденийПаролей, 100, 0);
	Обработка.УпорядочитьАудит(ПорядокАудита);
	ЗначениеВРеквизитФормы(Обработка, "Объект");
	ОбщийАудитВыполнен = Истина;
	ЗафиксироватьСнимокАудита(Обработка);
	КатегорияАудита = "";
	ПоискАудита = "";
	ЗаполнитьЗначкиАудита();
	
КонецПроцедуры


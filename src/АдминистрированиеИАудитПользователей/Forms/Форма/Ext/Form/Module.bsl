#Область КомандаСкоприроватьПраваДоступа

&НаКлиенте
Процедура СкопироватьПраваОтПродолжить(Источник, ДополнительныеПараметры) Экспорт
	
	Если Не ЗначениеЗаполнено(Источник) Тогда
		Возврат;
	КонецЕсли;
	
	Возможности = ВозможностиКопированияПравНаСервере(ДополнительныеПараметры.Приемники, Источник);
	
	Если Не Возможности.Доступно Тогда
		
		ПоказатьПредупреждение(, Возможности.Причина);
		
		Возврат;
		
	КонецЕсли;
	
	Частично = Не ПустаяСтрока(Возможности.Ограничения);
	ПараметрыКопирования = Новый Структура("Приемники,Источник,Частично", ДополнительныеПараметры.Приемники, Источник,
		Частично);
	ОписаниеОповещения = Новый ОписаниеОповещения("СкопироватьПраваПослеПодтверждения", ЭтотОбъект,
		ПараметрыКопирования);
	ТекстВопроса = СтрШаблон(НСтр("ru='Заменить права выбранных пользователей (%1) по образцу пользователя «%2»?'"),
		ДополнительныеПараметры.Приемники.Количество(), Источник);
	
	Если Возможности.Исключения.ТекущаяУчетка Тогда
		ТекстВопроса = ТекстВопроса + " " + НСтр("ru='Текущая учётная запись будет пропущена.'");
	КонецЕсли;
	
	Если Возможности.Исключения.Источник Тогда
		ТекстВопроса = ТекстВопроса + " " + НСтр("ru='Источник не включается в получатели прав.'");
	КонецЕсли;
	
	Если Частично Тогда
		ТекстВопроса = НСтр("ru='Возможно только частичное копирование.'") + Символы.ПС
			+ НСтр("ru='Будут перенесены:'") + " " + Возможности.Описание + Символы.ПС
			+ НСтр("ru='Не будут перенесены:'") + " " + Возможности.Ограничения + Символы.ПС
			+ НСтр("ru='Неподдерживаемые назначения получателей сохранятся.'") + Символы.ПС + ТекстВопроса;
	КонецЕсли;
	
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Нет);
	
КонецПроцедуры

&НаСервере
Функция ВозможностиКопированияПравНаСервере(Приемники, Источник)
	
	Обработка = РеквизитФормыВЗначение("Объект");
	Возможности = Обработка.ВозможностиКопированияПрав();
	Возможности.Вставить("Исключения", Обработка.ИсключенияКопированияПрав(Приемники, Источник));
	
	Возврат Возможности;
	
КонецФункции

&НаКлиенте
Процедура СкопироватьПраваПослеПодтверждения(Результат, ПараметрыКопирования) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Код = ?(ПараметрыКопирования.Частично, "КопироватьПоддерживаемые", "Копировать");
	Результат = ДействиеНадПользователямиНаСервере(ПараметрыКопирования.Приемники, Код, ПараметрыКопирования.Источник);
	ОбновитьДинамическиеСпискиПоПользователю();
	ПоказатьРезультатОперации(Результат, Ложь, "Копировать");
	
КонецПроцедуры


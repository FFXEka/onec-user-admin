&НаКлиенте
Процедура HTMLРабочееМестоПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ПроверкаПаролейАктивна Или ДанныеСобытия.Href = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Части = СтрРазделить(Строка(ДанныеСобытия.Href), ":");
	
	Если ВыборСвязи <> Неопределено Тогда
		
		ОбработатьВыборСвязи(Части);
		
		Возврат;
		
	КонецЕсли;
	
	Если КатегорияАудита = "ОбщиеРекомендации" Тогда
		
		ВыполнитьДействиеРекомендации(Части);
		
		Возврат;
		
	КонецЕсли;
	
	Если Части.Количество() <> 5 Или Части[0] <> "about" Или Части[1] <> "blank#v214"
		Или Части[2] <> ВерсияПредставленияАудита Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		Индекс = Число(Части[3]);
	Исключение
		Возврат;
	КонецПопытки;
	
	Если Части[4] = "sort" Тогда
		
		Если Индекс >= 0 И Индекс <= 6 И Индекс = Цел(Индекс)
			И Не РекомендацияВыполняется И Не АктивностьВыполняется Тогда
			УпорядочитьАудитНаСервере(Индекс, ВыбранныеСтрокиАудита());
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	Если Индекс < 0 Или Индекс >= РабочийСписок.Количество() Или Индекс <> Цел(Индекс) Тогда
		Возврат;
	КонецЕсли;
	
	Данные = РабочийСписок[Индекс];
	
	Если Части[4] = "deleteIB" И КатегорияАудита = "Связи" Тогда
		ПредложитьУдалениеУчеткиИБ(Данные);
	ИначеЕсли Части[4] = "standardOff" Тогда
		ПредложитьОтключениеСтандартногоВхода(Данные);
	ИначеЕсли Части[4] = "act" Тогда
		ДействиеДляСтрокиАудита(Данные);
	ИначеЕсли Части[4] = "card" Тогда
		ОткрытьКарточкуИзАудита(Данные);
	ИначеЕсли Части[4] = "select" И Элементы.ВыделитьВсеСтрокиАудита.Доступность Тогда
		ИзменитьВыделениеСтрокиHTML(Индекс, ДанныеСобытия);
	КонецЕсли;
	
КонецПроцедуры


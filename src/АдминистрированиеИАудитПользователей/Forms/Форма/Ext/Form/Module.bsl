#Область ИнформацияОПользователе

&НаКлиенте
Процедура ОбновитьИнформациюОПользователе()
	
	ТекущиеДанные = Элементы.СписокПользователей.ТекущиеДанные;
	
	Пользователь = ?(ТекущиеДанные = Неопределено, Неопределено, ТекущиеДанные.Ссылка);
	
	Если ИнформацияОПользователеИнициализирована = Истина И ОтображаемыйПользователь = Пользователь Тогда
		Возврат;
	КонецЕсли;
	
	// Изменение параметров групп может повторно активировать ту же строку в воздушном интерфейсе.
	ОтображаемыйПользователь = Пользователь;
	ИнформацияОПользователеИнициализирована = Истина;
	
	Попытка
		ОбновитьИнформациюОПользователеНаСервере(Пользователь);
	Исключение
		
		ИнформацияОПользователеИнициализирована = Ложь;
		ВызватьИсключение;
		
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьИнформациюОПользователеНаСервере(Пользователь)
	
	Обработка = РеквизитФормыВЗначение("Объект");
	
	УстановитьПараметрСписковПользователь(Пользователь);
	ИнформацияОПользователе = Обработка.ИнформацияОПользователе(Пользователь);
	
	Для Каждого Информация Из ИнформацияОПользователе Цикл
		ЭтотОбъект["Информация" + Информация.Ключ] = Информация.Значение;
	КонецЦикла;
	
КонецПроцедуры


&НаКлиенте
Процедура ОбновитьСписокПоФлагамПользователей()
	
	ПрименитьОтборыПользователейНаСервере();
	ИнформацияОПользователеИнициализирована = Ложь;
	Элементы.СписокПользователей.Обновить();
	
КонецПроцедуры

&НаСервере
Процедура НастроитьАдминистрированиеПользователей()
	
	Меню = Элементы.МенюДействийПользователя;
	МенюТаблицы = Элементы.РезультатАудитаПользователей.КонтекстноеМеню;
	МенюТаблицы.Видимость = Истина;
	ДобавитьКомандуПользователей("ПодробноПоВозрастанию", НСтр("ru='Сортировать по возрастанию'"),
		"СортироватьПодробныйСписок",
		МенюТаблицы);
	ДобавитьКомандуПользователей("ПодробноПоУбыванию", НСтр("ru='Сортировать по убыванию'"),
		"СортироватьПодробныйСписок",
		МенюТаблицы);
	ДобавитьКомандуПользователей("ВывестиПодробныйСписок", НСтр("ru='Вывести список …'"), "ВывестиПодробныйСписок",
		МенюТаблицы);
	Элементы.СписокПользователей.КонтекстноеМеню.Видимость = Истина;
	ДобавитьКомандуПользователей("БлокироватьПользователя", НСтр("ru='Заблокировать и сделать недействительным'"),
		"БлокироватьПользователя", Меню);
	
	Если ЕстьМетаданныеГруппыДоступа Тогда
		ДобавитьКомандуПользователей("ВключитьВГруппуДоступа", НСтр("ru='Включить в группу доступа …'"),
			"ВключитьВГруппуПользователя", Меню);
	КонецЕсли;
	
	Если ЕстьМетаданныеГруппыПользователей Тогда
		ДобавитьКомандуПользователей("ВключитьВГруппуПользователей", НСтр("ru='Включить в группу пользователей …'"),
			"ВключитьВГруппуПользователя", Меню);
	КонецЕсли;
	
	Для Каждого Имя Из СтрРазделить(
		("ЗапуститьПодПользователем,СкопироватьПраваОт,БлокироватьПользователя,"
			+ "ВключитьВГруппуДоступа,ВключитьВГруппуПользователей"), ",") Цикл
		
		Если Команды.Найти(Имя) <> Неопределено Тогда
			ДобавитьКнопкуКоманды("КонтекстПользователей" + Имя, Имя, Элементы.СписокПользователей.КонтекстноеМеню);
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого Список Из ОтображенныеСпискиСПараметромПользователь Цикл
		
		Если Список.Значение = "ПолномочияТекущегоПользователя" Тогда
			Продолжить; // Полномочия могут наследоваться через контейнеры; это не прямое членство в группе.
		КонецЕсли;
		
		Таблица = Элементы[Список.Значение];
		Таблица.КонтекстноеМеню.Видимость = Истина;
		ДобавитьКомандуПользователей(Список.Значение + "Добавить", НСтр("ru='Включить в группу …'"),
			"КомандаЧленстваГруппы",
			Таблица.КонтекстноеМеню);
		ДобавитьКомандуПользователей(Список.Значение + "Удалить", НСтр("ru='Убрать из группы'"),
			"КомандаЧленстваГруппы",
			Таблица.КонтекстноеМеню);
		Команды[Список.Значение + "Добавить"].Картинка = КартинкаДействияПользователя("Добавить");
		Команды[Список.Значение + "Удалить"].Картинка = КартинкаДействияПользователя("Удалить");
		
	КонецЦикла;
	
	Для Каждого Имя Из СтрРазделить("ВключитьВГруппуДоступа,ВключитьВГруппуПользователей", ",") Цикл
		
		Если Команды.Найти(Имя) <> Неопределено Тогда
			Команды[Имя].Картинка = КартинкаДействияПользователя("Добавить");
		КонецЕсли;
		
	КонецЦикла;
	
	Команды.СкопироватьПраваОт.Картинка = КартинкаДействияПользователя("Копировать");
	Команды.БлокироватьПользователя.Картинка = КартинкаДействияПользователя("Блокировать");
	УпорядочитьМенюДействийПользователя(Меню);
	Команды.ПодробноПоВозрастанию.Картинка = БиблиотекаКартинок.СортироватьСписокПоВозрастанию;
	Команды.ПодробноПоУбыванию.Картинка = БиблиотекаКартинок.СортироватьСписокПоУбыванию;
	Команды.ВывестиПодробныйСписок.Картинка = БиблиотекаКартинок.ВывестиСписок;
	Команды.СохранитьРезультатАудита.Картинка = БиблиотекаКартинок.СохранитьФайл;
	Команды.ПереключитьИнтерфейсСписка.Картинка = БиблиотекаКартинок.ПереместитьВправо;
	Команды.ЗапуститьПодПользователем.Картинка = БиблиотекаКартинок.СтартБизнесПроцесса;
	
	Для Каждого Имя Из СтрРазделить(
		("ПотребоватьПарольВыбранным,ЗаблокироватьВыбранных,НедействительныВыбранные,"
			+ "БлокироватьНеактивныхВыбранных,ИзменитьПорогНеактивности"), ",") Цикл
		
		Элементы[Имя].РастягиватьПоГоризонтали = Ложь;
		Элементы[Имя].АвтоМаксимальнаяШирина = Истина;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УпорядочитьМенюДействийПользователя(Меню)
	
	Порядок = Новый ТаблицаЗначений;
	Порядок.Колонки.Добавить("Элемент");
	Порядок.Колонки.Добавить("Заголовок");
	
	Для Каждого Кнопка Из Меню.ПодчиненныеЭлементы Цикл
		
		СтрокаПорядка = Порядок.Добавить();
		СтрокаПорядка.Элемент = Кнопка;
		СтрокаПорядка.Заголовок = Команды[Кнопка.ИмяКоманды].Заголовок;
		
	КонецЦикла;
	
	Порядок.Сортировать("Заголовок Возр");
	
	Для Каждого СтрокаПорядка Из Порядок Цикл
		Элементы.Переместить(СтрокаПорядка.Элемент, Меню);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция КартинкаДействияПользователя(Имя)
	
	Если Имя = "Добавить" Тогда
		Возврат БиблиотекаКартинок.СоздатьЭлементСписка;
	ИначеЕсли Имя = "Удалить" Тогда
		
		Попытка
			Возврат БиблиотекаКартинок.ОформлениеКрест;
		Исключение
			// В старых платформах нет отдельного красного креста.
			Возврат БиблиотекаКартинок.Удалить;
		КонецПопытки;
		
	ИначеЕсли Имя = "Копировать" Тогда
		Возврат БиблиотекаКартинок.ПеренестиЭлемент;
	ИначеЕсли Имя = "Блокировать" Тогда
		
		Попытка
			Возврат БиблиотекаКартинок.ДиалогСтоп;
		Исключение
			// Сохраняем команду в старых платформах без картинки ДиалогСтоп.
			Возврат БиблиотекаКартинок.Удалить;
		КонецПопытки;
		
	КонецЕсли;
	
	ВызватьИсключение НСтр("ru='Неизвестная картинка действия пользователя.'");
	
КонецФункции

&НаСервере
Процедура ДобавитьКомандуПользователей(Имя, Заголовок, Обработчик, Родитель)
	
	КомандаФормы = Команды.Добавить(Имя);
	КомандаФормы.Заголовок = Заголовок;
	КомандаФормы.Действие = Обработчик;
	ДобавитьКнопкуКоманды("Кнопка" + Имя, Имя, Родитель);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьКнопкуКоманды(Имя, Команда, Родитель)
	
	Кнопка = Элементы.Добавить(Имя, Тип("КнопкаФормы"), Родитель);
	Кнопка.ИмяКоманды = Команда;
	Кнопка.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьОтборыПользователей()
	
	Добавляемые = Новый Массив;
	Флаги = СтрРазделить(
		("ПарольУстановлен,АутентификацияСтандартная,ПоказыватьВСпискеВыбора,"
			+ "АутентификацияOpenID,АутентификацияOpenIDConnect,АутентификацияТокеномДоступа,"
			+ "АутентификацияОС,ЕстьПолныеПрава"), ",");
	
	Для Каждого Имя Из Флаги Цикл
		Добавляемые.Добавить(Новый РеквизитФормы("Отбор" + Имя, Новый ОписаниеТипов("Булево")));
	КонецЦикла;
	
	ИзменитьРеквизиты(Добавляемые);
	ПолеЗаголовкаОтбора = Элементы.Вставить("ЗаголовокОтбораПользователей", Тип("ДекорацияФормы"),
		Элементы.ИнформацияОПользователе, Элементы.ИнформацияПарольУстановлен);
	ПолеЗаголовкаОтбора.Вид = ВидДекорацииФормы.Надпись;
	ПолеЗаголовкаОтбора.Заголовок = НСтр("ru='Отбор'");
	
	Для Каждого Имя Из Флаги Цикл
		
		ПолеИнформации = Элементы["Информация" + Имя];
		СтрокаФлага = Элементы.Вставить("СтрокаФлага" + Имя, Тип("ГруппаФормы"), Элементы.ИнформацияОПользователе,
			ПолеИнформации);
		СтрокаФлага.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		СтрокаФлага.Видимость = ПолеИнформации.Видимость;
		СтрокаФлага.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
		СтрокаФлага.ОтображатьЗаголовок = Ложь;
		ПолеОтбора = Элементы.Добавить("Отбор" + Имя, Тип("ПолеФормы"), СтрокаФлага);
		ПолеОтбора.Вид = ВидПоляФормы.ПолеФлажка;
		ПолеОтбора.ПутьКДанным = "Отбор" + Имя;
		ПолеОтбора.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
		ПолеОтбора.Подсказка = НСтр("ru='Отбирать:'") + " " + ПолеИнформации.Заголовок;
		ПолеОтбора.УстановитьДействие("ПриИзменении", "Отбор" + Имя + "ПриИзменении");
		Элементы.Переместить(ПолеИнформации, СтрокаФлага);
		ПолеИнформации.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
		ПолеИнформации.Доступность = Ложь;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПрименитьОтборыПользователейНаСервере()
	
	Флаги = Новый Структура;
	
	Для Каждого Имя Из СтрРазделить(
		("ПарольУстановлен,АутентификацияСтандартная,ПоказыватьВСпискеВыбора,"
			+ "АутентификацияOpenID,АутентификацияOpenIDConnect,АутентификацияТокеномДоступа,"
			+ "АутентификацияОС,ЕстьПолныеПрава"), ",") Цикл
		
		Если ЭтотОбъект["Отбор" + Имя] Тогда
			Флаги.Вставить(Имя, Истина);
		КонецЕсли;
		
	КонецЦикла;
	
	ОтборФлагов = Неопределено;
	
	Для Каждого Условие Из СписокПользователей.Отбор.Элементы Цикл
		
		Если Условие.Представление = "Флаги учётной записи 1С" Тогда
			
			ОтборФлагов = Условие;
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ОтборФлагов = Неопределено Тогда
		
		ОтборФлагов = СписокПользователей.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборФлагов.Представление = НСтр("ru='Флаги учётной записи 1С'");
		ОтборФлагов.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ИдентификаторПользователяИБ");
		ОтборФлагов.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
		
	КонецЕсли;
	
	ОтборФлагов.Использование = Флаги.Количество() > 0;
	
	Если ОтборФлагов.Использование Тогда
		ОтборФлагов.ПравоеЗначение = РеквизитФормыВЗначение("Объект").ИдентификаторыПоФлагамПользователей(Флаги);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ВыбранныйПользовательСписка()
	
	Данные = Элементы.СписокПользователей.ТекущиеДанные;
	
	Если Данные = Неопределено Тогда
		ВызватьИсключение НСтр("ru='Выберите пользователя.'");
	КонецЕсли;
	
	Возврат Данные.Ссылка;
	
КонецФункции

&НаКлиенте
Процедура ПодтвержденаБлокировкаПользователя(Ответ, Пользователь) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		Результат = ДействиеНадПользователямиНаСервере(Пользователь, "Блокировать");
		ПоказатьРезультатОперации(Результат, Ложь, "Блокировать");
		ИнформацияОПользователеИнициализирована = Ложь;
		Элементы.СписокПользователей.Обновить();
		
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьИзменениеГруппы(Справочник, Добавить, Группа = Неопределено)
	
	Попытка
		
		Если Добавить И Справочник = "ГруппыПользователей"
			И Не ГруппыПользователейИспользуютсяНаСервере() Тогда
			
			ПоказатьПредупреждение(,
				НСтр(
					"ru='В настройках программы отключено использование групп пользователей. Включите эту возможность в штатных настройках, затем повторите действие.'"));
			
			Возврат;
			
		КонецЕсли;
		
		ДанныеДействия = Новый Структура("Пользователь,Группа,Добавить", ВыбранныйПользовательСписка(), Группа,
			Добавить);
		ДанныеДействия.Вставить("Пользователи", ВыбранныеПользователиСписка());
		
		Если Добавить Тогда
			
			ПараметрыВыбора = Новый Структура("РежимВыбора,ЗакрыватьПриВыборе", Истина, Истина);
			ОткрытьФорму("Справочник." + Справочник + ".ФормаВыбора", ПараметрыВыбора, ЭтотОбъект, , , ,
				Новый ОписаниеОповещения("ВыбранаГруппаПользователя", ЭтотОбъект, ДанныеДействия));
			
		ИначеЕсли ЗначениеЗаполнено(Группа) Тогда
			ПоказатьВопрос(Новый ОписаниеОповещения("ПодтвержденоИсключениеИзГруппы", ЭтотОбъект, ДанныеДействия),
				СтрШаблон(НСтр("ru='Убрать пользователя из группы «%1»?'"), Строка(Группа)), РежимДиалогаВопрос.ДаНет,
					0,
					КодВозвратаДиалога.Нет);
		КонецЕсли;
		
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Функция ГруппыПользователейИспользуютсяНаСервере()
	
	Возврат РеквизитФормыВЗначение("Объект").ГруппыПользователейИспользуются();
	
КонецФункции

&НаКлиенте
Процедура ВыбранаГруппаПользователя(Группа, ДанныеДействия) Экспорт
	
	Если Не ЗначениеЗаполнено(Группа) Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеДействия.Группа = Группа;
	ВыполнитьИзменениеГруппы(ДанныеДействия);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтвержденоИсключениеИзГруппы(Ответ, ДанныеДействия) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ВыполнитьИзменениеГруппы(ДанныеДействия);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьИзменениеГруппы(ДанныеДействия)
	
	Попытка
		
		Если ДанныеДействия.Добавить Тогда
			
			Результат = ДействиеНадПользователямиНаСервере(ДанныеДействия.Пользователи, "ДобавитьВГруппу",
				ДанныеДействия.Группа);
			ПоказатьРезультатОперации(Результат, Ложь, "ДобавитьВГруппу");
			
		Иначе
			ИзменитьЧленствоГруппыНаСервере(ДанныеДействия);
		КонецЕсли;
		
		ОбновитьДинамическиеСпискиПоПользователю();
		
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ИзменитьЧленствоГруппыНаСервере(ДанныеДействия)
	
	Обработка = РеквизитФормыВЗначение("Объект");
	Обработка.ИзменитьЧленствоГруппы(ДанныеДействия.Пользователь, ДанныеДействия.Группа, ДанныеДействия.Добавить);
	ЗначениеВРеквизитФормы(Обработка, "Объект");
	ЗафиксироватьРезультатАудита(Обработка);
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура ОбновитьАудитПользователей(Продолжение = "", НовыйПорог = 0)
	
	Если ОжидающийОбщийАудит <> Неопределено Или ПроверкаПаролейАктивна Или АктивностьВыполняется
		Или РекомендацияВыполняется Тогда
		Возврат;
	КонецЕсли;
	
	ОжидающийОбщийАудит = Новый Структура("Продолжение,Порог", Продолжение, НовыйПорог);
	ОткрытьОкноХодаОперации(НСтр("ru='Общий аудит'"), "");
	ПоказатьОжиданиеОкнаХода(НСтр("ru='Чтение пользователей и проверка замечаний…'"));
	ПодключитьОбработчикОжидания("ПродолжитьОбщийАудит", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьОбщийАудит()
	
	Если ОжидающийОбщийАудит = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеПродолжения = ОжидающийОбщийАудит;
	
	Попытка
		
		Если ДанныеПродолжения.Порог > 0 Тогда
			
			УстановитьПорогНеактивностиНаСервере(ДанныеПродолжения.Порог);
			АктуализироватьПослеРекомендацииНаСервере();
			
		Иначе
			ПроизвестиАудитПользователейНаСервере();
		КонецЕсли;
		
		ВывестиСообщениеОперации("");
		ЗаписейПротоколаПриАудите = Объект.ПротоколДействий.Количество();
		КарточкаОткрываласьПослеАудита = Ложь;
		Элементы.ХодПроверкиПаролей.Видимость = Ложь;
		
		Статистика = СтатистикаАудитаНаСервере();
		
		Если Статистика.ПовторныхСопоставлений > 0 Тогда
			
			ТекстСообщения = СтрШаблон(НСтр("ru='Повторных сопоставлений пользователя ИБ с записями БСП: %1.
				|Проверьте дубли записей БСП; счётчики ИБ учитывают каждую учётную запись один раз.'"),
				Статистика.ПовторныхСопоставлений);
			ВывестиСообщениеОперации(ТекстСообщения);
			
		КонецЕсли;
		
	Исключение
		
		ОжидающийОбщийАудит = Неопределено;
		ЗакрытьОкноХодаОперации();
		ПоказатьПредупреждение(, НСтр("ru='Общий аудит не выполнен:'") + " "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		Возврат;
		
	КонецПопытки;
	
	ОжидающийОбщийАудит = Неопределено;
	ЗакрытьОкноХодаОперации();
	
	Если ДанныеПродолжения.Продолжение = "Пароли" Тогда
		НачатьАудитПаролей();
	ИначеЕсли ДанныеПродолжения.Продолжение = "Сохранить" Тогда
		НачатьСохранениеРезультата();
	ИначеЕсли ДанныеПродолжения.Продолжение = "Неактивные" Тогда
		ПредложитьДействиеПоОтбору("Неактивные", Новый Массив, ПорогНеактивности, Истина);
	КонецЕсли;
	
КонецПроцедуры

#Область ИнициализацияФормы

&НаСервере
Процедура ОпределитьФункционалПоТекущейКонфигурации()
	
	Настройки = РеквизитФормыВЗначение("Объект").НастройкиСовместимости(ПолныйМеханизмПользователейБСП());
	Элементы.ФормаСкопироватьПраваОт.Видимость = Настройки.КопированиеПоддерживаемыхПравДоступно;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУровниСовместимости()
	
	Настройки = РеквизитФормыВЗначение("Объект").НастройкиСовместимости(ПолныйМеханизмПользователейБСП());
	ЕстьМетаданныеГруппыПользователей = Настройки.ГруппыПользователейДоступны;
	ЕстьМетаданныеГруппыДоступа = Настройки.ГруппыДоступаДоступны;
	ЕстьМетаданныеПрофилиГруппДоступа = Настройки.ПрофилиГруппДоступаДоступны;
	ЕстьМетаданныеРабочиеГруппы = Настройки.РабочиеГруппыДоступны;
	
КонецПроцедуры

#КонецОбласти

#Область ДинамическиеСписки

&НаКлиенте
Процедура ОбновитьДинамическиеСпискиПоПользователю()
	
	ИнформацияОПользователеИнициализирована = Ложь;
	ОбновитьИнформациюОПользователе();
	
	Для Каждого Список Из ОтображенныеСпискиСПараметромПользователь Цикл
		Элементы[Список.Значение].Обновить();
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьНаФормуДинамическиеСписки()
	
	Если ПолныйМеханизмПользователейБСП() Тогда
		ДобавитьГруппыДоступа();
	ИначеЕсли УпрощенныйМеханизмПользователейБСП() Тогда
		ДобавитьГруппыДоступа();
	ИначеЕсли МеханизмПользователейДокументооборота() Тогда
		
		ДобавитьПолномочия();
		ДобавитьРабочиеГруппы();
		
	Иначе
		ДобавитьГруппыДоступа();
	КонецЕсли;
	
	ДобавитьГруппыПользователя();
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьДинамическийСписокНаФорму(ПараметрыДобавления)
	
	ТипыДинамическийСписок = Новый Массив;
	ТипыДинамическийСписок.Добавить(Тип("ДинамическийСписок"));
	ОписаниеТиповДинамическийСписок = Новый ОписаниеТипов(ТипыДинамическийСписок);
	
	НовыйДинамическийСписок = Новый РеквизитФормы(ПараметрыДобавления.ИмяСписка, ОписаниеТиповДинамическийСписок);
	ДобавляемыеРеквизиты = Новый Массив;
	ДобавляемыеРеквизиты.Добавить(НовыйДинамическийСписок);
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	ТекущийДинамическийСписок = ЭтотОбъект[ПараметрыДобавления.ИмяСписка];
	ТекущийДинамическийСписок.АвтоЗаполнениеДоступныхПолей = Ложь;
	ТекущийДинамическийСписок.АвтоматическоеСохранениеПользовательскихНастроек = Ложь;
	ТекущийДинамическийСписок.ДинамическоеСчитываниеДанных = Истина;
	ТекущийДинамическийСписок.ОсновнаяТаблица = ПараметрыДобавления.ОсновнаяТаблицаСписка;
	ТекущийДинамическийСписок.ПроизвольныйЗапрос = Истина;
	ТекущийДинамическийСписок.ТекстЗапроса = ПараметрыДобавления.ТекстЗапроса;
	
	НоваяТаблица = Элементы.Добавить(ПараметрыДобавления.ИмяСписка, Тип("ТаблицаФормы"),
		ПараметрыДобавления.Размещение);
	НоваяТаблица.АвтоМаксимальнаяВысота = Ложь;
	
	Попытка
		НоваяТаблица.ВариантУправленияВысотой = ВариантУправленияВысотойТаблицы.ВСтрокахФормы;
	Исключение
		
		// Совместимый режим высоты остаётся штатным; причина доступна в диагностике администратора.
		СведенияОшибкиВысоты = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		
		Попытка
			ЗаписьЖурналаРегистрации(НСтр("ru='Администрирование пользователей.Высота таблицы'"),
				УровеньЖурналаРегистрации.Примечание, , , СведенияОшибкиВысоты);
		Исключение
			Сообщить(СведенияОшибкиВысоты);
		КонецПопытки;
		
	КонецПопытки;
	
	НоваяТаблица.Заголовок = ПараметрыДобавления.Заголовок;
	НоваяТаблица.ИзменятьПорядокСтрок = Ложь;
	НоваяТаблица.ИзменятьСоставСтрок = Ложь;
	НоваяТаблица.КоманднаяПанель.Видимость = Ложь;
	НоваяТаблица.КонтекстноеМеню.Видимость = Ложь;
	НоваяТаблица.МаксимальнаяВысота = 5;
	НоваяТаблица.Отображение = ОтображениеТаблицы.Список;
	НоваяТаблица.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Верх;
	НоваяТаблица.ПоложениеСостоянияПросмотра = ПоложениеСостоянияПросмотра.Нет;
	НоваяТаблица.ПоложениеСтрокиПоиска = ПоложениеСтрокиПоиска.Нет;
	НоваяТаблица.ПоложениеУправленияПоиском = ПоложениеУправленияПоиском.Нет;
	НоваяТаблица.ПутьКДанным = ПараметрыДобавления.ИмяСписка;
	НоваяТаблица.РазрешитьНачалоПеретаскивания = Ложь;
	НоваяТаблица.РазрешитьПеретаскивание = Ложь;
	НоваяТаблица.Шапка = Ложь;
	
	Для Каждого ИмяКолонки Из ПараметрыДобавления.Колонки Цикл
		
		НоваяКолонкаТаблицы = Элементы.Добавить(ПараметрыДобавления.ИмяСписка + ИмяКолонки, Тип("ПолеФормы"),
			НоваяТаблица);
		НоваяКолонкаТаблицы.ПутьКДанным = ПараметрыДобавления.ИмяСписка + "." + ИмяКолонки;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьГруппыДоступа()
	
	Если Не ЕстьМетаданныеГруппыДоступа Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыДобавления = НовыеПараметрыДобавленияДинамическогоСписка();
	
	ПараметрыДобавления.ИмяСписка = "ГруппыДоступаТекущегоПользователя";
	ПараметрыДобавления.Заголовок = НСтр("ru='Группы доступа'");
	ПараметрыДобавления.ТекстЗапроса = ?(ЕстьМетаданныеГруппыПользователей,
		ТекстЗапросаГруппыДоступа(),
		ТекстЗапросаГруппыДоступаБезГруппПользователя());
	ПараметрыДобавления.ОсновнаяТаблицаСписка = "Справочник.ГруппыДоступа";
	ПараметрыДобавления.Размещение = Элементы.ИнформацияОПользователе;
	ПараметрыДобавления.Колонки.Добавить("Ссылка");
	
	ДобавитьДинамическийСписокНаФорму(ПараметрыДобавления);
	
	ОтображенныеСпискиСПараметромПользователь.Добавить(ПараметрыДобавления.ИмяСписка);
	
КонецПроцедуры


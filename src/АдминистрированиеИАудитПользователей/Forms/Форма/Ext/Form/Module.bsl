#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Элементы.ХодПроверкиПаролей.Видимость = Ложь;
	ОбновитьДоступностьДействийПользователя();
	НастроитьРазмерыДляКлиента();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	// При завершении приложения серверные вызовы запрещены. Хранилище освободится вместе с формой.
	
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;
	
	ОтключитьОбработчикОжидания("ПодготовитьПроверкуПаролей");
	ОжидающаяПодготовкаПаролей = Неопределено;
	ОтключитьОбработчикОжидания("ПродолжитьМассовоеДействие");
	ОжидающееМассовоеДействие = Неопределено;
	ОтключитьОбработчикОжидания("ПродолжитьОбщийАудит");
	ОтключитьОбработчикОжидания("ПродолжитьСравнениеСнимка");
	ОжидающийОбщийАудит = Неопределено;
	ОтключитьОбработчикОжидания("ПродолжитьРекомендацию");
	ОтключитьОбработчикОжидания("ОбновитьАудитПослеРекомендации");
	ОжидающееСообщениеРекомендации = Неопределено;
	ОсвободитьРекомендациюНаСервере(АдресРекомендации);
	ЗакрытьОкноХодаОперации();
	ОсвободитьСостояниеАктивности();
	ОсвободитьПодтвержденияПаролей();
	
	Если ЗначениеЗаполнено(АдресПроверкиПаролей) Тогда
		
		ОтключитьОбработчикОжидания("ПродолжитьПроверкуПаролей");
		
		Попытка
			ОсвободитьПроверкуПаролейНаСервере(АдресПроверкиПаролей);
		Исключение
			// Закрытие формы дополнительно освобождает её временное хранилище.
			АдресПроверкиПаролей = "";
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПорогНеактивности = РеквизитФормыВЗначение("Объект").ПорогНеактивностиАудита();
	ПоказыватьПустыеКатегории = Ложь;
	
	Если Параметры.Свойство("ПоказыватьПустыеКатегории") Тогда
		ПоказыватьПустыеКатегории = Параметры.ПоказыватьПустыеКатегории;
	КонецЕсли;
	
	СписокПользователей.ОсновнаяТаблица = "Справочник.Пользователи";
	НастроитьПредставлениеАудита();
	НастроитьАктивностьПользователей();
	НастроитьДействияПользователя();
	ОпределитьТекущуюКонфигурацию();
	ОпределитьФункционалПоТекущейКонфигурации();
	
	УстановитьУровниСовместимости();
	
	ДобавитьНаФормуДинамическиеСписки();
	НастроитьАдминистрированиеПользователей();
	НастроитьОтборыПользователей();
	УстановитьПараметрСписковПользователь();
	
	ИзменитьВидимостьНедействительныхПользователей();
	ОбновитьHTMLКатегорий();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "АудитПользователей.ХодГотов" Тогда
		
		Если Параметр = ИдентификаторОкнаХода И СостояниеОкнаХода <> Неопределено Тогда
			Оповестить("АудитПользователей.Ход", СостояниеОкнаХода, ЭтотОбъект);
		КонецЕсли;
		
		Если Параметр = ИдентификаторОкнаХода И ОжидающееМассовоеДействие <> Неопределено Тогда
			ПодключитьОбработчикОжидания("ПродолжитьМассовоеДействие", 1, Истина);
		КонецЕсли;
		
		Если Параметр = ИдентификаторОкнаХода И ОжидающаяПодготовкаПаролей <> Неопределено Тогда
			
			Если Не ОжидающаяПодготовкаПаролей.Запланировано Тогда
				
				ОжидающаяПодготовкаПаролей.Запланировано = Истина;
				ПодключитьОбработчикОжидания("ПодготовитьПроверкуПаролей", 1, Истина);
				
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ИмяСобытия = "АудитПользователей.Отмена" И Параметр = ИдентификаторОкнаХода Тогда
		ОтменаИзОкнаХодаОперации();
	ИначеЕсли ИмяСобытия = "АудитПользователей.ПолитикаЗакрыта" И Параметр = ИдентификаторДиалогаПаролей Тогда
		
		ИдентификаторДиалогаПаролей = Неопределено;
		ОбновитьРекомендацииНаСервере();
		
	ИначеЕсли ИмяСобытия = "АудитПользователей.ПараметрыПолитики" Тогда
		
		Если ТипЗнч(Параметр) = Тип("Структура") И Параметр.Идентификатор = ИдентификаторДиалогаПаролей Тогда
			ТребованияПаролейВыбраны(Параметр.Значения, Неопределено);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


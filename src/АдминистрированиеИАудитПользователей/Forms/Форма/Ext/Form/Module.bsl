		СтандартнаяОбработка = Ложь;
		ДействиеДляСтрокиАудита(Элемент.ТекущиеДанные);
		
		Возврат;
		
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	Если Элемент.ТекущиеДанные <> Неопределено Тогда
		ОткрытьКарточкуИзАудита(Элемент.ТекущиеДанные);
	КонецЕсли;
	

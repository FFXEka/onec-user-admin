	ПараметрыДобавления.Заголовок = НСтр("ru='Группы пользователя'");
	ПараметрыДобавления.ТекстЗапроса = ТекстЗапросаГруппыПользователей();
	ПараметрыДобавления.ОсновнаяТаблицаСписка = "Справочник.ГруппыПользователей";
	ПараметрыДобавления.Размещение = Элементы.ИнформацияОПользователе;
	ПараметрыДобавления.Колонки.Добавить("Ссылка");
	
	ДобавитьДинамическийСписокНаФорму(ПараметрыДобавления);
	
	ОтображенныеСпискиСПараметромПользователь.Добавить(ПараметрыДобавления.ИмяСписка);
	
КонецПроцедуры


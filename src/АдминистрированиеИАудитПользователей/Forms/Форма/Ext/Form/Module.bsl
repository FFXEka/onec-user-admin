	Если ТекущиеДанные = Неопределено Или Не ЗначениеЗаполнено(ТекущиеДанные.Ссылка) Тогда
		
		ПоказатьПредупреждение(, НСтр("ru='Выберите пользователя.'"));
		
		Возврат;
		
	КонецЕсли;
	
	ПараметрыОткрытия = Новый Структура("РежимВыбора", Истина);
	ОписаниеОповещения = Новый ОписаниеОповещения("СкопироватьПраваОтПродолжить",
		ЭтотОбъект,
		Новый Структура("Приемники", ВыбранныеПользователиСписка()));
	
	ОткрытьФорму("Справочник.Пользователи.ФормаВыбора",
		ПараметрыОткрытия,
		ЭтотОбъект, , , ,
		ОписаниеОповещения,

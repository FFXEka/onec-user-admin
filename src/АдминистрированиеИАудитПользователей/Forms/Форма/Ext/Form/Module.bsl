		Оповещение = Новый ОписаниеОповещения("СохранениеПослеВопросаОбАудите", ЭтотОбъект);
		ПоказатьВопрос(Оповещение,
			НСтр("ru='Обновить общий аудит перед сохранением? Проверка паролей повторно не запускается.'"),
			РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Нет);
		

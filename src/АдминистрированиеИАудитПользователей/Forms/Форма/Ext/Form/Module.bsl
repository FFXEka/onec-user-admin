&НаКлиенте
Процедура РассчитатьДействияПользователя(Команда)
	
	Если АктивностьВыполняется Или ПроверкаПаролейАктивна Или РекомендацияВыполняется Тогда
		Возврат;
	КонецЕсли;
	
	КоличествоДней = (НачалоДня(ДействияПользователяПериод.ДатаОкончания) - НачалоДня(
		ДействияПользователяПериод.ДатаНачала)) / 86400 + 1;
	
	Если КоличествоДней >= 32 И ДлительныйПериодДействийПодтвержден <> Истина Тогда
		
		Оповещение = Новый ОписаниеОповещения("ДлительныйРасчетДействийПодтвержден", ЭтотОбъект);
		ПоказатьВопрос(Оповещение,
			НСтр(
				"ru='Сбор данных за длительный период может занять продолжительное время. Рекомендуем выбирать период не больше одного месяца. Продолжить?'"),
			РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Нет);
		
		Возврат;
		
	КонецЕсли;
	
	НачатьЧтениеАктивности(Истина);
	

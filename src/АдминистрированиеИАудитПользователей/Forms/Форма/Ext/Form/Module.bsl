&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьПодробностейАудита(ЭлементыФормы, Подробно, АктивностьДоступна)
	
	Имена = СтрРазделить("НайденПользовательИБ,Недействителен,ПарольУстановлен,ПоказыватьВСпискеВыбора,"
		+ "ЕстьПолныеПрава,НетНикакихПрав,ПользовательБСП,ПользовательОС,ИдентификаторПользователяИБ,"
		+ "ИмяПользователяБСП,ИмяФизическогоЛица,ДатаПоследнейАктивности,СтатусПроверкиАктивности,"
		+ "ЕстьАдминистративныеПрава,КоличествоРолей,СписокРолей,ДатаУстановкиПароля,"
		+ "ПометкаУдаленияБСП,ФизическоеЛицо,АутентификацияТокеномДоступа", ",");
	
	Для Каждого Имя Из Имена Цикл
		ЭлементыФормы["РезультатАудитаПользователей" + Имя].Видимость = Подробно;
	КонецЦикла;
	
	ЭлементыФормы.АудитПользователейТипыАутентификации.Видимость = Подробно;
	ЭлементыФормы.КолонкаПоследнийВход.Видимость = АктивностьДоступна;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьПредставлениеАудита()
	
	КатегорияАудита = "Все";
	ПорядокАудита = 0;
	НастроитьТекстДнейАктивности();
	ПредставлениеАудита = 0;
	ОбновитьРасположениеАудитаНаСервере();
	ОбновитьВидимостьСписковАудита();
	Элементы.СписокПользователей.ПутьКДаннымКартинкиСтроки = "СписокПользователей.СтандартнаяКартинка";
	Обработка = РеквизитФормыВЗначение("Объект");
	АдресКритическогоЗначка = ПоместитьВоВременноеХранилище(
		Обработка.ПолучитьМакет("КритическоеЗамечание"), УникальныйИдентификатор);
	АдресЗначкаВнимания = ПоместитьВоВременноеХранилище(
		Обработка.ПолучитьМакет("ПредупреждениеАудита"), УникальныйИдентификатор);
	АдресЗначкаРекомендаций = ПоместитьВоВременноеХранилище(Новый Картинка(Base64Значение(
		("iVBORw0KGgoAAAANSUhEUgAAABAAAAAQCAYAAAAf8/9hAAAAeklEQVR4nGNgoBAwInM0cpf+J0b"
			+ "TjcnRcH1MpGpGV8tEqmZ0Q5gYKARMpCi+PimKfAOuQzWjG8JEqs2aecsIG3Adi1OxacZqwHU0p8"
			+ "JobJqxGqCJpBCXS/AagM02XLbjDURNqCZ8mkEAnqZJTY2w/AB3AXIGIVYzVQAAbNcuUCH8ReIAA" + "AAASUVORK5CYII="))),
			УникальныйИдентификатор);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЗначкиАудита()
	
	Для Каждого СтрокаАудита Из Объект.АудитПользователей Цикл
		
		СтрокаАудита.КартинкаЗамечаний = "";
		
		Если СтрокаАудита.УровеньЗамечаний = 2 Тогда
			СтрокаАудита.КартинкаЗамечаний = АдресКритическогоЗначка;
		ИначеЕсли СтрокаАудита.УровеньЗамечаний = 1 Тогда
			СтрокаАудита.КартинкаЗамечаний = АдресЗначкаВнимания;
		КонецЕсли;
		
		СтрокаАудита.КартинкаАктивности = ?(СтрокаАудита.ПредупреждениеАктивности, АдресЗначкаВнимания, "");
		
	КонецЦикла;
	
	// Порядок колонок задаётся при открытии формы и переключении вида списка.
	// Завершение аудита обновляет только значения и видимость, без перестройки дерева элементов.
	УстановитьВидимостьПодробностейАудита(Элементы, ПредставлениеАудита = 1, Объект.АктивностьАудитаДоступна);
	ОбновитьРабочееМестоАудита(, Истина);
	
КонецПроцедуры


	Обработка = РеквизитФормыВЗначение("Объект");
	
	УстановитьПараметрСписковПользователь(Пользователь);
	ИнформацияОПользователе = Обработка.ИнформацияОПользователе(Пользователь);
	
	Для Каждого Информация Из ИнформацияОПользователе Цикл
		ЭтотОбъект["Информация" + Информация.Ключ] = Информация.Значение;
	КонецЦикла;
	

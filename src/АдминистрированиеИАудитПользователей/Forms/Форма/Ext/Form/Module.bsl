&НаКлиенте
Процедура HTMLКатегорииПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если РекомендацияВыполняется Или ПроверкаПаролейАктивна Или АктивностьВыполняется
		Или ДанныеСобытия.Href = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Адрес = Строка(ДанныеСобытия.Href);
	
	Если Не СтрНачинаетсяС(Адрес, "about:blank#category:") Тогда
		Возврат;
	КонецЕсли;
	
	Код = Сред(Адрес, СтрДлина("about:blank#category:") + 1);
	Строки = КатегорииПроблем.НайтиСтроки(Новый Структура("Код", Код));
	
	Если Строки.Количество() <> 1 Или Код = КатегорияАудита Тогда
		Возврат;
	КонецЕсли;
	
	ВыборСвязи = Неопределено;
	КатегорияАудита = Код;
	ОбновитьРабочееМестоАудита();
	
КонецПроцедуры


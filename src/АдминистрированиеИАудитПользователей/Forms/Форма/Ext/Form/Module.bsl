#Область ОписаниеПеременных

&НаКлиенте
Перем АктивныйЗапускПользователя;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СписокПользователей.ОсновнаяТаблица = "Справочник.Пользователи";
	ОпределитьТекущуюКонфигурацию();
	ОпределитьФункционалПоТекущейКонфигурации();
	
	УстановитьУровниСовместимости();
	
	ДобавитьНаФормуДинамическиеСписки();
	УстановитьПараметрСписковПользователь();
	
	ИзменитьВидимостьНедействительныхПользователей();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ВывестиСтатистикуАудита();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПоказыватьНедействительныхПользователейПриИзменении(Элемент)
	ИзменитьВидимостьНедействительныхПользователей();
КонецПроцедуры

&НаКлиенте
Процедура ОтборПустойПарольСАвторизациейПриИзменении(Элемент)
	УстановитьОтборРезультатаАудитаПользователей();
КонецПроцедуры

&НаКлиенте
Процедура ОтборПолныеПраваПриИзменении(Элемент)
	УстановитьОтборРезультатаАудитаПользователей();
КонецПроцедуры

&НаКлиенте
Процедура ОтборБезПравПриИзменении(Элемент)
	УстановитьОтборРезультатаАудитаПользователей();
КонецПроцедуры

&НаКлиенте
Процедура СписокПользователейПриАктивизацииСтроки(Элемент)
	
	ПодключитьОбработчикОжидания("ОбновитьИнформациюОПользователе", 0.1, Истина);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыРезультатАудитаПользователей

&НаКлиенте
Процедура РезультатАудитаПользователейВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.РезультатАудитаПользователей.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекущиеДанные.ПользовательБСП) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОткрытия = Новый Структура("Ключ", ТекущиеДанные.ПользовательБСП);
	
	ОткрытьФорму("Справочник.Пользователи.ФормаОбъекта", ПараметрыОткрытия);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗапуститьПодПользователем(Команда)
	
	Если Элементы.Страницы.ТекущаяСтраница = Элементы.Пользователи Тогда
		ТекущийСписок = Элементы.СписокПользователей;
	Иначе
		ТекущийСписок = Элементы.РезультатАудитаПользователей;
	КонецЕсли;
	
	ТекущиеДанные = ТекущийСписок.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		ВызватьИсключение(НСтр("ru='Не выбран пользователь'"));
	КонецЕсли;
	
	ЗапуститьСеансПодПользователем(ТекущиеДанные.ИдентификаторПользователяИБ);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроизвестиАудитПользователей(Команда)
	
	ПроизвестиАудитПользователейНаСервере();
	ВывестиСтатистикуАудита();
	
	Статистика = СтатистикаАудитаТаблицы(Объект.АудитПользователей);
	Если Статистика.ПовторныхСопоставлений > 0 Тогда
		ТекстСообщения = СтрШаблон(НСтр("ru='Повторных сопоставлений пользователя ИБ с записями БСП: %1.
			|Проверьте дубли записей БСП; счётчики ИБ учитывают каждую учётную запись один раз.'"),
			Статистика.ПовторныхСопоставлений);
		ВывестиСообщениеОперации(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УбратьВсехПользователейИзСпискаВыбора(Команда)
	
	ПредложитьМассовуюОперацию("СкрытьИзВыбора", Новый Массив);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаблокироватьВходПользователямБезПароля(Команда)
	
	ПредложитьМассовуюОперацию("ОтключитьСтандартныйВход", Новый Массив);
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиНаСтраницуАвтора(Команда)
	ПерейтиПоНавигационнойСсылке("https://infostart.ru/profile/510125");
КонецПроцедуры

&НаКлиенте
Процедура СкопироватьПраваОт(Команда)
	
	Если Элементы.Страницы.ТекущаяСтраница = Элементы.Пользователи Тогда
		ТекущийСписок = Элементы.СписокПользователей;
		Реквизит = "Ссылка";
	Иначе
		ТекущийСписок = Элементы.РезультатАудитаПользователей;
		Реквизит = "ПользовательБСП";
	КонецЕсли;
	
	ТекущиеДанные = ТекущийСписок.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		ВызватьИсключение(НСтр("ru='Не выбран пользователь'"));
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекущиеДанные[Реквизит]) Тогда
		ВызватьИсключение(НСтр("ru='Не выбран пользователь'"));
	КонецЕсли;
	
	ПараметрыОткрытия = Новый Структура("РежимВыбора", Истина);
	ОписаниеОповещения = Новый ОписаниеОповещения("СкопироватьПраваОтПродолжить",
		ЭтотОбъект,
		Новый Структура("Приемник", ТекущиеДанные[Реквизит]));
	
	ОткрытьФорму("Справочник.Пользователи.ФормаВыбора",
		ПараметрыОткрытия,
		ЭтотОбъект, , , ,
		ОписаниеОповещения,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура СделатьНедействительнымиВыделенные(Команда)
	
	ПользователиНаРедактирование = Новый Массив;
	
	Для Каждого ВыделенныйЭлемент Из Элементы.РезультатАудитаПользователей.ВыделенныеСтроки Цикл
		
		Пользователь = Объект.АудитПользователей.НайтиПоИдентификатору(ВыделенныйЭлемент).ПользовательБСП;
		
		Если ЗначениеЗаполнено(Пользователь) Тогда
			ПользователиНаРедактирование.Добавить(Пользователь);
		КонецЕсли;
		
	КонецЦикла;
	
	Если ПользователиНаРедактирование.Количество() = 0 Тогда
		ВызватьИсключение(НСтр("ru='Не выбраны пользователи БСП'"));
	КонецЕсли;
	
	ПредложитьМассовуюОперацию("СделатьНедействительными", ПользователиНаРедактирование);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ИнициализацияФормы

&НаСервере
Процедура ОпределитьФункционалПоТекущейКонфигурации()
	
	Настройки = РеквизитФормыВЗначение("Объект").НастройкиСовместимости(ПолныйМеханизмПользователейБСП());
	Элементы.ФормаСкопироватьПраваОт.Видимость = Настройки.КопированиеПравДоступно
		И (ПолныйМеханизмПользователейБСП() Или УпрощенныйМеханизмПользователейБСП());
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУровниСовместимости()
	
	Настройки = РеквизитФормыВЗначение("Объект").НастройкиСовместимости(ПолныйМеханизмПользователейБСП());
	ЕстьМетаданныеГруппыПользователей = Настройки.ГруппыПользователейДоступны;
	ЕстьМетаданныеГруппыДоступа = Настройки.ГруппыДоступаДоступны;
	ЕстьМетаданныеПрофилиГруппДоступа = Настройки.ПрофилиГруппДоступаДоступны;
	ЕстьМетаданныеРабочиеГруппы = Настройки.РабочиеГруппыДоступны;
	
КонецПроцедуры

#КонецОбласти

#Область ДинамическиеСписки

&НаКлиенте
Процедура ОбновитьДинамическиеСпискиПоПользователю()
	
	Для Каждого Список Из ОтображенныеСпискиСПараметромПользователь Цикл
		Элементы[Список.Значение].Обновить();
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьНаФормуДинамическиеСписки()
	
	Если ПолныйМеханизмПользователейБСП() Тогда
		
		ДобавитьГруппыДоступа();
		ДобавитьГруппыПользователя();
		
	ИначеЕсли УпрощенныйМеханизмПользователейБСП() Тогда
		
		ДобавитьГруппыДоступа();
		
	ИначеЕсли МеханизмПользователейДокументооборота() Тогда
		
		ДобавитьПолномочия();
		ДобавитьРабочиеГруппы();
		
	Иначе
		
		ДобавитьГруппыДоступа();
		ДобавитьГруппыПользователя();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьДинамическийСписокНаФорму(ПараметрыДобавления)
	
	ТипыДинамическийСписок = Новый Массив;
	ТипыДинамическийСписок.Добавить(Тип("ДинамическийСписок"));
	ОписаниеТиповДинамическийСписок = Новый ОписаниеТипов(ТипыДинамическийСписок);
	
	НовыйДинамическийСписок = Новый РеквизитФормы(ПараметрыДобавления.ИмяСписка, ОписаниеТиповДинамическийСписок);
	ДобавляемыеРеквизиты = Новый Массив;
	ДобавляемыеРеквизиты.Добавить(НовыйДинамическийСписок);
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	ТекущийДинамическийСписок = ЭтотОбъект[ПараметрыДобавления.ИмяСписка];
	ТекущийДинамическийСписок.АвтоЗаполнениеДоступныхПолей = Ложь;
	ТекущийДинамическийСписок.АвтоматическоеСохранениеПользовательскихНастроек = Ложь;
	ТекущийДинамическийСписок.ДинамическоеСчитываниеДанных = Истина;
	ТекущийДинамическийСписок.ОсновнаяТаблица = ПараметрыДобавления.ОсновнаяТаблицаСписка;
	ТекущийДинамическийСписок.ПроизвольныйЗапрос = Истина;
	ТекущийДинамическийСписок.ТекстЗапроса = ПараметрыДобавления.ТекстЗапроса;
	
	НоваяТаблица = Элементы.Добавить(ПараметрыДобавления.ИмяСписка,Тип("ТаблицаФормы"), ПараметрыДобавления.Размещение);
	НоваяТаблица.АвтоМаксимальнаяВысота = Ложь;
	НоваяТаблица.ВариантУправленияВысотой = ВариантУправленияВысотойТаблицы.ВСтрокахФормы;
	НоваяТаблица.Заголовок = ПараметрыДобавления.Заголовок;
	НоваяТаблица.ЗапросОбновления = СпособЗапросаОбновления.Нет;
	НоваяТаблица.ИзменятьПорядокСтрок = Ложь;
	НоваяТаблица.ИзменятьСоставСтрок = Ложь;
	НоваяТаблица.КоманднаяПанель.Видимость = Ложь;
	НоваяТаблица.КонтекстноеМеню.Видимость = Ложь;
	НоваяТаблица.МаксимальнаяВысота = 5;
	НоваяТаблица.Отображение = ОтображениеТаблицы.Список;
	НоваяТаблица.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Верх;
	НоваяТаблица.ПоложениеСостоянияПросмотра = ПоложениеСостоянияПросмотра.Нет;
	НоваяТаблица.ПоложениеСтрокиПоиска = ПоложениеСтрокиПоиска.Нет;
	НоваяТаблица.ПоложениеУправленияПоиском = ПоложениеУправленияПоиском.Нет;
	НоваяТаблица.ПутьКДанным = ПараметрыДобавления.ИмяСписка;
	НоваяТаблица.РазрешитьНачалоПеретаскивания = Ложь;
	НоваяТаблица.РазрешитьПеретаскивание = Ложь;
	НоваяТаблица.Шапка = Ложь;
	
	Для Каждого ИмяКолонки Из ПараметрыДобавления.Колонки Цикл
		НоваяКолонкаТаблицы = Элементы.Добавить(ПараметрыДобавления.ИмяСписка + ИмяКолонки, Тип("ПолеФормы"), НоваяТаблица);
		НоваяКолонкаТаблицы.ПутьКДанным = ПараметрыДобавления.ИмяСписка + "." + ИмяКолонки;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьГруппыДоступа()
	
	Если Не ЕстьМетаданныеГруппыДоступа Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыДобавления = НовыеПараметрыДобавленияДинамическогоСписка();
	
	ПараметрыДобавления.ИмяСписка = "ГруппыДоступаТекущегоПользователя";
	ПараметрыДобавления.Заголовок = "Группы доступа";
	ПараметрыДобавления.ТекстЗапроса = ?(ЕстьМетаданныеГруппыПользователей,
		ТекстЗапросаГруппыДоступа(),
		ТекстЗапросаГруппыДоступаБезГруппПользователя());
	ПараметрыДобавления.ОсновнаяТаблицаСписка = "Справочник.ГруппыДоступа";
	ПараметрыДобавления.Размещение = Элементы.ИнформацияОПользователе;
	ПараметрыДобавления.Колонки.Добавить("Ссылка");
	
	ДобавитьДинамическийСписокНаФорму(ПараметрыДобавления);
	
	ОтображенныеСпискиСПараметромПользователь.Добавить(ПараметрыДобавления.ИмяСписка);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьПолномочия()
	
	Если Не ЕстьМетаданныеПрофилиГруппДоступа Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыДобавления = НовыеПараметрыДобавленияДинамическогоСписка();
	
	ПараметрыДобавления.ИмяСписка = "ПолномочияТекущегоПользователя";
	ПараметрыДобавления.Заголовок = "Полномочия";
	ПараметрыДобавления.ТекстЗапроса = ТекстЗапросаПолномочия();
	ПараметрыДобавления.ОсновнаяТаблицаСписка = "Справочник.ПрофилиГруппДоступа";
	ПараметрыДобавления.Размещение = Элементы.ИнформацияОПользователе;
	ПараметрыДобавления.Колонки.Добавить("Ссылка");
	
	ДобавитьДинамическийСписокНаФорму(ПараметрыДобавления);
	
	ОтображенныеСпискиСПараметромПользователь.Добавить(ПараметрыДобавления.ИмяСписка);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьГруппыПользователя()
	
	Если Не ЕстьМетаданныеГруппыПользователей Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыДобавления = НовыеПараметрыДобавленияДинамическогоСписка();
	
	ПараметрыДобавления.ИмяСписка = "ГруппыПользователейТекущегоПользователя";
	ПараметрыДобавления.Заголовок = "Группы пользователя";
	ПараметрыДобавления.ТекстЗапроса = ТекстЗапросаГруппыПользователей();
	ПараметрыДобавления.ОсновнаяТаблицаСписка = "Справочник.ГруппыПользователей";
	ПараметрыДобавления.Размещение = Элементы.ИнформацияОПользователе;
	ПараметрыДобавления.Колонки.Добавить("Ссылка");
	
	ДобавитьДинамическийСписокНаФорму(ПараметрыДобавления);
	
	ОтображенныеСпискиСПараметромПользователь.Добавить(ПараметрыДобавления.ИмяСписка);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьРабочиеГруппы()
	
	Если Не ЕстьМетаданныеРабочиеГруппы Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыДобавления = НовыеПараметрыДобавленияДинамическогоСписка();
	
	ПараметрыДобавления.ИмяСписка = "РабочиеГруппыТекущегоПользователя";
	ПараметрыДобавления.Заголовок = "Рабочие группы";
	ПараметрыДобавления.ТекстЗапроса = ТекстЗапросаРабочиеГруппы();
	ПараметрыДобавления.ОсновнаяТаблицаСписка = "Справочник.РабочиеГруппы";
	ПараметрыДобавления.Размещение = Элементы.ИнформацияОПользователе;
	ПараметрыДобавления.Колонки.Добавить("Ссылка");
	
	ДобавитьДинамическийСписокНаФорму(ПараметрыДобавления);
	
	ОтображенныеСпискиСПараметромПользователь.Добавить(ПараметрыДобавления.ИмяСписка);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрСписковПользователь(Пользователь = Неопределено)
	
	Для Каждого Список Из ОтображенныеСпискиСПараметромПользователь Цикл
		ЭтотОбъект[Список.Значение].Параметры.УстановитьЗначениеПараметра("Пользователь", Пользователь);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ИзменитьВидимостьНедействительныхПользователей()
	
	СписокПользователей.Параметры.УстановитьЗначениеПараметра("ПоказыватьНедействительныхПользователей",
		ПоказыватьНедействительныхПользователей);
	
КонецПроцедуры

&НаСервере
Функция ТекстЗапросаГруппыПользователей()
	Возврат РеквизитФормыВЗначение("Объект").ТекстЗапросаГруппыПользователей();
КонецФункции

&НаСервере
Функция ТекстЗапросаГруппыДоступа()

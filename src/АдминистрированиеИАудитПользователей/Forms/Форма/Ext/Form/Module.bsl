&НаСервере
Функция НовыеПараметрыДобавленияДинамическогоСписка()
	
	ПараметрыДобавления = Новый Структура;
	ПараметрыДобавления.Вставить("ИмяСписка", "");
	ПараметрыДобавления.Вставить("Заголовок", "");
	ПараметрыДобавления.Вставить("ТекстЗапроса", "");
	ПараметрыДобавления.Вставить("ОсновнаяТаблицаСписка", "");
	ПараметрыДобавления.Вставить("Размещение", Неопределено);
	ПараметрыДобавления.Вставить("Колонки", Новый Массив);
	
	Возврат ПараметрыДобавления;
	
КонецФункции

#КонецОбласти

#Область ЗапускПодПользователем

&НаКлиенте
Процедура ЗапуститьСеансПодПользователем(Знач ИдентификаторПользователя)
	
	#Если ВебКлиент Тогда
		ВызватьИсключение НСтр("ru='Запуск другого сеанса доступен в настольном клиенте Windows или Linux.'");
	#Иначе
		
		Если АктивныйЗапускПользователя <> Неопределено Тогда
			
			ВернутьПарольПослеЗапускаНаСервере(АктивныйЗапускПользователя.ИдентификаторПользователя,
				АктивныйЗапускПользователя.АдресПараметровЗапуска);
			АктивныйЗапускПользователя = Неопределено;
			
			Возврат;
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ИдентификаторПользователя) Тогда
			ВызватьИсключение НСтр("ru='Пользователь ИБ не найден.'");
		КонецЕсли;
		
		ИмяПрограммы = ИмяПрограммыДляЗапускаСеанса();
		ПроверитьТекстАргументаЗапуска(КодРазрешения);
		
		Если ТипЗнч(ИдентификаторПользователя) = Тип("Строка") Тогда
			ИдентификаторПользователя = Новый УникальныйИдентификатор(ИдентификаторПользователя);
		КонецЕсли;
		
		Пароль = КриптостойкийПарольЗапуска();
		ПараметрыЗапуска = ПараметрыЗапускаПодПользователемНаСервере(ИдентификаторПользователя, Пароль);
		АктивныйЗапускПользователя = Новый Структура;
		АктивныйЗапускПользователя.Вставить("ИдентификаторПользователя", ИдентификаторПользователя);
		АктивныйЗапускПользователя.Вставить("АдресПараметровЗапуска", ПараметрыЗапуска.АдресПараметровЗапуска);
		
		Попытка
			
			Аргументы = СтрокаПараметровЗапускаПриложения(ПараметрыЗапуска.Имя, Пароль);
			ЗапуститьПриложение("""" + ИмяПрограммы + """" + Аргументы);
			Оповещение = Новый ОписаниеОповещения("ОжиданиеСеансаВопросЗавершение", ЭтотОбъект,
				АктивныйЗапускПользователя);
			ПоказатьВопрос(Оповещение, НСтр("ru='Нажмите ОК после запуска сеанса'"),
				РежимДиалогаВопрос.ОК, 60, , , КодВозвратаДиалога.ОК);
			
		Исключение
			
			// Обычный отказ в живом клиенте: завершаем тот же возврат, без фонового восстановления.
			
			Попытка
				
				ВернутьПарольПослеЗапускаНаСервере(АктивныйЗапускПользователя.ИдентификаторПользователя,
					АктивныйЗапускПользователя.АдресПараметровЗапуска);
				АктивныйЗапускПользователя = Неопределено;
				
			Исключение
				ВызватьИсключение НСтр(
					"ru='Запуск не выполнен, возврат пароля не подтверждён. Повторно нажмите «Запустить под пользователем» для возврата в этом сеансе либо задайте пароль вручную.'");
			КонецПопытки;
			
			ВызватьИсключение НСтр(
				"ru='Запустить клиент не удалось. Исходное состояние пароля возвращено либо сохранено более новое изменение.'");
			
		КонецПопытки;
		
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ОжиданиеСеансаВопросЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ВернутьПарольПослеЗапускаНаСервере(ДополнительныеПараметры.ИдентификаторПользователя,
		ДополнительныеПараметры.АдресПараметровЗапуска);
	АктивныйЗапускПользователя = Неопределено;
	
КонецПроцедуры

&НаКлиенте
Функция СтрокаПараметровЗапускаПриложения(ИмяПользователя, ПарольПользователя)
	
	ПроверитьТекстАргументаЗапуска(ИмяПользователя);
	ПроверитьТекстАргументаЗапуска(КодРазрешения);
	
	Если ЭтоКлиентLinux() Тогда
		Возврат СтрокаПараметровЗапускаПриложенияLinux(ИмяПользователя, ПарольПользователя);
	КонецЕсли;
	
	СтрокаСоединения = СтрЗаменить(СтрокаСоединенияИнформационнойБазы(), """", """""") + """";
	ПараметрыЗапуска = СтрШаблон(" ENTERPRISE /IBConnectionString""%1 /WA- /N""%2"" /P""%3""%4",
		СтрокаСоединения, ИмяПользователя, ПарольПользователя,
		?(КодРазрешения = "", "", СтрШаблон(" /UC""%1""", КодРазрешения)));
	
	Возврат ПараметрыЗапуска;
	
КонецФункции

&НаКлиенте
Функция СтрокаПараметровЗапускаПриложенияLinux(ИмяПользователя, ПарольПользователя)
	
	СтрокаСоединения = СтрокаСоединенияИнформационнойБазы();
	
	ПараметрыЗапуска = " ENTERPRISE /IBConnectionString "
		+ АргументЗапускаLinux(СтрокаСоединения)
		+ " /WA- /N " + АргументЗапускаLinux(ИмяПользователя)
		+ " /P " + АргументЗапускаLinux(ПарольПользователя);
	
	Если КодРазрешения <> "" Тогда
		ПараметрыЗапуска = ПараметрыЗапуска + " /UC " + АргументЗапускаLinux(КодРазрешения);
	КонецЕсли;
	
	Возврат ПараметрыЗапуска;
	
КонецФункции

&НаКлиенте
Функция АргументЗапускаLinux(Знач Аргумент)
	
	// Одинарные кавычки сохраняют аргумент буквально, в том числе $, ` и пробелы.
	Кавычка = Символ(39);
	ЭкранированнаяКавычка = Кавычка + Символ(34) + Кавычка + Символ(34) + Кавычка;
	
	Возврат Кавычка + СтрЗаменить(Аргумент, Кавычка, ЭкранированнаяКавычка) + Кавычка;
	
КонецФункции

&НаКлиенте
Процедура ПроверитьТекстАргументаЗапуска(Знач Значение)
	
	Если СтрНайти(Значение, """") > 0 Или СтрНайти(Значение, Символы.ПС) > 0
		Или СтрНайти(Значение, Символы.ВК) > 0 Тогда
		ВызватьИсключение НСтр(
			"ru='Имя пользователя или код разрешения содержит недопустимые символы для запуска приложения.'");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ИмяПрограммыДляЗапускаСеанса()
	
	ИмяПрограммы = КаталогПрограммы() + ?(ЭтоКлиентLinux(), "1cv8c", "1cv8c.exe");
	ФайлПрограммы = Новый Файл(ИмяПрограммы);
	
	Если Не ФайлПрограммы.Существует() Тогда
		ВызватьИсключение НСтр(
			"ru='Для запуска другого сеанса нужен настольный клиент Windows или Linux с установленным тонким клиентом.'");
	КонецЕсли;
	
	Возврат ИмяПрограммы;
	
КонецФункции

&НаКлиенте
Функция ЭтоКлиентLinux()
	
	Система = Новый СистемнаяИнформация;
	
	// Семейство платформы учитывает ARM64 и E2K без ссылок на новые значения перечисления.
	Возврат Лев(Строка(Система.ТипПлатформы), 5) = "Linux";
	
КонецФункции

&НаКлиенте
Функция КриптостойкийПарольЗапуска()
	
	#Если ВебКлиент Тогда
		ВызватьИсключение НСтр("ru='Запуск другого сеанса доступен в настольном клиенте Windows или Linux.'");
	#Иначе
		
		Если ЭтоКлиентLinux() Тогда
			Возврат КриптостойкийПарольЗапускаLinux();
		КонецЕсли;
		
		Оболочка = Новый COMОбъект("WScript.Shell");
		ИмяPowerShell = Оболочка.ExpandEnvironmentStrings(
			"%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe");
		Команда = """" + ИмяPowerShell + """ -NoProfile -NonInteractive -WindowStyle Hidden -Command ""& { "
			+ "$b = New-Object byte[] 32; $r = [System.Security.Cryptography.RandomNumberGenerator]::Create(); "
			+ ("try { $r.GetBytes($b); [Console]::Write([Convert]::ToBase64String($b)) } "
				+ "finally { $r.Dispose() } }""");
		Процесс = Оболочка.Exec(Команда);
		СлучайнаяСтрока = СокрЛП(Процесс.StdOut.ReadAll());
		
		Если Процесс.ExitCode <> 0 Или СтрДлина(СлучайнаяСтрока) <> 44 Тогда
			ВызватьИсключение НСтр("ru='Не удалось получить безопасный временный пароль. Учётные данные не изменены.'");
		КонецЕсли;
		
		Возврат "Aa1!" + СлучайнаяСтрока;
	#КонецЕсли
	
КонецФункции

&НаКлиенте
Функция КриптостойкийПарольЗапускаLinux()
	
	Буфер = Новый БуферДвоичныхДанных(32);
	Поток = Новый ФайловыйПоток("/dev/urandom", РежимОткрытияФайла.Открыть, ДоступКФайлу.Чтение, 0);
	
	Попытка
		
		Прочитано = 0;
		
		Пока Прочитано < Буфер.Размер Цикл
			
			Количество = Поток.Прочитать(Буфер, Прочитано, Буфер.Размер - Прочитано);
			
			Если Количество = 0 Тогда
				ВызватьИсключение НСтр(
					"ru='Не удалось получить безопасный временный пароль. Учётные данные не изменены.'");
			КонецЕсли;
			
			Прочитано = Прочитано + Количество;
			
		КонецЦикла;
		
	Исключение
		
		Поток.Закрыть();
		ВызватьИсключение;
		
	КонецПопытки;
	
	Поток.Закрыть();
	
	Возврат "Aa1!" + Base64Строка(ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Буфер));
	
КонецФункции


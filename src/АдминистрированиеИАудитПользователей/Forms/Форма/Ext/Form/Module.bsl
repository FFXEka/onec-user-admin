&НаКлиенте
Процедура ВывестиСтатистикуАудита()
	
	СтатистикаАудита = СтатистикаАудитаТаблицы(Объект.АудитПользователей);
	
	Элементы.ДекорЛево1.Заголовок = СтрШаблон(НСтр("ru='%1 - всего пользователей БСП'"),
		Формат(СтатистикаАудита.ВсегоПользователейБСП, "ЧН=0; ЧГ="));
	
	Элементы.ДекорЛево2.Заголовок = СтрШаблон(НСтр("ru='%1 - всего пользователей ИБ'"),
		Формат(СтатистикаАудита.ВсегоПользователейИБ, "ЧН=0; ЧГ="));
	
	Элементы.ДекорЛево3.Заголовок = СтрШаблон(НСтр("ru='%1 - учёток ИБ без обычной записи БСП'"),
		Формат(СтатистикаАудита.НесопоставленныхПользователей, "ЧН=0; ЧГ="));
	
	Элементы.ДекорПраво1.Заголовок = СтрШаблон(НСтр("ru='%1 - пользователей с полными правами'"),
		Формат(СтатистикаАудита.ЕстьПолныеПрава, "ЧН=0; ЧГ="));
	
	Элементы.ДекорПраво2.Заголовок = СтрШаблон(НСтр("ru='%1 - пользователей с авторизацией под пустым паролем'"),
		Формат(СтатистикаАудита.ЕстьАвторизацияПодПустымПаролем, "ЧН=0; ЧГ="));
	
	Элементы.ДекорПраво3.Заголовок = СтрШаблон(НСтр("ru='%1 - пользователей с полными правами и авторизацией под пустым паролем'"),
		Формат(СтатистикаАудита.ЕстьПолныеПраваИАвторизацияПодПустымПаролем, "ЧН=0; ЧГ="));
	
	ЕстьПользователиСПустымПаролем = (СтатистикаАудита.ЕстьАвторизацияПодПустымПаролем > 0);
	ЕстьПользователиСПустымПаролемИПолнымиПравами = (СтатистикаАудита.ЕстьПолныеПраваИАвторизацияПодПустымПаролем > 0);
	
КонецПроцедуры

&НаКлиенте
Функция СтатистикаАудитаТаблицы(ТаблицаАудита)
	
	Статистика = НоваяСтатистикаАудита();
	УчтенныеПользователиИБ = Новый Соответствие;
	
	Для Каждого Строка Из ТаблицаАудита Цикл
		
		Если ЗначениеЗаполнено(Строка.ПользовательБСП) Тогда
			Инкрементировать(Статистика.ВсегоПользователейБСП);
		КонецЕсли;
		
		Если (Не Строка.НайденПользовательИБ И ЗначениеЗаполнено(Строка.ПользовательБСП))
			Или (Строка.НайденПользовательИБ И Не ЗначениеЗаполнено(Строка.ПользовательБСП)) Тогда
			Инкрементировать(Статистика.НесопоставленныхПользователей);
		КонецЕсли;
		
		Если Не Строка.НайденПользовательИБ Тогда
			Продолжить;
		КонецЕсли;
		
		Идентификатор = Строка.ИдентификаторПользователяИБ;
		Если УчтенныеПользователиИБ.Получить(Идентификатор) <> Неопределено Тогда
			Инкрементировать(Статистика.ПовторныхСопоставлений);
			Продолжить;
		КонецЕсли;
		
		УчтенныеПользователиИБ.Вставить(Идентификатор, Истина);
		Инкрементировать(Статистика.ВсегоПользователейИБ);
		УчитыватьПоказателиПользователяИБ(Статистика, Строка);
		
	КонецЦикла;
	
	Возврат Статистика;
	
КонецФункции

&НаКлиенте
Процедура УчитыватьПоказателиПользователяИБ(Статистика, Строка)
	
	Если Строка.ЕстьПолныеПрава Тогда
		Инкрементировать(Статистика.ЕстьПолныеПрава);
	КонецЕсли;
	
	Если Строка.АутентификацияСтандартная И Не Строка.ПарольУстановлен Тогда
		
		Инкрементировать(Статистика.ЕстьАвторизацияПодПустымПаролем);
		Если Строка.ЕстьПолныеПрава Тогда
			Инкрементировать(Статистика.ЕстьПолныеПраваИАвторизацияПодПустымПаролем);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборРезультатаАудитаПользователей()
	
	СтруктураПоиска = Новый Структура;
	Если ОтборПустойПарольСАвторизацией Тогда
		СтруктураПоиска.Вставить("ПарольУстановлен", Ложь);
		СтруктураПоиска.Вставить("АутентификацияСтандартная", Истина);
	КонецЕсли;
	Если ОтборПолныеПрава Тогда
		СтруктураПоиска.Вставить("ЕстьПолныеПрава", Истина);
	КонецЕсли;
	Если ОтборБезПрав Тогда
		СтруктураПоиска.Вставить("НетНикакихПрав", Истина);
	КонецЕсли;
	
	Элементы.РезультатАудитаПользователей.ОтборСтрок= Новый ФиксированнаяСтруктура(СтруктураПоиска);
	
КонецПроцедуры

&НаКлиенте
Процедура Инкрементировать(Значение)
	
	Значение = Значение + 1;
	
КонецПроцедуры

&НаКлиенте
Функция НоваяСтатистикаАудита()
	
	СтатистикаАудита = Новый Структура;
	СтатистикаАудита.Вставить("ВсегоПользователейИБ", 0);
	СтатистикаАудита.Вставить("ВсегоПользователейБСП", 0);
	СтатистикаАудита.Вставить("НесопоставленныхПользователей", 0);
	СтатистикаАудита.Вставить("ЕстьПолныеПрава", 0);
	СтатистикаАудита.Вставить("ЕстьАвторизацияПодПустымПаролем", 0);
	СтатистикаАудита.Вставить("ЕстьПолныеПраваИАвторизацияПодПустымПаролем", 0);
	СтатистикаАудита.Вставить("ПовторныхСопоставлений", 0);
	
	Возврат СтатистикаАудита;
	
КонецФункции

#КонецОбласти

#Область КомандаСкоприроватьПраваДоступа

&НаКлиенте
Процедура СкопироватьПраваОтПродолжить(Источник, ДополнительныеПараметры) Экспорт
	
	Если Не ЗначениеЗаполнено(Источник) Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник = ДополнительныеПараметры.Приемник Тогда
		ПоказатьПредупреждение(, НСтр("ru='Источник и получатель прав совпадают. Изменения не требуются.'"));
		Возврат;
	КонецЕсли;
	
	ПараметрыКопирования = Новый Структура("Приемник,Источник", ДополнительныеПараметры.Приемник, Источник);
	ОписаниеОповещения = Новый ОписаниеОповещения("СкопироватьПраваПослеПодтверждения", ЭтотОбъект, ПараметрыКопирования);
	ТекстВопроса = СтрШаблон(НСтр("ru='Заменить для пользователя ""%1"" членство в группах по образцу пользователя ""%2""?
		|Текущие назначения, которых нет у источника, будут удалены.
		|Ограничения доступа и другие настройки групп обработка не копирует.'"),
		ДополнительныеПараметры.Приемник, Источник);
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Нет);
	
КонецПроцедуры

&НаКлиенте
Процедура СкопироватьПраваПослеПодтверждения(Результат, ПараметрыКопирования) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	СкопироватьПраваПользователяНаСервере(ПараметрыКопирования.Приемник, ПараметрыКопирования.Источник);
	
	ОбновитьДинамическиеСпискиПоПользователю();
	
	ТекстСообщения = СтрШаблон(НСтр("ru='Членство в группах пользователя ""%1"" заменено по образцу пользователя ""%2"".
		|Проверьте итоговый доступ с учетом ограничений и настроек конфигурации.'"),
		ПараметрыКопирования.Приемник, ПараметрыКопирования.Источник);
	ПоказатьПредупреждение(, ТекстСообщения);
	
КонецПроцедуры

&НаСервере
Процедура СкопироватьПраваПользователяНаСервере(Знач Приемник, Знач Источник)
	
	Если ПолныйМеханизмПользователейБСП() Тогда
		ИспользоватьПолныйМеханизмПользователейБСП = Истина;
		
	ИначеЕсли УпрощенныйМеханизмПользователейБСП() Тогда
		ИспользоватьПолныйМеханизмПользователейБСП = Ложь;
		
	Иначе
		ВызватьИсключение НСтр("ru='В данной конфигурации копирование прав не предусмотрено текущим функционалом. Обратитесь к автору'");
		
	КонецЕсли;
	
	РеквизитФормыВЗначение("Объект").СкопироватьПраваДоступаПользователей(Приемник,
		Источник,
		ИспользоватьПолныйМеханизмПользователейБСП);
	
КонецПроцедуры

#КонецОбласти

#Область МассовыеОперацииСПользователями

&НаКлиенте
Процедура ПредложитьМассовуюОперацию(ВидОперации, Пользователи)
	
	Предпросмотр = РезультатМассовойОперацииНаСервере(ВидОперации, Пользователи, Истина);
	ВывестиПодробностиМассовойОперации(Предпросмотр, Истина);
	Если Предпросмотр.Изменены.Количество() = 0 Тогда
		ТекстСообщения = НСтр("ru='Нет пользователей, подходящих для изменения.
			|Причины пропуска и ошибки приведены в сообщениях.'");
		ПоказатьПредупреждение(, ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ПараметрыОперации = Новый Структура;
	ПараметрыОперации.Вставить("ВидОперации", ВидОперации);
	ПараметрыОперации.Вставить("Пользователи", Пользователи);
	ПараметрыОперации.Вставить("РазрешенныеПользователи", Предпросмотр.Изменены);
	ОписаниеОповещения = Новый ОписаниеОповещения("МассоваяОперацияПослеПодтверждения",
		ЭтотОбъект, ПараметрыОперации);
	ТекстВопроса = ОписаниеМассовойОперации(ВидОперации) + Символы.ПС
		+ СтрШаблон(НСтр("ru='Планируется изменить пользователей: %1.'"), Предпросмотр.Изменены.Количество())
		+ Символы.ПС + СписокПланируемыхИзменений(Предпросмотр.Изменены)
		+ Символы.ПС + НСтр("ru='Выполнить изменения для перечисленных пользователей?'");
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Нет);
	
КонецПроцедуры

&НаКлиенте
Процедура МассоваяОперацияПослеПодтверждения(Ответ, ПараметрыОперации) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Результат = РезультатМассовойОперацииНаСервере(ПараметрыОперации.ВидОперации,
		ПараметрыОперации.Пользователи, Ложь, ПараметрыОперации.РазрешенныеПользователи);
	ВывестиПодробностиМассовойОперации(Результат, Ложь);
	ПроизвестиАудитПользователей(Неопределено);
	Элементы.СписокПользователей.Обновить();
	ТекстСообщения = СтрШаблон(НСтр("ru='Операция завершена. Изменено: %1. Пропущено: %2. Ошибок: %3.
		|Подробности по каждому пользователю приведены в сообщениях.'"),
		Результат.Изменены.Количество(), Результат.Пропущены.Количество(), Результат.Ошибки.Количество());
	ПоказатьПредупреждение(, ТекстСообщения);
	
КонецПроцедуры

&НаСервере
Функция РезультатМассовойОперацииНаСервере(Знач ВидОперации, Знач Пользователи,
	Знач ПредварительныйПросмотр, Знач РазрешенныеПользователи = Неопределено)
	
	Обработка = РеквизитФормыВЗначение("Объект");
	Если ВидОперации = "СкрытьИзВыбора" Тогда
		Возврат Обработка.УбратьВсехПользователейИзСпискаВыбора(ПредварительныйПросмотр, РазрешенныеПользователи);
	ИначеЕсли ВидОперации = "ОтключитьСтандартныйВход" Тогда
		Возврат Обработка.ЗаблокироватьВходПользователямБезПароля(ПредварительныйПросмотр, РазрешенныеПользователи);
	ИначеЕсли ВидОперации = "СделатьНедействительными" Тогда
		Возврат Обработка.СделатьНедействительнымиПользователей(Пользователи,
			ПредварительныйПросмотр, РазрешенныеПользователи);
	Иначе
		ВызватьИсключение НСтр("ru='Неизвестная массовая операция.'");
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Функция ОписаниеМассовойОперации(ВидОперации)
	
	Если ВидОперации = "СкрытьИзВыбора" Тогда
		Возврат НСтр("ru='Пользователи будут скрыты из списка выбора при стандартном входе.
			|Обрабатывается последний результат аудита целиком; отборы таблицы не ограничивают операцию.
			|Ввод имени вручную останется доступен.'");
	ИначеЕсли ВидОперации = "ОтключитьСтандартныйВход" Тогда
		Возврат НСтр("ru='Будет отключена стандартная аутентификация у пользователей без пароля.
			|Обрабатывается последний результат аудита целиком; отборы таблицы не ограничивают операцию.
			|Текущий пользователь и административные учётные записи пропускаются.
			|Вход через ОС, OpenID и другие способы не отключается.'");
	Иначе
		Возврат НСтр("ru='Выделенные пользователи БСП будут отмечены как недействительные.
			|Фактические ограничения входа определяются конфигурацией.'");
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Функция СписокПланируемыхИзменений(Изменения)
	
	СтрокиСписка = Новый Массив;
	Для Каждого Изменение Из Изменения Цикл
		СтрокиСписка.Добавить(Изменение.Пользователь + ": " + Изменение.Причина);
	КонецЦикла;
	
	Возврат СтрСоединить(СтрокиСписка, Символы.ПС);
	
КонецФункции

&НаКлиенте
Процедура ВывестиПодробностиМассовойОперации(Результат, Предпросмотр)
	
	ВывестиГруппуРезультатовМассовойОперации(Результат.Изменены,
		?(Предпросмотр, НСтр("ru='Планируется'"), НСтр("ru='Изменен'")));
	ВывестиГруппуРезультатовМассовойОперации(Результат.Пропущены, НСтр("ru='Пропущен'"));
	ВывестиГруппуРезультатовМассовойОперации(Результат.Ошибки, НСтр("ru='Ошибка'"));
	
КонецПроцедуры

&НаКлиенте
Процедура ВывестиГруппуРезультатовМассовойОперации(Результаты, Статус)
	
	Для Каждого Результат Из Результаты Цикл
		ВывестиСообщениеОперации(Статус + ": " + Результат.Пользователь + ". " + Результат.Причина);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ВывестиСообщениеОперации(ТекстСообщения)
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстСообщения;
	Сообщение.Сообщить();
	
КонецПроцедуры

#КонецОбласти

#Область ОпределениеСреды

&НаСервере
Процедура ОпределитьТекущуюКонфигурацию()
	
	Конфигурация = Метаданные.Имя;
	ВерсияКонфигурации = Метаданные.Версия;
	Редакция = НомерРедакции(ВерсияКонфигурации);
	
	Если СтрНайти(Конфигурация, "Бухгалтерия") > 0
		И СтрНайти(Конфигурация, "ГосударственногоУчреждения") = 0
		И Редакция = "3" Тогда
		
		ТекущаяКонфигурация = Бухгалтерия30();
		
	ИначеЕсли СтрНайти(Конфигурация, "УправлениеПредприятием") > 0
		И Редакция = "2" Тогда
		
		ТекущаяКонфигурация = ERP2();
		
	ИначеЕсли СтрНайти(Конфигурация, "КомплекснаяАвтоматизация") > 0
		И Редакция = "2" Тогда
		
		ТекущаяКонфигурация = КомплекснаяАвтоматизация2();
		
	ИначеЕсли СтрНайти(Конфигурация, "УправлениеТорговлей") > 0
		И Редакция = "11" Тогда
		
		ТекущаяКонфигурация = УправлениеТорговлей11();
		
	ИначеЕсли СтрНайти(Конфигурация, "ЗарплатаИУправлениеПерсоналом") > 0
		И Редакция = "3" Тогда
		
		ТекущаяКонфигурация = ЗарплатаИУправлениеПерсоналом3();
		
	ИначеЕсли СтрНайти(Конфигурация, "Документооборот") > 0
		И Редакция = "3" Тогда
		
		ТекущаяКонфигурация = Документооборот30();
		
	ИначеЕсли СтрНайти(Конфигурация, "Документооборот") > 0
		И Редакция = "2" Тогда
		
		ТекущаяКонфигурация = Документооборот20();
		
	ИначеЕсли СтрНайти(Конфигурация, "Розница") > 0
		И Редакция = "3" Тогда
		
		ТекущаяКонфигурация = Розница30();
		
	ИначеЕсли СтрНайти(Конфигурация, "Розница") > 0
		И Редакция = "2" Тогда
		
		ТекущаяКонфигурация = Розница20();
		
	ИначеЕсли СтрНайти(Конфигурация, "УправлениеНашейФирмой") > 0
		И Редакция = "3" Тогда
		
		ТекущаяКонфигурация = УправлениеНашейФирмой3();
		
	ИначеЕсли СтрНайти(Конфигурация, "УправлениеНебольшойФирмой") > 0 Тогда
		
		ТекущаяКонфигурация = УправлениеНашейФирмой();
		
	ИначеЕсли СтрНайти(Конфигурация, "ERPУправлениеХолдингом") > 0
		Или СтрНайти(Конфигурация, "ERPУХ") > 0 Тогда
		
		ТекущаяКонфигурация = ERPУправлениеХолдингом();
		
	ИначеЕсли СтрНайти(Конфигурация, "УправлениеХолдингом") > 0 Тогда
		
		ТекущаяКонфигурация = УправлениеХолдингом();
		
	ИначеЕсли СтрНайти(Конфигурация, "БухгалтерияГосударственногоУчреждения") > 0
		И Редакция = "2" Тогда
		
		ТекущаяКонфигурация = БухгалтерияГосударственногоУчреждения2();
		
	ИначеЕсли СтрНайти(Конфигурация, "ЗарплатаКадрыГосударственногоУчреждения") > 0
		И Редакция = "3" Тогда
		
		ТекущаяКонфигурация = ЗарплатаКадрыГосударственногоУчреждения3();
		
	ИначеЕсли СтрНайти(Конфигурация, "БухгалтерияНекоммерческойОрганизации") > 0
		И Редакция = "3" Тогда
		
		ТекущаяКонфигурация = БухгалтерияНКО30();
		
	ИначеЕсли СтрНайти(Конфигурация, "Предприниматель") > 0 Тогда
		
		ТекущаяКонфигурация = Предприниматель();
		
	ИначеЕсли СтрНайти(Конфигурация, "Упрощенка") > 0 Тогда
		
		ТекущаяКонфигурация = Упрощенка();
		
	ИначеЕсли СтрНайти(Конфигурация, "КонвертацияДанных") > 0 Тогда
		
		ТекущаяКонфигурация = КонвертацияДанных();
		
	Иначе
		ТекущаяКонфигурация = "";
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолныйМеханизмПользователейБСП()
	
	ПолныйМеханизмПользователейБСП = Ложь;
	
	Если ТекущаяКонфигурация = ERP2()
		Или ТекущаяКонфигурация = КомплекснаяАвтоматизация2()
		Или ТекущаяКонфигурация = УправлениеТорговлей11()
		Или ТекущаяКонфигурация = ЗарплатаИУправлениеПерсоналом3()
		Или ТекущаяКонфигурация = Розница20()
		Или ТекущаяКонфигурация = Розница30()
		Или ТекущаяКонфигурация = УправлениеНашейФирмой()
		Или ТекущаяКонфигурация = УправлениеНашейФирмой3()
		Или ТекущаяКонфигурация = УправлениеХолдингом()
		Или ТекущаяКонфигурация = ERPУправлениеХолдингом()
		Или ТекущаяКонфигурация = БухгалтерияГосударственногоУчреждения2()
		Или ТекущаяКонфигурация = ЗарплатаКадрыГосударственногоУчреждения3() Тогда
		
		ПолныйМеханизмПользователейБСП = Истина;
		
	КонецЕсли;
	
	Возврат ПолныйМеханизмПользователейБСП;
	
КонецФункции

&НаСервере
Функция УпрощенныйМеханизмПользователейБСП()
	
	УпрощенныеМеханизмПользователейБСП = Ложь;
	
	Если ТекущаяКонфигурация = Бухгалтерия30()
		Или ТекущаяКонфигурация = БухгалтерияНКО30()
		Или ТекущаяКонфигурация = Предприниматель()
		Или ТекущаяКонфигурация = Упрощенка() Тогда
		
		УпрощенныеМеханизмПользователейБСП = Истина;
		
	КонецЕсли;
	
	Возврат УпрощенныеМеханизмПользователейБСП;
	
КонецФункции

&НаСервере
Функция МеханизмПользователейДокументооборота()
	
	МеханизмПользователейДокументооборота = Ложь;
	
	Если ТекущаяКонфигурация = Документооборот20()
		Или ТекущаяКонфигурация = Документооборот30() Тогда
		
		МеханизмПользователейДокументооборота = Истина;
		
	КонецЕсли;
	
	Возврат МеханизмПользователейДокументооборота;
	
КонецФункции

&НаСервере
Функция НомерРедакции(Знач Версия)
	
	Версия = СокрЛП(Версия);
	
	Если Версия = "" Тогда
		Возврат 0;
	КонецЕсли;
	
	ПозицияТочки = СтрНайти(Версия, ".");
	
	Если ПозицияТочки = 0 Тогда
		НомерРедакции = Версия;
	Иначе
		НомерРедакции = Лев(Версия, ПозицияТочки - 1);
	КонецЕсли;
	
	Возврат НомерРедакции;
	
КонецФункции


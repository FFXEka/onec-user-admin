&НаСервере
Процедура ОбновитьРасположениеАудитаНаСервере()
	
	Подробно = ПредставлениеАудита = 1;
	УстановитьВидимостьПодробностейАудита(Элементы, Подробно, Объект.АктивностьАудитаДоступна);
	Имена = ?(
		Подробно, ("КолонкаЗамечания,КолонкаПоследнийВход," + "РезультатАудитаПользователейИмяПользователяБСП,"
			+ "РезультатАудитаПользователейИмяФизическогоЛица," + "РезультатАудитаПользователейДатаПоследнейАктивности,"
			+ "РезультатАудитаПользователейСтатусПроверкиАктивности,"
			+ "РезультатАудитаПользователейЕстьАдминистративныеПрава,"
			+ "РезультатАудитаПользователейНайденПользовательИБ,"
			+ "РезультатАудитаПользователейПолноеИмя,РезультатАудитаПользователейИмя,"
			+ "РезультатАудитаПользователейОписаниеПрав,"
			+ "РезультатАудитаПользователейНедействителен,АудитПользователейТипыАутентификации,"
			+ "РезультатАудитаПользователейПарольУстановлен," + "РезультатАудитаПользователейПоказыватьВСпискеВыбора,"
			+ "РезультатАудитаПользователейЕстьПолныеПрава," + "РезультатАудитаПользователейНетНикакихПрав,"
			+ "РезультатАудитаПользователейПользовательБСП," + "РезультатАудитаПользователейПользовательОС,"
			+ "РезультатАудитаПользователейИдентификаторПользователяИБ,"
			+ "РезультатАудитаПользователейКоличествоРолей," + "РезультатАудитаПользователейСписокРолей,"
			+ "РезультатАудитаПользователейДатаУстановкиПароля," + "РезультатАудитаПользователейПометкаУдаленияБСП,"
			+ "РезультатАудитаПользователейФизическоеЛицо,"
			+ "РезультатАудитаПользователейАутентификацияТокеномДоступа"),
		"РезультатАудитаПользователейПолноеИмя,КолонкаЗамечания,РезультатАудитаПользователейИмя,"
		+ "РезультатАудитаПользователейОписаниеПрав,КолонкаПоследнийВход");
	
	Для Каждого Имя Из СтрРазделить(Имена, ",") Цикл
		Элементы.Переместить(Элементы[Имя], Элементы.РезультатАудитаПользователей);
	КонецЦикла;
	
	Элементы.РезультатАудитаПользователейЗамечания.Ширина = ?(Подробно, 54, 32);
	Элементы.Переместить(Элементы.РезультатАудитаПользователейДействие, Элементы.РезультатАудитаПользователей,
		Элементы.КолонкаПоследнийВход);
	Элементы.РезультатАудитаПользователейИмя.Видимость = Подробно;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьТекстДнейАктивности()
	
	ДобавитьТекстДнейАктивности("СтатусПроверкиАктивности", "Активен сейчас",
		ВидСравненияКомпоновкиДанных.Равно, НСтр("ru='Активен сейчас'"));
	ДобавитьТекстДнейАктивности("ДнейПослеАктивности", 1,
		ВидСравненияКомпоновкиДанных.Равно, НСтр("ru='Вчера'"));
	ДобавитьТекстДнейАктивности("ПрочаяАктивность", -1,
		ВидСравненияКомпоновкиДанных.Равно, НСтр("ru='Не рассчитано'"),
		"РезультатАудитаПользователейПрочаяАктивность");
	ДобавитьТекстДнейАктивности("ДнейПослеАктивности", 0,
		ВидСравненияКомпоновкиДанных.Меньше, НСтр("ru='В будущем'"));
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьТекстДнейАктивности(ИмяПоля, Значение, Сравнение, Текст, ИмяКолонки = "РезультатАудитаПользователейПоследнийВходВДнях")
	
	Оформление = УсловноеОформление.Элементы.Добавить();
	Поле = Оформление.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных(ИмяКолонки);
	Отбор = Оформление.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("РабочийСписок." + ИмяПоля);
	Отбор.ВидСравнения = Сравнение;
	Отбор.ПравоеЗначение = Значение;
	Отбор.Использование = Истина;
	
	Оформление.Оформление.УстановитьЗначениеПараметра("Текст", Текст);
	
КонецПроцедуры

&НаКлиенте
Функция ВыбранныеСтрокиАудита()
	
	Выбранные = Новый Массив;
	Идентификаторы = Новый Массив;
	
	Если ПредставлениеАудита = 0 Тогда
		
		Для Каждого Данные Из РабочийСписок Цикл
			
			Если Данные.Выбрана Тогда
				Идентификаторы.Добавить(Данные.ПолучитьИдентификатор());
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе
		
		Для Каждого Идентификатор Из Элементы.РезультатАудитаПользователей.ВыделенныеСтроки Цикл
			Идентификаторы.Добавить(Идентификатор);
		КонецЦикла;
		
	КонецЕсли;
	
	Для Каждого ИдентификаторСтроки Из Идентификаторы Цикл
		
		СтрокаАудита = РабочийСписок.НайтиПоИдентификатору(ИдентификаторСтроки);
		
		Если СтрокаАудита = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Выбранный = Новый Структура;
		Выбранный.Вставить("ИдентификаторПользователяИБ", СтрокаАудита.ИдентификаторПользователяИБ);
		Выбранный.Вставить("ПользовательБСП", СтрокаАудита.ПользовательБСП);
		Выбранные.Добавить(Выбранный);
		
	КонецЦикла;
	
	Возврат Выбранные;
	
КонецФункции

&НаКлиенте
Функция ПолучениеФайлаССервераДоступно()
	
	СведенияОПлатформе = Новый СистемнаяИнформация;
	ЧастиВерсии = СтрРазделить(СведенияОПлатформе.ВерсияПриложения, ".");
	ОсновнаяВерсия = Число(ЧастиВерсии[0]);
	Подверсия = Число(ЧастиВерсии[1]);
	Редакция = Число(ЧастиВерсии[2]);
	
	// НачатьПолучениеФайлаССервера доступен с 8.3.15; в старых клиентах используется API 8.3.6.
	Возврат ОсновнаяВерсия > 8
		Или ОсновнаяВерсия = 8 И Подверсия > 3
		Или ОсновнаяВерсия = 8 И Подверсия = 3 И Редакция >= 15;
	
КонецФункции

&НаСервереБезКонтекста
Процедура УдалитьДанныеОтчетаНаСервере(Знач Адрес)
	
	УдалитьИзВременногоХранилища(Адрес);
	
КонецПроцедуры

&НаСервере
Функция АдресОтчетаАдминистратораНаСервере(Знач ВидОтчета)
	
	Обработка = РеквизитФормыВЗначение("Объект");
	
	Если ВидОтчета = "Протокол" Тогда
		HTML = Обработка.HTMLПротоколаДействий();
	ИначеЕсли ВидОтчета = "Аудит" Тогда
		HTML = Обработка.HTMLРезультатаАудита();
	Иначе
		ВызватьИсключение НСтр("ru='Неизвестный вид отчёта.'");
	КонецЕсли;
	
	Данные = ПолучитьДвоичныеДанныеИзСтроки(HTML, КодировкаТекста.UTF8);
	
	Возврат ПоместитьВоВременноеХранилище(Данные, УникальныйИдентификатор);
	
КонецФункции

#КонецОбласти

#Область ПроверкаСлабыхПаролей

&НаКлиенте
Процедура НачатьАудитПаролей()
	
	Если ПроверкаПаролейАктивна Или АктивностьВыполняется Или РекомендацияВыполняется Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ОбщийАудитВыполнен Тогда
		
		ОбновитьАудитПользователей("Пароли");
		
		Возврат;
		
	КонецЕсли;
	
	Если Объект.АудитПользователей.Количество() = 0 Тогда
		
		ПоказатьПредупреждение(, НСтр("ru='В общем аудите нет пользователей для проверки паролей.'"));
		
		Возврат;
		
	КонецЕсли;
	
	Попытка
		
		УстановитьЗанятостьПроверкойПаролей(Истина);
		ОжидающаяПодготовкаПаролей = Новый Структура("Окно,Запланировано", "", Ложь);
		ОткрытьОкноХодаОперации(НСтр("ru='Проверка слабых паролей'"),
			НСтр("ru='Отмена доступна до подготовки и между порциями проверки.'"));
		ОжидающаяПодготовкаПаролей.Окно = ИдентификаторОкнаХода;
		ПередатьСостояниеОкнаХода(НСтр("ru='Подготовка проверки'"), 0, "", Ложь, Истина);
		
	Исключение
		ОбработатьСбойПроверкиПаролей(ИнформацияОбОшибке());
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодготовитьПроверкуПаролей()
	
	Если ОжидающаяПодготовкаПаролей = Неопределено Или Не ПроверкаПаролейАктивна Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторПодготовки = ОжидающаяПодготовкаПаролей.Окно;
	ОжидающаяПодготовкаПаролей = Неопределено;
	
	Если ИдентификаторПодготовки <> ИдентификаторОкнаХода Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		ПередатьСостояниеОкнаХода(НСтр("ru='Подготовка проверки'"), 0, "", Ложь, Ложь);
		НачалоПроверки = НоваяПроверкаПаролейНаСервере();
		БазовыеСтрокиПроверкиПаролей = НачалоПроверки.БазовыеСтроки;
		АдресПроверкиПаролей = НачалоПроверки.Прогресс.Адрес;
		ОбновитьПрогрессПроверкиПаролей(НачалоПроверки.Прогресс);
		
		Если Не НачалоПроверки.Прогресс.Завершено Тогда
			ПодключитьОбработчикОжидания("ПродолжитьПроверкуПаролей", 0.1, Истина);
		КонецЕсли;
		
	Исключение
		ОбработатьСбойПроверкиПаролей(ИнформацияОбОшибке());
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьПроверкуПаролей()
	
	Если Не ПроверкаПаролейАктивна Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		Прогресс = СледующаяПорцияПроверкиПаролейНаСервере(АдресПроверкиПаролей, АдресМаршрутаОпераций);
		ОбновитьПрогрессПроверкиПаролей(Прогресс);
		
		Если Не Прогресс.Завершено Тогда
			ПодключитьОбработчикОжидания("ПродолжитьПроверкуПаролей", 0.1, Истина);
		КонецЕсли;
		
	Исключение
		ОбработатьСбойПроверкиПаролей(ИнформацияОбОшибке());
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрерватьАудитПаролей()
	
	Если Не ПроверкаПаролейАктивна Тогда
		Возврат;
	КонецЕсли;
	
	Если ОжидающаяПодготовкаПаролей <> Неопределено Тогда
		
		ОтключитьОбработчикОжидания("ПодготовитьПроверкуПаролей");
		ОжидающаяПодготовкаПаролей = Неопределено;
		УстановитьЗанятостьПроверкойПаролей(Ложь);
		ЗакрытьОкноХодаОперации();
		
		Возврат;
		
	КонецЕсли;
	
	ОтключитьОбработчикОжидания("ПродолжитьПроверкуПаролей");
	
	Попытка
		
		Прогресс = ОтмененнаяПроверкаПаролейНаСервере(АдресПроверкиПаролей);
		ОбновитьПрогрессПроверкиПаролей(Прогресс);
		
	Исключение
		ОбработатьСбойПроверкиПаролей(ИнформацияОбОшибке());
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПрогрессПроверкиПаролей(Прогресс)
	
	ПрогрессПроверкиПаролей = Прогресс.Процент;
	
	Если Прогресс.Свойство("АдресПодтверждения") Тогда
		АдресПодтвержденийПаролей = Прогресс.АдресПодтверждения;
	КонецЕсли;
	
	Элементы.ХодПроверкиПаролей.Видимость = Ложь;
	
	Если Прогресс.Завершено Тогда
		
		ПрименитьПроверкуПаролейНаСервере(БазовыеСтрокиПроверкиПаролей, Прогресс.Наблюдения);
		АдресПроверкиПаролей = "";
		БазовыеСтрокиПроверкиПаролей = Неопределено;
		
	КонецЕсли;
	
	УстановитьЗанятостьПроверкойПаролей(Не Прогресс.Завершено);
	ОбновитьОкноХодаОперации(Прогресс);
	
	Если Прогресс.Завершено Тогда
		ПоказатьПредупреждение(, Прогресс.Текст);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗанятостьПроверкойПаролей(Активна)
	
	ПроверкаПаролейАктивна = Активна;
	Элементы.ОтменитьПроверкуПаролей.Видимость = Ложь;
	Элементы.ИндикаторПроверкиПаролей.Видимость = Ложь;
	
	Для Каждого ИмяЭлемента Из СтрРазделить(
		("ПроизвестиАудитПользователей,ПроверитьСлабыеПароли,Действия,"
			+ "ЗапуститьПодПользователем,ФормаСкопироватьПраваОт,ВыделитьВсеСтрокиАудита,"
			+ "СнятьВыделениеСтрокАудита"), ",") Цикл
		Элементы[ИмяЭлемента].Доступность = Не Активна;
	КонецЦикла;
	
	ОбновитьДоступностьДействийПользователя();
	МожноВыбирать = Не Активна И ОбщийАудитВыполнен
		И СтрРазделить("ПустойПароль,СлабыйПароль,Роли,ЗапрещенВход,Неактивные,Связи",
		",").Найти(КатегорияАудита) <> Неопределено;
	Элементы.ВыделитьВсеСтрокиАудита.Доступность = МожноВыбирать;
	Элементы.СнятьВыделениеСтрокАудита.Доступность = МожноВыбирать;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьСбойПроверкиПаролей(ИнформацияОСбое)
	
	ПодробностиСбоя = ПодробноеПредставлениеОшибки(ИнформацияОСбое);
	ИсходнаяОшибка = ИнформацияОСбое;
	
	Пока ИсходнаяОшибка.Причина <> Неопределено Цикл
		ИсходнаяОшибка = ИсходнаяОшибка.Причина;
	КонецЦикла;
	
	ПричинаСбоя = КраткоеПредставлениеОшибки(ИсходнаяОшибка);
	КодСбоя = Строка(Новый УникальныйИдентификатор);
	ДиагностикаСохранена = Ложь;
	
	Попытка
		
		ЗафиксироватьСбойПроверкиПаролейНаСервере(КодСбоя, ПодробностиСбоя);
		ДиагностикаСохранена = Истина;
		
	Исключение
		// При недоступном сервере исходная причина останется в сообщении пользователю.
		ПричинаСбоя = ПодробностиСбоя;
	КонецПопытки;
	
	ОтключитьОбработчикОжидания("ПодготовитьПроверкуПаролей");
	ОжидающаяПодготовкаПаролей = Неопределено;
	ОтключитьОбработчикОжидания("ПродолжитьПроверкуПаролей");
	
	Если ЗначениеЗаполнено(АдресПроверкиПаролей) Тогда
		
		Попытка
			ОсвободитьПроверкуПаролейНаСервере(АдресПроверкиПаролей);
		Исключение
			// Сохраняем исходную ошибку, даже если освобождение состояния также не удалось.
			АдресПроверкиПаролей = "";
		КонецПопытки;
		
	КонецЕсли;
	
	АдресПроверкиПаролей = "";
	БазовыеСтрокиПроверкиПаролей = Неопределено;
	УстановитьЗанятостьПроверкойПаролей(Ложь);
	ЗакрытьОкноХодаОперации();
	Элементы.ХодПроверкиПаролей.Видимость = Ложь;
	Сообщение = СтрШаблон(НСтр("ru='Проверка не выполнена. %1 Код диагностики: %2.'"), ПричинаСбоя, КодСбоя);
	
	Если Не ДиагностикаСохранена Тогда
		Сообщение = Сообщение + Символы.ПС + НСтр("ru='Запись диагностики в журнал регистрации не подтверждена.'");
	КонецЕсли;
	
	ПоказатьПредупреждение(, Сообщение);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗафиксироватьСбойПроверкиПаролейНаСервере(КодСбоя, ПодробностиСбоя)
	
	Если Не ПравоДоступа("Администрирование", Метаданные) Тогда
		ВызватьИсключение НСтр("ru='Диагностика аудита доступна администратору информационной базы.'");
	КонецЕсли;
	
	// Только сведения об исключении; состояние проверки, кандидаты и хеши не передаются.
	ЗаписьЖурналаРегистрации(НСтр("ru='Администрирование пользователей.Аудит паролей'"),
		УровеньЖурналаРегистрации.Ошибка, , , СтрШаблон(НСтр("ru='Код диагностики: %1. %2'"),
			КодСбоя, ПодробностиСбоя));
	
КонецПроцедуры

&НаСервере
Функция МаршрутОперацииНаСервере()
	
	Обработка = РеквизитФормыВЗначение("Объект");
	ЧастиИмени = СтрРазделить(ИмяФормы, ".");
	Маршрут = Новый Структура;
	Маршрут.Вставить("ИмяФасада", ЧастиИмени[1]);
	Маршрут.Вставить("Контекст", Обработка.КонтекстДлительнойОперации());
	Возврат ПоместитьВоВременноеХранилище(Маршрут, УникальныйИдентификатор);
	
КонецФункции

&НаСервереБезКонтекста
Функция ФасадОперацииБезКонтекста(АдресМаршрута)
	
	Если Не ЭтоАдресВременногоХранилища(АдресМаршрута) Тогда
		ВызватьИсключение НСтр("ru='Маршрут операции недоступен. Откройте обработку заново.'");
	КонецЕсли;
	
	Маршрут = ПолучитьИзВременногоХранилища(АдресМаршрута);
	
	Если ТипЗнч(Маршрут) <> Тип("Структура") Тогда
		ВызватьИсключение НСтр("ru='Маршрут операции недоступен.'");
	КонецЕсли;
	
	// Единственная фабрика главного фасада: имя задано сервером, не выбором клиента.
	Фасад = ВнешниеОбработки.Создать(Маршрут.ИмяФасада);
	
	Если Фасад.КонтекстДлительнойОперации() <> Маршрут.Контекст Тогда
		ВызватьИсключение НСтр("ru='Операция принадлежит другому пользователю, источнику или сборке.'");
	КонецЕсли;
	
	Возврат Фасад;
	
КонецФункции

&НаСервере
Функция НоваяПроверкаПаролейНаСервере()
	
	АдресМаршрутаОпераций = МаршрутОперацииНаСервере();
	Результат = РеквизитФормыВЗначение("Объект").НоваяПроверкаСлабыхПаролей(УникальныйИдентификатор, АдресКешаПаролей);
	ОсвободитьПодтвержденияПаролей();
	АдресКешаПаролей = Результат.Прогресс.АдресКеша;
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция СледующаяПорцияПроверкиПаролейНаСервере(Адрес, АдресМаршрута)
	
	Возврат ФасадОперацииБезКонтекста(АдресМаршрута).СледующаяПорцияПроверкиПаролей(Адрес);
	
КонецФункции

&НаСервере
Функция ОтмененнаяПроверкаПаролейНаСервере(Адрес)
	
	Результат = РеквизитФормыВЗначение("Объект").ОтмененнаяПроверкаПаролей(Адрес);
	
	Если Результат.Свойство("АдресПодтверждения") Тогда
		АдресПодтвержденийПаролей = Результат.АдресПодтверждения;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ОсвободитьПроверкуПаролейНаСервере(Адрес)
	
	РеквизитФормыВЗначение("Объект").ОсвободитьПроверкуПаролей(Адрес);
	
КонецПроцедуры

&НаСервере
Процедура ПрименитьПроверкуПаролейНаСервере(Знач БазовыеСтроки, Знач Наблюдения)
	
	Обработка = РеквизитФормыВЗначение("Объект");
	Обработка.ПрименитьПроверкуПаролей(БазовыеСтроки, Наблюдения, ПорогНеактивности);
	Обработка.УпорядочитьАудит(ПорядокАудита);
	ЗначениеВРеквизитФормы(Обработка, "Объект");
	ЗафиксироватьРезультатАудита(Обработка);
	ЗаполнитьЗначкиАудита();
	ОбновитьВидимостьСписковАудита();
	ОбновитьРекомендацииНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область СначалаПроблемы

&НаСервере
Процедура ОбновитьРабочееМестоАудита(Выбранные = Неопределено, ОбновитьКатегории = Ложь)
	
	ВерсияПредставленияАудита = Строка(Новый УникальныйИдентификатор);
	Обработка = РеквизитФормыВЗначение("Объект");
	Модель = Обработка.РабочееМестоАудита(КатегорияАудита, ПоискАудита, ПорогНеактивности);
	
	Предложения = Неопределено;
	
	Если ОбновитьКатегории Тогда
		
		Предложения = Обработка.ПредложенияРекомендаций(ОбщийАудитВыполнен, ПорогНеактивности,
			СчетчикиПрочейАктивности());
		ОбновитьКоличествоРекомендаций(Предложения);
		ОбновитьСтрокиКатегорий(Модель.Категории);
		
	КонецЕсли;
	
	ДоступныеКатегории = КатегорииПроблем.НайтиСтроки(Новый Структура("Код", КатегорияАудита));
	
	Если ПустаяСтрока(КатегорияАудита) Или ДоступныеКатегории.Количество() = 0 Тогда
		
		Рекомендации = КатегорииПроблем.НайтиСтроки(Новый Структура("Код", "ОбщиеРекомендации"));
		КатегорияАудита = ?(Рекомендации.Количество() > 0, "ОбщиеРекомендации",
			ПерваяКатегорияАудита(Модель.Категории));
		Модель = Обработка.РабочееМестоАудита(КатегорияАудита, ПоискАудита, ПорогНеактивности);
		
	КонецЕсли;
	
	РабочийСписок.Очистить();
	
	Для Каждого ДанныеСтроки Из Модель.Строки Цикл
		
		НоваяСтрока = РабочийСписок.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Объект.АудитПользователей[ДанныеСтроки.Индекс]);
		НоваяСтрока.КодДействия = ДанныеСтроки.КодДействия;
		НоваяСтрока.Действие = ДанныеСтроки.Действие;
		НоваяСтрока.ДругиеЗамечания = ДанныеСтроки.ДругиеЗамечания;
		
		Если НоваяСтрока.ЕстьДатаАктивности И НоваяСтрока.ДнейПослеАктивности = 0
			И НоваяСтрока.СтатусПроверкиАктивности <> "Активен сейчас" Тогда
			НоваяСтрока.ПоследнийВходВДнях = НСтр("ru='Сегодня'");
		КонецЕсли;
		
	КонецЦикла;
	
	Если Выбранные <> Неопределено Тогда
		
		Для Каждого КлючСтроки Из Выбранные Цикл
			
			Для Каждого СтрокаСписка Из РабочийСписок.НайтиСтроки(КлючСтроки) Цикл
				СтрокаСписка.Выбрана = Истина;
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;
	
	ОднороднаяКатегория = КатегорияАудита = "ПустойПароль" Или КатегорияАудита = "СлабыйПароль"
		Или КатегорияАудита = "Роли";
	Элементы.КолонкаЗамечания.Видимость = ПредставлениеАудита = 1 Или Не ОднороднаяКатегория;
	
	ОбновитьПрочуюАктивностьРабочегоСписка(СчетчикиПрочейАктивности());
	
	Если Выбранные <> Неопределено И ПредставлениеАудита = 1 Тогда
		
		Выделение = Элементы.РезультатАудитаПользователей.ВыделенныеСтроки;
		Выделение.Очистить();
		
		Для Каждого СтрокаСписка Из РабочийСписок Цикл
			
			Если СтрокаСписка.Выбрана Тогда
				Выделение.Добавить(СтрокаСписка.ПолучитьИдентификатор());
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	ОбновитьHTMLРабочегоМеста(Предложения, Истина);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьКоличествоРекомендаций(Предложения)
	
	Количество = 0;
	
	Для Каждого Предложение Из Предложения Цикл
		
		Если Предложение.Доступно Тогда
			Количество = Количество + 1;
		КонецЕсли;
		
	КонецЦикла;
	
	Строки = КатегорииПроблем.НайтиСтроки(Новый Структура("Код", "ОбщиеРекомендации"));
	
	Если Количество = 0 И Не ПоказыватьПустыеКатегории Тогда
		
		Для Каждого Строка Из Строки Цикл
			КатегорииПроблем.Удалить(Строка);
		КонецЦикла;
		
		Возврат;
		
	КонецЕсли;
	
	Если Строки.Количество() = 0 Тогда
		Строка = КатегорииПроблем.Вставить(0);
	Иначе
		Строка = Строки[0];
	КонецЕсли;
	
	Строка.Код = "ОбщиеРекомендации";
	Строка.Название = НСтр("ru='Общие рекомендации'");
	Строка.Значок = АдресЗначкаРекомендаций;
	Строка.Количество = Формат(Количество, "ЧГ=0; ЧН=0");
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСтрокиКатегорий(Категории)
	
	Рекомендации = КатегорииПроблем.НайтиСтроки(Новый Структура("Код", "ОбщиеРекомендации"));
	КоличествоРекомендаций = ?(Рекомендации.Количество() = 0, "", Рекомендации[0].Количество);
	КатегорииПроблем.Очистить();
	
	Если Не ПустаяСтрока(КоличествоРекомендаций) Или ПоказыватьПустыеКатегории Тогда
		
		Строка = КатегорииПроблем.Добавить();
		Строка.Код = "ОбщиеРекомендации";
		Строка.Название = НСтр("ru='Общие рекомендации'");
		Строка.Количество = КоличествоРекомендаций;
		Строка.Значок = АдресЗначкаРекомендаций;
		
	КонецЕсли;
	
	Для Каждого ДанныеКатегории Из Категории Цикл
		
		Если ДанныеКатегории.Количество = 0 И ДанныеКатегории.Раздел <> "Обзор" И Не ПоказыватьПустыеКатегории Тогда
			Продолжить;
		КонецЕсли;
		
		Строка = КатегорииПроблем.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, ДанныеКатегории, , "Количество");
		Строка.Количество = Формат(ДанныеКатегории.Количество, "ЧГ=0; ЧН=0");
		
		Если ДанныеКатегории.Код = "Неактивные" Тогда
			Строка.Название = СтрШаблон(НСтр("ru='Не заходили более %1 дн.'"), ПорогНеактивности);
		КонецЕсли;
		
		Строка.Значок = ?(ДанныеКатегории.Раздел = "Критические", АдресКритическогоЗначка,
			?(ДанныеКатегории.Раздел = НСтр("ru='Требуют внимания'"), АдресЗначкаВнимания, ""));
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПерваяКатегорияАудита(Категории)
	
	Для Каждого Категория Из Категории Цикл
		
		Если Категория.Раздел <> "Обзор" И Категория.Количество > 0 Тогда
			Возврат Категория.Код;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат "Все";
	
КонецФункции

&НаКлиенте
Процедура ПредложитьУдалениеУчеткиИБ(Данные)
	
	Если РекомендацияВыполняется Или АктивностьВыполняется Или ПроверкаПаролейАктивна
		Или Не Данные.НайденПользовательИБ Или ЗначениеЗаполнено(Данные.ПользовательБСП) Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеУдаления = Новый Структура;
	ДанныеУдаления.Вставить("Идентификатор", Данные.ИдентификаторПользователяИБ);
	ДанныеУдаления.Вставить("Имя", Данные.Имя);
	ДанныеУдаления.Вставить("ПолноеИмя", Данные.ПолноеИмя);
	ДанныеУдаления.Вставить("ПользовательБСП", Данные.ПользовательБСП);
	Вопрос = СтрШаблон(НСтр("ru='Удалить учётную запись ИБ «%1» (%2)?'"), Данные.ПолноеИмя, Данные.Имя) + Символы.ПС
		+ НСтр("ru='Удаление необратимо. Учётная запись будет удалена только при отсутствии связей с карточками БСП.'");
	Оповещение = Новый ОписаниеОповещения("УдалениеУчеткиИБПодтверждено", ЭтотОбъект, ДанныеУдаления);
	ПоказатьВопрос(Оповещение, Вопрос, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалениеУчеткиИБПодтверждено(Ответ, ДанныеУдаления) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		Результат = УдалитьУчеткуИБНаСервере(ДанныеУдаления);
		ПоказатьПредупреждение(, СтрШаблон(НСтр("ru='Удалена учётная запись ИБ «%1».'"), ДанныеУдаления.ПолноеИмя)
			+ Результат,
			,
			НСтр("ru='Успешно выполнено'"));
		
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), , НСтр("ru='Не выполнено'"));
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Функция УдалитьУчеткуИБНаСервере(Знач ДанныеУдаления)
	
	Обработка = РеквизитФормыВЗначение("Объект");
	Обработка.УдалитьУчеткуИзАудита(ДанныеУдаления.Идентификатор, ДанныеУдаления.Имя);
	ЗначениеВРеквизитФормы(Обработка, "Объект");
	ЗафиксироватьРезультатАудита(Обработка);
	Выбранные = Новый Массив;
	Выбранные.Добавить(Новый Структура("ИдентификаторПользователяИБ,ПользовательБСП", ДанныеУдаления.Идентификатор,
		ДанныеУдаления.ПользовательБСП));
	
	Попытка
		
		Обработка.АктуализироватьВыбранных(Выбранные, ПорогНеактивности, АдресПодтвержденийПаролей);
		ЗначениеВРеквизитФормы(Обработка, "Объект");
		ЗафиксироватьСнимокАудита(Обработка);
		ОбновитьРабочееМестоАудита(, Истина);
		
	Исключение
		Возврат Символы.ПС + НСтр("ru='Обновление списка не завершено. Выполните общий аудит.'");
	КонецПопытки;
	
	Возврат "";
	
КонецФункции

&НаКлиенте
Процедура ДействиеДляСтрокиАудита(Данные)
	
	Если Данные = Неопределено Или ПустаяСтрока(Данные.КодДействия) Тогда
		Возврат;
	КонецЕсли;
	
	Если Данные.КодДействия = "СменитьПароль" Или Данные.КодДействия = "ОтменитьСмену" Тогда
		ИзменитьТребованиеИзСтроки(Данные.ИдентификаторПользователяИБ, Данные.ПользовательБСП,
			Данные.КодДействия = "СменитьПароль");
	ИначеЕсли Данные.КодДействия = "Связи" Тогда
		НачатьВыборСвязи(Данные);
	ИначеЕсли Данные.КодДействия = "Проверка" Тогда
		НачатьАудитПаролей();
	Иначе
		ОткрытьКарточкуИзАудита(Данные);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьТребованиеИзСтроки(Идентификатор, Ссылка, Требовать)
	
	Если Требовать Тогда
		
		Выбранные = Новый Массив;
		Выбранные.Добавить(Новый Структура("ИдентификаторПользователяИБ,ПользовательБСП", Идентификатор, Ссылка));
		ПредложитьДействиеПоОтбору("СменаВыбранным", Выбранные);
		
		Возврат;
		
	КонецЕсли;
	
	Попытка
		
		ИзменитьТребованиеСменыПароляНаСервере(Идентификатор, Ссылка, Требовать);
		ПоказатьПредупреждение(, ?(Требовать, НСтр("ru='Потребован новый пароль при следующем входе.'"),
			НСтр("ru='Требование смены пароля отменено.'")), , НСтр("ru='Успешно выполнено'"));
		
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	ОбновитьРабочееМестоАудита();
	
КонецПроцедуры

&НаСервере
Процедура ИзменитьТребованиеСменыПароляНаСервере(Идентификатор, Ссылка, Требовать)
	
	Обработка = РеквизитФормыВЗначение("Объект");
	
	Попытка
		Обработка.ИзменитьТребованиеСменыПароля(Идентификатор, Ссылка, Требовать, АдресПодтвержденийПаролей);
	Исключение
		
		ЗначениеВРеквизитФормы(Обработка, "Объект");
		ЗафиксироватьСнимокАудита(Обработка);
		ВызватьИсключение;
		
	КонецПопытки;
	
	ЗначениеВРеквизитФормы(Обработка, "Объект");
	ЗафиксироватьСнимокАудита(Обработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ПредложитьОтключениеСтандартногоВхода(Данные)
	
	Если КатегорияАудита <> "ПустойПароль" И КатегорияАудита <> "СлабыйПароль" Тогда
		Возврат;
	КонецЕсли;
	
	Выбранные = Новый Массив;
	Выбранные.Добавить(Новый Структура("ИдентификаторПользователяИБ,ПользовательБСП",
		Данные.ИдентификаторПользователяИБ, Данные.ПользовательБСП));
	Код = ?(КатегорияАудита = "ПустойПароль", "БезПароля", "ОтключитьСлабые");
	ПредложитьРекомендованноеДействие(Код, Выбранные);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьКарточкуИзАудита(Данные)
	
	Если ЗначениеЗаполнено(Данные.ПользовательБСП) Тогда
		
		ПараметрыКарточки = Новый Структура("Ключ", Данные.ПользовательБСП);
		КлючСтроки = Новый Структура("ИдентификаторПользователяИБ,ПользовательБСП",
			Данные.ИдентификаторПользователяИБ, Данные.ПользовательБСП);
		Оповещение = Новый ОписаниеОповещения("КарточкаАудитаЗакрыта", ЭтотОбъект, КлючСтроки);
		ОткрытьФорму("Справочник.Пользователи.ФормаОбъекта", ПараметрыКарточки, ЭтотОбъект, , , , Оповещение);
		КарточкаОткрываласьПослеАудита = Истина;
		
	ИначеЕсли КатегорияАудита = "Связи" Тогда
		НачатьВыборСвязи(Данные);
	Иначе
		ПоказатьПредупреждение(,
			НСтр("ru='У пользователя нет карточки БСП. Связь можно настроить в категории «Связи ИБ / БСП».'"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КарточкаАудитаЗакрыта(РезультатЗакрытия, КлючСтроки) Экспорт
	
	Если Не ОбщийАудитВыполнен Или ПроверкаПаролейАктивна Или АктивностьВыполняется
		Или РекомендацияВыполняется Или ОжидающийОбщийАудит <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		АктуализироватьКарточкуАудитаНаСервере(КлючСтроки, ВыбранныеСтрокиАудита());
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура АктуализироватьКарточкуАудитаНаСервере(КлючСтроки, Выбранные)
	
	СтрокиКарточки = Новый Массив;
	СтрокиКарточки.Добавить(КлючСтроки);
	Обработка = РеквизитФормыВЗначение("Объект");
	Обработка.АктуализироватьВыбранных(СтрокиКарточки, ПорогНеактивности, АдресПодтвержденийПаролей);
	Обработка.УпорядочитьАудит(ПорядокАудита);
	ЗначениеВРеквизитФормы(Обработка, "Объект");
	ЗафиксироватьСнимокАудита(Обработка);
	ОбновитьРабочееМестоАудита(Выбранные, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьВыборСвязи(Данные)
	
	Если Данные.НайденПользовательИБ И ЗначениеЗаполнено(Данные.ПользовательБСП) Тогда
		
		ОткрытьКарточкуИзАудита(Данные);
		
		Возврат;
		
	КонецЕсли;
	
	Связь = Новый Структура;
	Связь.Вставить("ПодбираетсяИБ", Не Данные.НайденПользовательИБ);
	Связь.Вставить("Карточка", Данные.ПользовательБСП);
	Связь.Вставить("Идентификатор", Данные.ИдентификаторПользователяИБ);
	Связь.Вставить("Версия", Строка(Новый УникальныйИдентификатор));
	
	Попытка
		Кандидаты = ВариантыСвязиНаСервере(Связь);
	Исключение
		
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		Возврат;
		
	КонецПопытки;
	
	Связь.Вставить("Кандидаты", Кандидаты);
	ВыборСвязи = Связь;
	
КонецПроцедуры

&НаСервере
Функция ВариантыСвязиНаСервере(Связь)
	
	Варианты = РеквизитФормыВЗначение("Объект").ВариантыСвязиАудита(Связь, Связь.Версия);
	Элементы.ПанельРабочегоСписка.Видимость = Ложь;
	Элементы.ПереключитьИнтерфейсСписка.Доступность = Ложь;
	Элементы.РезультатАудитаПользователейДействие.Видимость = Ложь;
	Элементы.РезультатАудитаПользователейСтатусПроверкиАктивности.Видимость = Ложь;
	Элементы.РезультатАудитаПользователей.Видимость = Ложь;
	Элементы.HTMLРабочееМесто.Видимость = Истина;
	HTMLРабочееМесто = Варианты.HTML;
	
	Возврат Варианты.Кандидаты;
	
КонецФункции

&НаКлиенте
Процедура ОбработатьВыборСвязи(Части)
	
	Если Части.Количество() <> 4 Или Части[0] <> "about" Или Части[1] <> "blank#link09"
		Или Части[2] <> ВыборСвязи.Версия Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		Индекс = Число(Части[3]);
	Исключение
		Возврат;
	КонецПопытки;
	
	Если Индекс = -1 Тогда
		
		ВыборСвязи = Неопределено;
		ОбновитьРабочееМестоАудита();
		
		Возврат;
		
	КонецЕсли;
	
	Если Индекс < 0 Или Индекс >= ВыборСвязи.Кандидаты.Количество() Или Цел(Индекс) <> Индекс Тогда
		Возврат;
	КонецЕсли;
	
	Кандидат = ВыборСвязи.Кандидаты[Индекс];
	ПараметрыСвязи = Новый Структура("Связь,Кандидат", ВыборСвязи, Кандидат);
	ПоказатьВопрос(Новый ОписаниеОповещения("ПодтвержденаСвязьАудита", ЭтотОбъект, ПараметрыСвязи),
		СтрШаблон(НСтр("ru='Подтвердите связь с «%1».'"), Кандидат.Имя), РежимДиалогаВопрос.ДаНет, 0,
			КодВозвратаДиалога.Нет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтвержденаСвязьАудита(Ответ, ДанныеСвязи) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		СохранитьСвязьНаСервере(ДанныеСвязи.Связь, ДанныеСвязи.Кандидат);
		ВыборСвязи = Неопределено;
		АктуализироватьПослеРекомендацииНаСервере();
		
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьСвязьНаСервере(Связь, Кандидат)
	
	Ссылка = ?(Связь.ПодбираетсяИБ, Связь.Карточка, Кандидат.Ключ);
	Идентификатор = ?(Связь.ПодбираетсяИБ, Кандидат.Ключ, Связь.Идентификатор);
	Старый = ?(Связь.ПодбираетсяИБ, Связь.Идентификатор, Кандидат.СтарыйИдентификатор);
	РеквизитФормыВЗначение("Объект").СвязатьПользователяАудита(Ссылка, Идентификатор, Старый);
	
КонецПроцедуры

&НаСервере
Процедура ОсвободитьПодтвержденияПаролей()
	
	Если ЗначениеЗаполнено(АдресПодтвержденийПаролей) Тогда
		
		РеквизитФормыВЗначение("Объект").ОсвободитьПроверкуПаролей(АдресПодтвержденийПаролей);
		АдресПодтвержденийПаролей = "";
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СсылкиРабочегоМеста

&НаСервере
Процедура ОбновитьHTMLРабочегоМеста(Предложения = Неопределено, ОбновитьКатегории = Ложь)
	
	ОбновитьВидимостьСписковАудита();
	
	Если КатегорияАудита = "ОбщиеРекомендации" Тогда
		
		ОбновитьРекомендацииНаСервере(Предложения);
		
		Возврат;
		
	КонецЕсли;
	
	Если ОбновитьКатегории Тогда
		ОбновитьHTMLКатегорий();
	КонецЕсли;
	
	Если ПредставлениеАудита = 1 Тогда
		Возврат;
	КонецЕсли;
	
	Обработка = РеквизитФормыВЗначение("Объект");
	HTMLРабочееМесто = Обработка.HTMLРабочегоСписка(РеквизитФормыВЗначение("РабочийСписок"),
		КатегорияАудита, ВерсияПредставленияАудита, Объект.АктивностьАудитаДоступна, ПорядокАудита,
		Элементы.ВыделитьВсеСтрокиАудита.Доступность, ЗаголовокПрочейАктивности());
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьВидимостьСписковАудита()
	
	Элементы.РабочееМесто.Видимость = ОбщийАудитВыполнен;
	СписокПользователейАудита = ОбщийАудитВыполнен И КатегорияАудита <> "ОбщиеРекомендации";
	Элементы.ПереключитьИнтерфейсСписка.Доступность = ОбщийАудитВыполнен;
	Элементы.ПереключитьИнтерфейсСписка.Заголовок = ?(ПредставлениеАудита = 0,
		НСтр("ru='Переключить вид списка на подробный с технической информацией'"),
			НСтр("ru='Переключить вид списка на упрощенный'"));
	Пароль = КатегорияАудита = "ПустойПароль" Или КатегорияАудита = "СлабыйПароль";
	Роли = КатегорияАудита = "Роли";
	Неактивные = КатегорияАудита = "Неактивные";
	Элементы.РассчитатьПрочуюАктивность.Доступность = ОбщийАудитВыполнен;
	ПоказыватьПрочуюАктивность = СписокПользователейАудита И ЗначениеЗаполнено(АдресПрочейАктивности);
	Элементы.РезультатАудитаПользователейПрочаяАктивность.Видимость = ПоказыватьПрочуюАктивность;
	Элементы.СортироватьПрочуюАктивность.Видимость = ПоказыватьПрочуюАктивность;
	
	Если ПоказыватьПрочуюАктивность И ПредставлениеАудита = 1 Тогда
		
		Стрелка = ?(ПорядокАудита = 5, " ▼", ?(ПорядокАудита = 6, " ▲", ""));
		Элементы.РезультатАудитаПользователейПрочаяАктивность.Заголовок = ЗаголовокПрочейАктивности() + Стрелка;
		
	КонецЕсли;
	
	Недействителен = Роли Или КатегорияАудита = "ЗапрещенВход" Или КатегорияАудита = "Связи";
	Элементы.ПотребоватьПарольВыбранным.Видимость = СписокПользователейАудита И Пароль;
	Элементы.ОтключитьВходВыбранным.Видимость = СписокПользователейАудита И Пароль;
	Элементы.ЗаблокироватьВыбранных.Видимость = СписокПользователейАудита И Роли;
	Элементы.НедействительныВыбранные.Видимость = СписокПользователейАудита И Недействителен;
	Элементы.ВыделитьВсеСтрокиАудита.Доступность = СписокПользователейАудита И (Пароль Или Недействителен
		Или Неактивные);
	Элементы.СнятьВыделениеСтрокАудита.Доступность = Элементы.ВыделитьВсеСтрокиАудита.Доступность;
	Элементы.БлокироватьНеактивныхВыбранных.Видимость = СписокПользователейАудита И Неактивные;
	Элементы.ИзменитьПорогНеактивности.Видимость = СписокПользователейАудита И Неактивные;
	Элементы.ОписаниеПроблемы.Видимость = Не ОбщийАудитВыполнен;
	Элементы.ПанельРабочегоСписка.Видимость = СписокПользователейАудита;
	Элементы.HTMLРабочееМесто.Видимость = ОбщийАудитВыполнен
		И (Не СписокПользователейАудита Или ПредставлениеАудита = 0);
	Элементы.РезультатАудитаПользователейДействие.Видимость = Ложь;
	Элементы.РезультатАудитаПользователейСтатусПроверкиАктивности.Видимость = Ложь;
	Элементы.РезультатАудитаПользователей.Видимость = СписокПользователейАудита И ПредставлениеАудита = 1;
	
КонецПроцедуры

&НаСервере
Процедура УпорядочитьАудитНаСервере(НовыйПорядок, Выбранные)
	
	Если Не ОбщийАудитВыполнен Или ПроверкаПаролейАктивна Или РекомендацияВыполняется Или АктивностьВыполняется Тогда
		Возврат;
	КонецЕсли;
	
	СброситьКонтекстныйПорядок();
	
	Если НовыйПорядок = 5 Или НовыйПорядок = 6 Тогда
		
		Если ПустаяСтрока(АдресПрочейАктивности) Тогда
			Возврат;
		КонецЕсли;
		
		ПорядокАудита = НовыйПорядок;
		УпорядочитьПрочуюАктивностьРабочегоСписка();
		ОбновитьHTMLРабочегоМеста();
		
		Возврат;
		
	КонецЕсли;
	
	Если ПредставлениеАудита <> 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПорядокАудита = НовыйПорядок;
	Обработка = РеквизитФормыВЗначение("Объект");
	Обработка.УпорядочитьАудит(ПорядокАудита);
	ЗначениеВРеквизитФормы(Обработка, "Объект");
	ЗафиксироватьРезультатАудита(Обработка);
	ОбновитьРабочееМестоАудита(Выбранные);
	
КонецПроцедуры

#КонецОбласти

#Область АктивностьПользователей

&НаКлиенте
Процедура НачатьЧтениеАктивности(Действия)
	
	Если АктивностьВыполняется Или ПроверкаПаролейАктивна Или РекомендацияВыполняется Тогда
		Возврат;
	КонецЕсли;
	
	РасчетДействийПользователя = Действия;
	
	Попытка
		
		Если Не Действия Тогда
			ОбновитьДатыПериодаАктивности();
		КонецЕсли;
		
		Прогресс = НоваяСтатистикаАктивностиНаСервере();
		АдресСтатистикиАктивности = Прогресс.Адрес;
		ОткрытьОкноХодаОперации(?(Действия, НСтр("ru='Действие пользователя'"), НСтр("ru='Активность пользователей'")),
			"");
		ОбновитьПрогрессАктивности(Прогресс);
		ПодключитьОбработчикОжидания("ПродолжитьРасчетАктивности", 0.1, Истина);
		
	Исключение
		ОбработатьСбойАктивности(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура УточнитьВыбранногоПользователяДействий()
	
	ИдентификаторПользователяДействий = ИдентификаторВыбранногоПользователя(ПользовательДействий,
		ИдентификаторПользователяДействий);
	ПоказатьПроекциюДействий();
	
КонецПроцедуры

&НаКлиенте
Процедура УточнитьВыбранногоПользователяАктивности()
	
	ИдентификаторПользователяАктивности = ИдентификаторВыбранногоПользователя(АктивностьПользователь,
		ИдентификаторПользователяАктивности);
	
КонецПроцедуры

&НаКлиенте
Функция ИдентификаторВыбранногоПользователя(ИмяПользователя, Идентификатор)
	
	Найденный = "";
	Количество = 0;
	
	Для Каждого Вариант Из КэшПользователейДействий Цикл
		
		Имя = СтрРазделить(Вариант.Представление, Символы.Таб)[0];
		
		Если Имя = ИмяПользователя Тогда
			
			Если Вариант.Значение = Идентификатор Тогда
				Возврат Идентификатор;
			КонецЕсли;
			
			Найденный = Вариант.Значение;
			Количество = Количество + 1;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ?(Количество = 1, Найденный, "");
	
КонецФункции

&НаКлиенте
Функция КандидатыПользователя(Текст, РазрешеныВсе = Ложь)
	
	Кандидаты = Новый СписокЗначений;
	Поиск = НРег(СокрЛП(Текст));
	
	Если РазрешеныВсе И ПустаяСтрока(Поиск) Тогда
		
		Данные = Новый Структура("Значение,ДополнительныеДанные", "", "");
		Кандидаты.Добавить(Данные, НСтр("ru='Все пользователи'"));
		
	КонецЕсли;
	
	Обработанные = Новый Соответствие;
	
	Для Каждого Вариант Из КэшПользователейДействий Цикл
		
		Если Не ЗначениеЗаполнено(Вариант.Значение) Или Обработанные.Получить(Вариант.Значение) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Обработанные.Вставить(Вариант.Значение, Истина);
		
		Представление = НРег(Вариант.Представление);
		
		Если ПустаяСтрока(Поиск) Или СтрНайти(Представление, Поиск) > 0
			Или СтрНайти(ЛатинскоеПредставлениеПользователя(Представление), Поиск) > 0 Тогда
			
			Название = СтрРазделить(Вариант.Представление, Символы.Таб)[0];
			Данные = Новый Структура("Значение,ДополнительныеДанные", Название, Вариант.Значение);
			Кандидаты.Добавить(Данные, Название);
			
			Если Не ПустаяСтрока(Поиск) И Кандидаты.Количество() = 50 Тогда
				Прервать;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Кандидаты;
	
КонецФункции

&НаКлиенте
Функция ЛатинскоеПредставлениеПользователя(Текст)
	
	Буквы = "абвгдеёжзийклмнопрстуфхцчшщъыьэюя";
	Замены = СтрРазделить("a,b,v,g,d,e,yo,zh,z,i,y,k,l,m,n,o,p,r,s,t,u,f,kh,ts,ch,sh,sch,,y,,e,yu,ya", ",", Истина);
	Результат = "";
	
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		
		Буква = Сред(Текст, Индекс, 1);
		Позиция = СтрНайти(Буквы, Буква);
		Результат = Результат + ?(Позиция = 0, Буква, Замены[Макс(0, Позиция - 1)]);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура НастроитьДействияПользователя()
	
	ДействияПользователяПериод = Новый СтандартныйПериод(АктивностьПериод.ДатаНачала, АктивностьПериод.ДатаОкончания);
	СписокПользователейДействий = Элементы.ПользовательДействий.СписокВыбора;
	СписокПользователейДействий.Очистить();
	Элементы.ПользовательДействий.ИсторияВыбораПриВводе = ИсторияВыбораПриВводе.НеИспользовать;
	ПоказательДействийПользователя = "Баллы";
	Элементы.ПоказательДействийПользователя.СписокВыбора.Добавить("Количество", "Количество");
	Элементы.ПоказательДействийПользователя.СписокВыбора.Добавить("Баллы", "Баллы");
	ДниДействийПользователя = 1;
	РабочиеДниДействийДоступны = Ложь;
	Элементы.ДниДействийПользователя.СписокВыбора.Добавить(1, "Рабочие");
	Элементы.ДниДействийПользователя.СписокВыбора.Добавить(0, "Календарные");
	ОбновитьВидимостьДнейДействий();
	
	ВидыДействий = Элементы.ВидДействийПользователя.СписокВыбора;
	ВидыДействий.Добавить("Сводка", НСтр("ru='Сводка по дням'"));
	ВидыДействий.Добавить("Часы", НСтр("ru='Карта по часам'"));
	ВидДействийПользователя = "Сводка";
	HTMLДействийПользователя = РеквизитФормыВЗначение("Объект").HTMLДействийПользователя(Неопределено);
	
КонецПроцедуры

&НаСервере
Процедура НастроитьАктивностьПользователей()
	
	ПериодичностьАктивности = 0;
	НазванияПериодов = СтрРазделить(НСтр("ru='День,Неделя,Месяц,Весь период'"), ",");
	
	Для Индекс = 0 По НазванияПериодов.Количество() - 1 Цикл
		Элементы.ПериодичностьАктивности.СписокВыбора.Добавить(Индекс, НазванияПериодов[Индекс]);
	КонецЦикла;
	
	Обработка = РеквизитФормыВЗначение("Объект");
	Период = Обработка.ПериодАктивностиПоУмолчанию();
	АктивностьДатаНачала = Период.Начало;
	АктивностьДатаОкончания = Период.Окончание;
	АктивностьПериод = Новый СтандартныйПериод(Период.Начало, КонецДня(Период.Окончание));
	HTMLАктивности = Обработка.HTMLАктивности(Неопределено);
	Элементы.АктивностьПользователь.СписокВыбора.Очистить();
	Элементы.АктивностьПользователь.ИсторияВыбораПриВводе = ИсторияВыбораПриВводе.НеИспользовать;
	КэшПользователейДействий = Обработка.ПользователиСтатистикиАктивности(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьРасчетПрочейАктивности(КоличествоДней, ДополнительныеПараметры) Экспорт
	
	Если КоличествоДней = Неопределено Или АктивностьВыполняется Или ПроверкаПаролейАктивна
		Или РекомендацияВыполняется Или ОжидающийОбщийАудит <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		ВыполняетсяРасчетПрочейАктивности = Истина;
		Прогресс = НоваяПрочаяАктивностьНаСервере(КоличествоДней);
		АдресСтатистикиАктивности = Прогресс.Адрес;
		ОткрытьОкноХодаОперации(НСтр("ru='Прочая активность пользователей'"), "");
		ОбновитьПрогрессАктивности(Прогресс);
		ПодключитьОбработчикОжидания("ПродолжитьРасчетАктивности", 0.1, Истина);
		
	Исключение
		ОбработатьСбойАктивности(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Функция НоваяПрочаяАктивностьНаСервере(КоличествоДней)
	
	Если Не ОбщийАудитВыполнен Тогда
		ВызватьИсключение НСтр("ru='Сначала выполните общий аудит.'");
	КонецЕсли;
	
	Возврат РеквизитФормыВЗначение("Объект").НоваяПрочаяАктивность(КоличествоДней, УникальныйИдентификатор);
	
КонецФункции

&НаСервере
Функция ИтогПрочейАктивности()
	
	Если ПустаяСтрока(АдресПрочейАктивности) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ПолучитьИзВременногоХранилища(АдресПрочейАктивности);
	
КонецФункции

&НаСервере
Функция СчетчикиПрочейАктивности()
	
	Итог = ИтогПрочейАктивности();
	
	Если Итог = Неопределено Тогда
		Возврат ?(ПустаяСтрока(АдресПрочейАктивности), Неопределено, Новый Соответствие);
	КонецЕсли;
	
	Возврат ?(НачалоДня(Итог.Окончание) = НачалоДня(ТекущаяДата()), Итог.Счетчики, Новый Соответствие);
	
КонецФункции

&НаСервере
Процедура ОбновитьПрочуюАктивностьРабочегоСписка(Счетчики)
	
	Если Счетчики = Неопределено Тогда
		УпорядочитьПрочуюАктивностьРабочегоСписка();
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаАудита Из РабочийСписок Цикл
		
		Количество = Счетчики.Получить(НРег(СтрокаАудита.ИдентификаторПользователяИБ));
		СтрокаАудита.ПрочаяАктивность = ?(Количество = Неопределено, -1, Количество);
		
	КонецЦикла;
	
	УпорядочитьПрочуюАктивностьРабочегоСписка();
	
КонецПроцедуры

&НаСервере
Процедура УпорядочитьПрочуюАктивностьРабочегоСписка()
	
	Если Не ПустаяСтрока(ПолеПорядкаПодробногоСписка) Тогда
		
		РабочийСписок.Сортировать(ПолеПорядкаПодробногоСписка + " " + НаправлениеПорядкаПодробногоСписка);
		
		Возврат;
		
	КонецЕсли;
	
	Если ПорядокАудита <> 5 И ПорядокАудита <> 6 Тогда
		Возврат;
	КонецЕсли;
	
	Направление = ?(ПорядокАудита = 5, "Убыв", "Возр");
	РабочийСписок.Сортировать("ПрочаяАктивность " + Направление
		+ ", ПолноеИмя Возр, ИдентификаторПользователяИБ Возр");
	ВерсияПредставленияАудита = Строка(Новый УникальныйИдентификатор);
	
КонецПроцедуры

&НаСервере
Функция ЗаголовокПрочейАктивности()
	
	Итог = ИтогПрочейАктивности();
	
	Если Итог = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Если НачалоДня(Итог.Окончание) <> НачалоДня(ТекущаяДата()) Тогда
		Возврат НСтр("ru='Прочая активность: обновите расчёт'");
	КонецЕсли;
	
	Дней = (НачалоДня(Итог.Окончание) - Итог.Начало) / 86400 + 1;
	
	Возврат ?(Дней = 1, НСтр("ru='Прочая активность за последний день'"),
		СтрШаблон(НСтр("ru='Прочая активность за последние %1 дн.'"), Дней));
	
КонецФункции

&НаКлиенте
Процедура ПродолжитьРасчетАктивности()
	
	Если Не АктивностьВыполняется Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		Прогресс = СледующаяСтатистикаАктивностиНаСервере(АдресСтатистикиАктивности);
		ОбновитьПрогрессАктивности(Прогресс);
		
		Если Не Прогресс.Завершено Тогда
			ПодключитьОбработчикОжидания("ПродолжитьРасчетАктивности", 0.1, Истина);
		КонецЕсли;
		
	Исключение
		ОбработатьСбойАктивности(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрерватьРасчетАктивности()
	
	Если Не АктивностьВыполняется Тогда
		Возврат;
	КонецЕсли;
	
	ОтключитьОбработчикОжидания("ПродолжитьРасчетАктивности");
	
	Попытка
		
		Прогресс = ОтмененнаяСтатистикаАктивностиНаСервере(АдресСтатистикиАктивности);
		ОбновитьПрогрессАктивности(Прогресс);
		
	Исключение
		ОбработатьСбойАктивности(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПрогрессАктивности(Прогресс)
	
	Если Прогресс.Свойство("ПараметрыАктивности") Тогда
		ПараметрыТекущегоРасчетаАктивности = Прогресс.ПараметрыАктивности;
	КонецЕсли;
	
	Если Прогресс.Свойство("РезультатАктивностиОбновлен") Тогда
		
		ПараметрыРезультатаАктивности = ПараметрыТекущегоРасчетаАктивности;
		ИсходныйHTMLАктивности = HTMLАктивности;
		ОтметитьИзмененныеПараметрыАктивности();
		
	КонецЕсли;
	
	ПрогрессАктивности = Прогресс.Процент;
	АктивностьВыполняется = Не Прогресс.Завершено;
	Элементы.ОтменитьАктивность.Видимость = Ложь;
	Элементы.ИндикаторАктивности.Видимость = Ложь;
	Элементы.РассчитатьАктивность.Доступность = Не АктивностьВыполняется;
	Элементы.АктивностьПериод.Доступность = Не АктивностьВыполняется;
	Элементы.АктивностьПользователь.Доступность = Не АктивностьВыполняется;
	Элементы.ПериодичностьАктивности.Доступность = Не АктивностьВыполняется;
	Элементы.РассчитатьДействияПользователя.Доступность = Не АктивностьВыполняется;
	Элементы.ДействияПользователяПериод.Доступность = Не АктивностьВыполняется;
	Элементы.ПользовательДействий.Доступность = Не АктивностьВыполняется;
	Элементы.ВидДействийПользователя.Доступность = Не АктивностьВыполняется;
	Элементы.ДниДействийПользователя.Доступность = Не АктивностьВыполняется;
	Элементы.ПоказательДействийПользователя.Доступность = Не АктивностьВыполняется;
	
	Если Прогресс.Завершено Тогда
		АдресСтатистикиАктивности = "";
	КонецЕсли;
	
	ОбновитьОкноХодаОперации(Прогресс);
	
	Если Прогресс.Завершено Тогда
		
		Если ВыполняетсяРасчетПрочейАктивности <> Истина Тогда
			ТекущийЭлемент = ?(РасчетДействийПользователя, Элементы.ДействияПользователяПериод,
				Элементы.АктивностьПериод);
		КонецЕсли;
		
		РасчетДействийПользователя = Ложь;
		ВыполняетсяРасчетПрочейАктивности = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьСбойАктивности(ТекстОшибки)
	
	ОсвободитьСостояниеАктивности();
	Прогресс = Новый Структура("Процент,Текст,Завершено", 0,
		НСтр("ru='Расчёт не выполнен.'") + " " + ТекстОшибки + " " + НСтр("ru='Предыдущий результат сохранён.'"),
			Истина);
	ОбновитьПрогрессАктивности(Прогресс);
	ПоказатьПредупреждение(, Прогресс.Текст);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсвободитьСостояниеАктивности()
	
	Если Не ЗначениеЗаполнено(АдресСтатистикиАктивности) Тогда
		Возврат;
	КонецЕсли;
	
	ОтключитьОбработчикОжидания("ПродолжитьРасчетАктивности");
	
	Попытка
		ОсвободитьСтатистикуАктивностиНаСервере(АдресСтатистикиАктивности);
	Исключение
		// При закрытии формы её временное хранилище освободит платформа.
		АдресСтатистикиАктивности = "";
	КонецПопытки;
	
	АдресСтатистикиАктивности = "";
	
КонецПроцедуры

&НаСервере
Процедура ПерерисоватьГрафикАктивности()
	
	Если ЗначениеЗаполнено(АдресГрафикаАктивности) Тогда
		
		Статистика = ПолучитьИзВременногоХранилища(АдресГрафикаАктивности);
		HTMLАктивности = РеквизитФормыВЗначение("Объект").HTMLАктивности(Статистика, ПериодичностьАктивности);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция НоваяСтатистикаАктивностиНаСервере()
	
	Обработка = РеквизитФормыВЗначение("Объект");
	
	Если РасчетДействийПользователя Тогда
		Возврат Обработка.НоваяСтатистикаДействий(ДействияПользователяПериод, УникальныйИдентификатор,
			ИдентификаторПользователяДействий, АдресКешаДействий);
	КонецЕсли;
	
	Прогресс = Обработка.НоваяСтатистикаАктивности(
		АктивностьДатаНачала, АктивностьДатаОкончания, УникальныйИдентификатор, ИдентификаторПользователяАктивности);
	Прогресс.Вставить("ПараметрыАктивности", Новый Структура("Начало,Окончание,Пользователь", АктивностьДатаНачала,
		АктивностьДатаОкончания, ИдентификаторПользователяАктивности));
	Возврат Прогресс;
	
КонецФункции

&НаСервере
Функция СледующаяСтатистикаАктивностиНаСервере(Адрес)
	
	Обработка = РеквизитФормыВЗначение("Объект");
	Прогресс = Обработка.СледующаяПорцияАктивности(Адрес);
	
	Если Прогресс.Свойство("ИтогПрочейАктивности") Тогда
		
		АдресПрочейАктивности = ЗамененныйАдресГрафика(АдресПрочейАктивности, Прогресс.ИтогПрочейАктивности);
		Счетчики = СчетчикиПрочейАктивности();
		Предложения = Обработка.ПредложенияРекомендаций(ОбщийАудитВыполнен, ПорогНеактивности, Счетчики);
		ОбновитьКоличествоРекомендаций(Предложения);
		
		ОбновитьПрочуюАктивностьРабочегоСписка(Счетчики);
		ОбновитьHTMLРабочегоМеста(Предложения, Истина);
		Прогресс.Удалить("ИтогПрочейАктивности");
		
	КонецЕсли;
	
	Если РасчетДействийПользователя И Прогресс.Свойство("АдресКеша") Тогда
		АдресКешаДействий = Прогресс.АдресКеша;
	КонецЕсли;
	
	ПрименитьСтатистикуАктивностиНаСервере(Прогресс, Обработка);
	
	Возврат Прогресс;
	
КонецФункции

&НаСервере
Процедура ПрименитьСтатистикуАктивностиНаСервере(Прогресс, Обработка)
	
	Если Прогресс.Свойство("Статистика") Тогда
		
		Если РасчетДействийПользователя Тогда
			
			РабочиеДаты = Неопределено;
			РабочиеДниДействийДоступны = Прогресс.Статистика.Свойство("РабочиеДаты", РабочиеДаты)
				И РабочиеДаты <> Неопределено;
			HTML = Обработка.HTMLДействийПользователя(Прогресс.Статистика, ВидДействийПользователя = "Часы",
				ДниДействийПользователя = 1, ПоказательДействийПользователя = "Баллы");
			АдресГрафикаДействий = ЗамененныйАдресГрафика(АдресГрафикаДействий, Прогресс.Статистика);
			ОбновитьВидимостьДнейДействий();
			HTMLДействийПользователя = HTML;
			
		Иначе
			
			HTML = Обработка.HTMLАктивности(Прогресс.Статистика, ПериодичностьАктивности);
			АдресГрафикаАктивности = ЗамененныйАдресГрафика(АдресГрафикаАктивности, Прогресс.Статистика);
			HTMLАктивности = HTML;
			Сводка = Обработка.СводкаАктивностиДляРезультата(Прогресс.Статистика);
			
			Если Сводка <> Неопределено Тогда
				АдресСводкиАктивности = ЗамененныйАдресГрафика(АдресСводкиАктивности, Сводка);
			КонецЕсли;
			
			Прогресс.Вставить("РезультатАктивностиОбновлен", Истина);
			
			Если ЗначениеЗаполнено(АдресРезультатаАудита) Тогда
				
				УдалитьИзВременногоХранилища(АдресРезультатаАудита);
				АдресРезультатаАудита = "";
				
			КонецЕсли;
			
		КонецЕсли;
		
		Прогресс.Удалить("Статистика");
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗамененныйАдресГрафика(СтарыйАдрес, Статистика)
	
	НовыйАдрес = ПоместитьВоВременноеХранилище(Статистика, УникальныйИдентификатор);
	
	Если ЗначениеЗаполнено(СтарыйАдрес) Тогда
		УдалитьИзВременногоХранилища(СтарыйАдрес);
	КонецЕсли;
	
	Возврат НовыйАдрес;
	
КонецФункции

&НаСервере
Процедура ОбновитьВидимостьДнейДействий()
	
	ПоЧасам = ВидДействийПользователя = "Часы";
	ЕстьРезультат = ЗначениеЗаполнено(АдресГрафикаДействий);
	Элементы.ДниДействийПользователя.Видимость = ЕстьРезультат И ПоЧасам И РабочиеДниДействийДоступны;
	Элементы.КалендарныеДниДействий.Видимость = ЕстьРезультат И ПоЧасам И Не РабочиеДниДействийДоступны;
	
КонецПроцедуры

&НаСервере
Процедура ПерерисоватьГрафикДействий()
	
	ОбновитьВидимостьДнейДействий();
	
	Если Не ЗначениеЗаполнено(АдресГрафикаДействий) Тогда
		Возврат;
	КонецЕсли;
	
	Статистика = ПолучитьИзВременногоХранилища(АдресГрафикаДействий);
	HTMLДействийПользователя = РеквизитФормыВЗначение("Объект").HTMLДействийПользователя(
		Статистика, ВидДействийПользователя = "Часы", ДниДействийПользователя = 1,
			ПоказательДействийПользователя = "Баллы");
	
КонецПроцедуры

&НаСервере
Функция ОтмененнаяСтатистикаАктивностиНаСервере(Адрес)
	
	Обработка = РеквизитФормыВЗначение("Объект");
	Прогресс = Обработка.ОтмененнаяСтатистикаАктивности(Адрес);
	ПрименитьСтатистикуАктивностиНаСервере(Прогресс, Обработка);
	
	Возврат Прогресс;
	
КонецФункции

&НаСервере
Процедура ОсвободитьСтатистикуАктивностиНаСервере(Адрес)
	
	РеквизитФормыВЗначение("Объект").ОсвободитьСтатистикуАктивности(Адрес);
	
КонецПроцедуры

#КонецОбласти

#Область ДоступностьДействийПользователя

&НаКлиенте
Процедура ОбновитьДоступностьДействийПользователя()
	
	СтраницаПользователей = Элементы.Страницы.ТекущаяСтраница = Элементы.Пользователи;
	ДействияДоступны = СтраницаПользователей И Не ПроверкаПаролейАктивна;
	Элементы.ЗапуститьПодПользователем.Доступность = ДействияДоступны;
	Элементы.ФормаСкопироватьПраваОт.Доступность = ДействияДоступны;
	
КонецПроцедуры

#КонецОбласти

#Область ВыделениеСтрокАудита

&НаКлиенте
Процедура ИзменитьВыделениеСтрокиHTML(Индекс, ДанныеСобытия)
	
	Выделить = Не РабочийСписок[Индекс].Выбрана;
	Начало = Индекс;
	Конец = Индекс;
	
	Если НажатShift(ДанныеСобытия) И НачалоДиапазонаАудита <> Неопределено
		И НачалоДиапазонаАудита.Версия = ВерсияПредставленияАудита
		И НачалоДиапазонаАудита.Индекс >= 0 И НачалоДиапазонаАудита.Индекс < РабочийСписок.Количество() Тогда
		
		Начало = Мин(Индекс, НачалоДиапазонаАудита.Индекс);
		Конец = Макс(Индекс, НачалоДиапазонаАудита.Индекс);
		
	Иначе
		НачалоДиапазонаАудита = Новый Структура("Версия,Индекс", ВерсияПредставленияАудита, Индекс);
	КонецЕсли;
	
	Для НомерСтроки = Начало По Конец Цикл
		РабочийСписок[НомерСтроки].Выбрана = Выделить;
	КонецЦикла;
	
	ОбновитьДиапазонГалокHTML(Начало, Конец, Выделить);
	
КонецПроцедуры

&НаКлиенте
Функция НажатShift(ДанныеСобытия)
	
	Попытка
		Возврат ДанныеСобытия.Event.shiftKey = Истина;
	Исключение
		// При отсутствии сведений браузера сохраняется обычная одиночная отметка.
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьДиапазонГалокHTML(Начало, Конец, Выбрана)
	
	Попытка
		
		Документ = Элементы.HTMLРабочееМесто.Документ;
		
		Для НомерСтроки = Начало По Конец Цикл
			
			Галка = Документ.getElementById("audit-check-" + Формат(НомерСтроки, "ЧГ=0; ЧН=0"));
			Галка.setAttribute("aria-checked", ?(Выбрана, "true", "false"));
			Галка.innerHTML = ?(Выбрана, "&#9745;", "&#9744;");
			
		КонецЦикла;
		
	Исключение
		
		ВерсияПредставленияАудита = Строка(Новый УникальныйИдентификатор);
		НачалоДиапазонаАудита = Неопределено;
		ОбновитьHTMLРабочегоМеста();
		
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВыделениеСтрокАудита(Выделить)
	
	Если ПроверкаПаролейАктивна Или Не Элементы.ВыделитьВсеСтрокиАудита.Доступность Тогда
		Возврат;
	КонецЕсли;
	
	ВыделенныеСтроки = Элементы.РезультатАудитаПользователей.ВыделенныеСтроки;
	ВыделенныеСтроки.Очистить();
	
	Для Каждого СтрокаАудита Из РабочийСписок Цикл
		
		СтрокаАудита.Выбрана = Выделить;
		
		Если Выделить Тогда
			ВыделенныеСтроки.Добавить(СтрокаАудита.ПолучитьИдентификатор());
		КонецЕсли;
		
	КонецЦикла;
	
	НачалоДиапазонаАудита = Неопределено;
	
	Если ПредставлениеАудита = 0 Тогда
		ОбновитьДиапазонГалокHTML(0, РабочийСписок.Количество() - 1, Выделить);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОкноХодаОперации

&НаКлиенте
Процедура ОткрытьОкноХодаОперации(ЗаголовокОперации, ПодсказкаОтмены)
	
	ИдентификаторОкнаХода = Строка(Новый УникальныйИдентификатор);
	СостояниеОкнаХода = Неопределено;
	ПараметрыОкна = Новый Структура("ЗаголовокОперации,ПодсказкаОтмены,ИдентификаторОперации", ЗаголовокОперации,
		ПодсказкаОтмены, ИдентификаторОкнаХода);
	ЧастиИмени = СтрРазделить(ИмяФормы, ".");
	ИмяОкнаХода = ЧастиИмени[0] + "." + ЧастиИмени[1] + ".Форма.ХодОперации";
	ОткрытьФорму(ИмяОкнаХода, ПараметрыОкна, ЭтотОбъект, ИдентификаторОкнаХода);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОкноХодаОперации(Прогресс)
	
	Если ИдентификаторОкнаХода = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Прогресс.Завершено Тогда
		ЗакрытьОкноХодаОперации();
	Иначе
		
		Подробности = "";
		
		Если Прогресс.Свойство("Подробности") Тогда
			Подробности = Прогресс.Подробности;
		КонецЕсли;
		
		ПередатьСостояниеОкнаХода(Прогресс.Текст, Прогресс.Процент, Подробности);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьОкноХодаОперации()
	
	Если ИдентификаторОкнаХода = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Оповестить("АудитПользователей.ЗакрытьХод", ИдентификаторОкнаХода, ЭтотОбъект);
	ИдентификаторОкнаХода = Неопределено;
	СостояниеОкнаХода = Неопределено;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменаИзОкнаХодаОперации()
	
	Если ОжидающееМассовоеДействие <> Неопределено Тогда
		ОжидающееМассовоеДействие.Отменено = Истина;
	ИначеЕсли РекомендацияВыполняется Тогда
		ОтменитьРекомендацию();
	ИначеЕсли ПроверкаПаролейАктивна Тогда
		ПрерватьАудитПаролей();
	ИначеЕсли АктивностьВыполняется Тогда
		ПрерватьРасчетАктивности();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОповещенияОкнаХода

&НаКлиенте
Процедура ПоказатьОжиданиеОкнаХода(Текст)
	
	ПередатьСостояниеОкнаХода(Текст, 0, "", Истина, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередатьСостояниеОкнаХода(Текст, Процент, Подробности = "", Ожидание = Ложь, МожноОтменить = Истина)
	
	Если ИдентификаторОкнаХода = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СостояниеОкнаХода = Новый Структура;
	СостояниеОкнаХода.Вставить("Идентификатор", ИдентификаторОкнаХода);
	СостояниеОкнаХода.Вставить("Текст", Текст);
	СостояниеОкнаХода.Вставить("Процент", Процент);
	СостояниеОкнаХода.Вставить("Подробности", Подробности);
	СостояниеОкнаХода.Вставить("Ожидание", Ожидание);
	СостояниеОкнаХода.Вставить("МожноОтменить", МожноОтменить);
	Оповестить("АудитПользователей.Ход", СостояниеОкнаХода, ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ВыборПериодаАктивности

&НаКлиенте
Процедура ДлительныйРасчетДействийПодтвержден(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ДлительныйПериодДействийПодтвержден = Истина;
	НачатьЧтениеАктивности(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодДействийПользователяВыбран(ВыбранныйПериод, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйПериод <> Неопределено Тогда
		
		ДействияПользователяПериод = ВыбранныйПериод;
		ПоказатьПроекциюДействий();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодАктивностиВыбран(ВыбранныйПериод, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйПериод = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	АктивностьПериод = ВыбранныйПериод;
	ОбновитьДатыПериодаАктивности();
	ОтметитьИзмененныеПараметрыАктивности();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДатыПериодаАктивности()
	
	АктивностьДатаНачала = АктивностьПериод.ДатаНачала;
	АктивностьДатаОкончания = АктивностьПериод.ДатаОкончания;
	
КонецПроцедуры

#КонецОбласти

#Область РекомендуемыеДействия

&НаКлиенте
Процедура ОбновитьАудитПослеРекомендации() Экспорт
	
	Сообщение = ОжидающееСообщениеРекомендации;
	ОжидающееСообщениеРекомендации = Неопределено;
	
	Попытка
		
		РекомендацияВыполняется = Ложь;
		ОбновитьРабочееМестоАудита(, Истина);
		ИнформацияОПользователеИнициализирована = Ложь;
		Элементы.СписокПользователей.Обновить();
		
	Исключение
		
		Если Сообщение = Неопределено Тогда
			Сообщение = Новый Структура("Текст,Заголовок", "", "");
		КонецЕсли;
		
		Сообщение.Заголовок = НСтр("ru='Действие выполнено, список не обновлён'");
		Сообщение.Текст = Сообщение.Текст + Символы.ПС
			+ СтрШаблон(НСтр("ru='Изменения сохранены, но аудит не обновлён. Выполните общий аудит. %1'"),
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		
	КонецПопытки;
	
	ЗакрытьОкноХодаОперации();
	
	Если Сообщение <> Неопределено Тогда
		ПоказатьПредупреждение(, Сообщение.Текст, , Сообщение.Заголовок);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьДействиеРекомендации(Части)
	
	Если РекомендацияВыполняется Или ПроверкаПаролейАктивна Или АктивностьВыполняется Тогда
		Возврат;
	КонецЕсли;
	
	Если Части.Количество() <> 4 Или Части[0] <> "about" Или Части[1] <> "blank#rec217"
		Или Части[2] <> ВерсияРекомендаций Тогда
		Возврат;
	КонецЕсли;
	
	Код = Части[3];
	
	Если Код = "ПравилаПаролей" Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("РекомендуемыеНастройкиПодтверждены", ЭтотОбъект),
			НСтр("ru='Установить рекомендуемые настройки входа?'"), РежимДиалогаВопрос.ДаНет, 0,
				КодВозвратаДиалога.Нет);
	ИначеЕсли Код = "ЗащитаВхода" Тогда
		ПредложитьНастройкуЗащитыВхода();
	ИначеЕсли Код = "ПроверитьПравилаПаролей" Тогда
		ОткрытьНастройкиПаролей();
	ИначеЕсли Код = "Неактивные" Тогда
		ОткрытьПорогНеактивности(Ложь);
	Иначе
		ПредложитьРекомендованноеДействие(Код);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПредложитьНастройкуЗащитыВхода()
	
	Попытка
		
		Политика = ПолитикаЗащитыВходаНаСервере();
		
		Если Не Политика.Известна Тогда
			
			ПоказатьПредупреждение(, Политика.Описание);
			
			Возврат;
			
		КонецЕсли;
		
		Если Политика.Лимит >= 1 И Политика.Лимит <= 10 Тогда
			
			ОбновитьРекомендацииНаСервере();
			
			Возврат;
			
		КонецЕсли;
		
		ПоказатьВопрос(Новый ОписаниеОповещения("НастройкаЗащитыВходаПодтверждена", ЭтотОбъект, Политика),
			СтрШаблон(НСтр("ru='%1 Установить лимит 3 попытки и блокировку на %2 с?'"), Политика.Описание,
				Политика.Длительность),
			РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Нет);
		
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаЗащитыВходаПодтверждена(Ответ, Политика) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Или ПроверкаПаролейАктивна Или АктивностьВыполняется
		Или РекомендацияВыполняется Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		Текст = НастроитьЗащитуВходаНаСервере(Политика);
		ОбновитьРекомендацииНаСервере();
		ПоказатьПредупреждение(, Текст);
		
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Функция ПолитикаЗащитыВходаНаСервере()
	
	Возврат РеквизитФормыВЗначение("Объект").ПолитикаЗащитыВхода();
	
КонецФункции

&НаСервере
Функция НастроитьЗащитуВходаНаСервере(Знач Политика)
	
	Обработка = РеквизитФормыВЗначение("Объект");
	Текст = Обработка.НастроитьЗащитуВхода(Политика);
	ЗначениеВРеквизитФормы(Обработка, "Объект");
	Возврат Текст;
	
КонецФункции

&НаСервере
Процедура ОбновитьРекомендацииНаСервере(Предложения = Неопределено)
	
	Если Не ОбщийАудитВыполнен Или КатегорияАудита <> "ОбщиеРекомендации" Тогда
		Возврат;
	КонецЕсли;
	
	ВерсияРекомендаций = Строка(Новый УникальныйИдентификатор);
	Обработка = РеквизитФормыВЗначение("Объект");
	
	Если Предложения = Неопределено Тогда
		
		Предложения = Обработка.ПредложенияРекомендаций(ОбщийАудитВыполнен, ПорогНеактивности,
			СчетчикиПрочейАктивности());
		ОбновитьКоличествоРекомендаций(Предложения);
		
	КонецЕсли;
	
	ОбновитьHTMLКатегорий();
	HTMLРабочееМесто = Обработка.HTMLРекомендуемыхДействий(Предложения,
		РеквизитФормыВЗначение("СтатусыРекомендаций"), ВерсияРекомендаций, РекомендацияВыполняется, ОбщийАудитВыполнен);
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьСтатусРекомендации(Код, Текст)
	
	СтрокиСтатуса = СтатусыРекомендаций.НайтиСтроки(Новый Структура("Код", Код));
	
	Если СтрокиСтатуса.Количество() = 0 Тогда
		
		СтрокаСтатуса = СтатусыРекомендаций.Добавить();
		СтрокаСтатуса.Код = Код;
		
	Иначе
		СтрокаСтатуса = СтрокиСтатуса[0];
	КонецЕсли;
	
	СтрокаСтатуса.Текст = Текст;
	
	Если Не РекомендацияВыполняется Тогда
		ОбновитьРекомендацииНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВведенПорогНеактивности(Порог, ДополнительныеПараметры) Экспорт
	
	Если Порог = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОбновитьАудитПользователей(?(ДополнительныеПараметры.ТолькоПорог, "", "Неактивные"), Порог);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПорогНеактивности(ТолькоПорог)
	
	ПараметрыОкна = Новый Структура("ПорогДней,ТолькоПорог", ПорогНеактивности, ТолькоПорог);
	ДанныеОповещения = Новый Структура("ТолькоПорог", ТолькоПорог);
	ОткрытьФорму("ВнешняяОбработка.АдминистрированиеИАудитПользователей.Форма.НеактивныеПользователи",
		ПараметрыОкна, ЭтотОбъект, , , , Новый ОписаниеОповещения("ВведенПорогНеактивности", ЭтотОбъект,
			ДанныеОповещения),
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПредложитьДействиеПоОтбору(Код, Выбранные, Порог = 90, Подтверждено = Ложь)
	
	Если РекомендацияВыполняется Или ПроверкаПаролейАктивна Или АктивностьВыполняется Тогда
		Возврат;
	КонецЕсли;
	
	Если Выбранные.Количество() = 0 И Код <> "Неактивные" Тогда
		
		ПоказатьПредупреждение(, НСтр("ru='Выберите строки'"));
		
		Возврат;
		
	КонецЕсли;
	
	План = ДействиеПоОтборуНаСервере(Код, Выбранные, Истина, Порог);
	
	Если План.Изменены.Количество() = 0 Тогда
		
		ПоказатьРезультатОперации(План, Истина, Код);
		
		Возврат;
		
	КонецЕсли;
	
	Данные = Новый Структура("Код,План,Порог", Код, План, Порог);
	
	Если Подтверждено Тогда
		
		ДействиеПоОтборуПодтверждено(КодВозвратаДиалога.Да, Данные);
		
		Возврат;
		
	КонецЕсли;
	
	Текст = ВопросПоДействию(Код, План.Изменены.Количество(), План.Изменены[0].Пользователь);
	ПоказатьВопрос(Новый ОписаниеОповещения("ДействиеПоОтборуПодтверждено", ЭтотОбъект, Данные),
		Текст, РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Нет);
	
КонецПроцедуры

&НаКлиенте
Процедура ДействиеПоОтборуПодтверждено(Ответ, Данные) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Выбранные = Данные.План.Изменены;
	Итог = Новый Структура("Изменены,Пропущены,Ошибки", Новый Массив,
		Данные.План.Пропущены, Данные.План.Ошибки);
	ЗаписатьОтклоненныеСтрокиНаСервере(Данные.Код, Итог);
	
	Если Выбранные.Количество() > 1 Тогда
		
		НачатьМассовоеДействие(Данные.Код, Выбранные, Данные.Порог, Итог);
		
		Возврат;
		
	КонецЕсли;
	
	Результат = ДействиеПоОтборуНаСервере(Данные.Код, Выбранные, Ложь, Данные.Порог);
	ДополнитьИтогДействия(Результат, Итог);
	ПоказатьРезультатОперации(Результат, Ложь, Данные.Код);
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьОтклоненныеСтрокиНаСервере(Код, Итог)
	
	Если Итог.Пропущены.Количество() = 0 И Итог.Ошибки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Обработка = РеквизитФормыВЗначение("Объект");
	Обработка.ЗаписатьОтклоненныеСтрокиАудита(Код, Итог);
	ЗначениеВРеквизитФормы(Обработка, "Объект");
	ЗафиксироватьРезультатАудита(Обработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнитьИтогДействия(Итог, Дополнение)
	
	Для Каждого ИмяНабора Из СтрРазделить("Изменены,Пропущены,Ошибки", ",") Цикл
		
		Для Каждого Запись Из Дополнение[ИмяНабора] Цикл
			Итог[ИмяНабора].Добавить(Запись);
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьМассовоеДействие(Код, Выбранные, Порог, Результат)
	
	Если РекомендацияВыполняется Или ОжидающееМассовоеДействие <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОжидающееМассовоеДействие = Новый Структура;
	ОжидающееМассовоеДействие.Вставить("Код", Код);
	ОжидающееМассовоеДействие.Вставить("Выбранные", Выбранные);
	ОжидающееМассовоеДействие.Вставить("Порог", Порог);
	ОжидающееМассовоеДействие.Вставить("Индекс", 0);
	ОжидающееМассовоеДействие.Вставить("РазмерПакета", Макс(1, Цел((Выбранные.Количество() + 11) / 12)));
	ОжидающееМассовоеДействие.Вставить("Отменено", Ложь);
	ОжидающееМассовоеДействие.Вставить("Результат", Результат);
	РекомендацияВыполняется = Истина;
	
	Попытка
		
		ОткрытьОкноХодаОперации(НСтр("ru='Действие с пользователями'"),
			НСтр("ru='Отмена доступна между пакетами. Выполненные изменения сохраняются.'"));
		ПередатьСостояниеОкнаХода(НСтр("ru='Подготовка массового действия…'"), 0);
		
	Исключение
		
		ТекстОшибки = НСтр("ru='Не удалось начать действие:'") + " " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗакрытьОжиданиеМассовогоДействия();
		ПоказатьПредупреждение(, ТекстОшибки);
		
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьМассовоеДействие()
	
	Если ОжидающееМассовоеДействие = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Данные = ОжидающееМассовоеДействие;
	ОжидающееМассовоеДействие = Неопределено;
	
	Попытка
		
		Если Не Данные.Отменено И Данные.Индекс < Данные.Выбранные.Количество() Тогда
			
			Пакет = Новый Массив;
			Граница = Мин(Данные.Индекс + Данные.РазмерПакета, Данные.Выбранные.Количество());
			
			Для Индекс = Данные.Индекс По Граница - 1 Цикл
				Пакет.Добавить(Данные.Выбранные[Индекс]);
			КонецЦикла;
			
			РезультатПакета = ДействиеПоОтборуНаСервере(Данные.Код, Пакет, Ложь, Данные.Порог, Ложь);
			
			ДополнитьИтогДействия(Данные.Результат, РезультатПакета);
			
			Данные.Индекс = Граница;
			ОжидающееМассовоеДействие = Данные;
			Процент = Мин(99, Цел(100 * Данные.Индекс / Макс(1, Данные.Выбранные.Количество())));
			ПередатьСостояниеОкнаХода(СтрШаблон(НСтр("ru='Обработано пользователей: %1 из %2.'"),
				Данные.Индекс, Данные.Выбранные.Количество()),
				Процент);
			ПодключитьОбработчикОжидания("ПродолжитьМассовоеДействие", 0.1, Истина);
			
			Возврат;
			
		КонецЕсли;
		
		ПередатьСостояниеОкнаХода(НСтр("ru='Обновляем список…'"), 99, "", Ложь, Ложь);
		ОбновитьАудитПослеМассовогоДействияНаСервере(Данные.Выбранные, Данные.Результат);
		
	Исключение
		
		ТекстОшибки = НСтр(
			"ru='Операция не завершена; возможно частичное выполнение. Перед повтором выполните общий аудит.'") + " "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗакрытьОжиданиеМассовогоДействия();
		ПоказатьПредупреждение(, ТекстОшибки);
		
		Возврат;
		
	КонецПопытки;
	
	ЗакрытьОжиданиеМассовогоДействия();
	
	Если Данные.Отменено Тогда
		ПоказатьПредупреждение(, НСтр("ru='Операция отменена. Уже выполненные изменения сохранены.'"));
	КонецЕсли;
	
	ПоказатьРезультатОперации(Данные.Результат, Ложь, Данные.Код);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьОжиданиеМассовогоДействия()
	
	ОтключитьОбработчикОжидания("ПродолжитьМассовоеДействие");
	ОжидающееМассовоеДействие = Неопределено;
	РекомендацияВыполняется = Ложь;
	ЗакрытьОкноХодаОперации();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьАудитПослеМассовогоДействияНаСервере(Выбранные, Результат)
	
	Обработка = РеквизитФормыВЗначение("Объект");
	
	Попытка
		
		Обработка.АктуализироватьВыбранных(Выбранные, ПорогНеактивности, АдресПодтвержденийПаролей);
		ЗначениеВРеквизитФормы(Обработка, "Объект");
		ЗафиксироватьСнимокАудита(Обработка);
		ОбновитьРабочееМестоАудита(, Истина);
		
	Исключение
		Результат.Вставить("ОшибкаОбновления",
			НСтр(
				"ru='Действие выполнено, но обновление аудита не завершено. Обновите общий аудит перед анализом результатов.'"));
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПорогНеактивностиНаСервере(Порог)
	
	Если ТипЗнч(Порог) <> Тип("Число") Или Порог < 1 Или Порог > 3650 Или Порог <> Цел(Порог) Тогда
		ВызватьИсключение НСтр("ru='Укажите целое количество дней от 1 до 3650.'");
	КонецЕсли;
	
	РеквизитФормыВЗначение("Объект").СохранитьПорогНеактивностиАудита(Порог);
	ПорогНеактивности = Порог;
	
КонецПроцедуры

&НаСервере
Функция ДействиеПоОтборуНаСервере(Код, Выбранные, Предпросмотр, Порог, ОбновитьСписок = Истина)
	
	Обработка = РеквизитФормыВЗначение("Объект");
	Счетчики = ?(Код = "Неактивные", СчетчикиПрочейАктивности(), Неопределено);
	Результат = Обработка.ИзменениеДоступаПоАудиту(Код, Выбранные, Предпросмотр, АдресПодтвержденийПаролей, Порог,
		Счетчики);
	
	Если Предпросмотр Тогда
		Возврат Результат;
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(Обработка, "Объект");
	ЗафиксироватьРезультатАудита(Обработка);
	
	Если Не ОбновитьСписок Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если Не Предпросмотр Тогда
		
		Попытка
			
			Обработка.АктуализироватьВыбранных(Выбранные, ПорогНеактивности, АдресПодтвержденийПаролей);
			ЗначениеВРеквизитФормы(Обработка, "Объект");
			ЗафиксироватьСнимокАудита(Обработка);
			ОбновитьРабочееМестоАудита(, Истина);
			
		Исключение
			Результат.Вставить("ОшибкаОбновления",
				НСтр(
					"ru='Действие выполнено, но обновление аудита не завершено. Обновите общий аудит перед анализом результатов.'"));
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПредложитьРекомендованноеДействие(Код, Выбранные = Неопределено)
	
	Если РекомендацияВыполняется Или ПроверкаПаролейАктивна Или АктивностьВыполняется Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		План = ПредпросмотрРекомендацииНаСервере(Код, Выбранные);
		
		Если План.Изменены.Количество() = 0 Тогда
			
			Если Выбранные <> Неопределено Тогда
				ПоказатьРезультатОперации(План, Истина, Код);
			КонецЕсли;
			
			ОбновитьРекомендацииНаСервере();
			
			Возврат;
			
		КонецЕсли;
		
		Если Выбранные <> Неопределено Тогда
			
			Для Каждого Пропущенный Из План.Пропущены Цикл
				План.Изменены.Добавить(Пропущенный);
			КонецЦикла;
			
		КонецЕсли;
		
		ДанныеПодтверждения = Новый Структура("Код,Разрешенные,ОбщаяРекомендация",
			Код, План.Изменены, Выбранные = Неопределено);
		Текст = НСтр("ru='Действительно'") + " " + НазваниеРекомендованногоДействия(Код) + "?";
		
		Если Код = "ОтключитьСлабые" И ДанныеПодтверждения.ОбщаяРекомендация Тогда
			Текст = Текст + Символы.ПС + СтрШаблон(НСтр("ru='Учётных записей к изменению: %1.'"),
				План.Изменены.Количество());
		КонецЕсли;
		
		Если Код = "БезПароля" Или Код = "ОтключитьСлабые" Тогда
			Текст = Текст + Символы.ПС + Символы.ПС + НСтр(
				"ru='Остальные способы аутентификации сохранятся. Пользователи без других включённых способов входа не смогут войти.'");
		КонецЕсли;
		
		ПоказатьВопрос(Новый ОписаниеОповещения("РекомендацияПодтверждена", ЭтотОбъект, ДанныеПодтверждения),
			Текст, РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Нет);
		
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Функция НазваниеРекомендованногоДействия(Код)
	
	Если Код = "БезПароля" Тогда
		Возврат НСтр("ru='отключить стандартный вход пользователям без пароля'");
	ИначеЕсли Код = "СкрытьВсех" Тогда
		Возврат НСтр("ru='скрыть всех пользователей из списка выбора при входе'");
	ИначеЕсли Код = "ОтключитьСлабые" Тогда
		Возврат НСтр("ru='отключить стандартный вход пользователям со слабым паролем'");
	КонецЕсли;
	
	Возврат НСтр("ru='потребовать новый пароль при следующем входе'");
	
КонецФункции

&НаКлиенте
Процедура РекомендацияПодтверждена(Ответ, ДанныеПодтверждения) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		ОжидающееСообщениеРекомендации = Неопределено;
		КодАктивнойРекомендации = ДанныеПодтверждения.Код;
		РекомендацияВыполняется = Истина;
		ОткрытьОкноХодаОперации(НСтр("ru='Рекомендуемое действие'"),
			НСтр("ru='Отмена - между порциями. Уже выполненные изменения не отменяются.'"));
		Прогресс = НоваяРекомендацияНаСервере(ДанныеПодтверждения.Код, ДанныеПодтверждения.Разрешенные,
			ДанныеПодтверждения.ОбщаяРекомендация);
		АдресРекомендации = Прогресс.Адрес;
		ЗаписатьСтатусРекомендации(КодАктивнойРекомендации, НСтр("ru='Выполняется…'"));
		ОбновитьОкноХодаОперации(Прогресс);
		ПодключитьОбработчикОжидания("ПродолжитьРекомендацию", 0.1, Истина);
		
	Исключение
		ОбработатьСбойРекомендации();
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьРекомендацию()
	
	Если Не РекомендацияВыполняется Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		Прогресс = СледующаяРекомендацияНаСервере(АдресРекомендации);
		ОбработатьПрогрессРекомендации(Прогресс);
		
		Если Не Прогресс.Завершено Тогда
			ПодключитьОбработчикОжидания("ПродолжитьРекомендацию", 0.1, Истина);
		КонецЕсли;
		
	Исключение
		ОбработатьСбойРекомендации();
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьРекомендацию()
	
	ОтключитьОбработчикОжидания("ПродолжитьРекомендацию");
	
	Попытка
		ОбработатьПрогрессРекомендации(ОтмененнаяРекомендацияНаСервере(АдресРекомендации));
	Исключение
		ОбработатьСбойРекомендации();
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьПрогрессРекомендации(Прогресс)
	
	Если Прогресс.Завершено Тогда
		
		АдресРекомендации = "";
		Результат = Прогресс.Результат;
		ОшибкаОбновления = "";
		
		Если Прогресс.Свойство("ОшибкаОбновления", ОшибкаОбновления) Тогда
			Результат.Вставить("ОшибкаОбновления", ОшибкаОбновления);
		КонецЕсли;
		
		Сообщение = СообщениеРезультатаОперации(Результат, Ложь, КодАктивнойРекомендации);
		Отменено = Ложь;
		
		Если Прогресс.Свойство("Отменено", Отменено) И Отменено Тогда
			
			Сообщение.Заголовок = НСтр("ru='Операция отменена'");
			Сообщение.Текст = НСтр("ru='Операция отменена. Уже выполненные изменения сохранены.'")
				+ Символы.ПС + Сообщение.Текст;
			
		КонецЕсли;
		
		ОжидающееСообщениеРекомендации = Сообщение;
		РекомендацияВыполняется = Истина;
		ПередатьСостояниеОкнаХода(НСтр("ru='Обновляем список…'"), 100, "", Ложь, Ложь);
		ПодключитьОбработчикОжидания("ОбновитьАудитПослеРекомендации", 0.1, Истина);
		
		Возврат;
		
	КонецЕсли;
	
	ОбновитьОкноХодаОперации(Прогресс);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьСбойРекомендации()
	
	ОжидающееСообщениеРекомендации = Неопределено;
	РекомендацияВыполняется = Ложь;
	ОтключитьОбработчикОжидания("ПродолжитьРекомендацию");
	ВывестиСообщениеОперации(НСтр("ru='Операция не завершена; возможно частичное выполнение.'") + " "
		+ НСтр("ru='Не повторяйте её вслепую: выполните общий аудит.'") + " "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	ЗаписатьСтатусРекомендации(КодАктивнойРекомендации, НСтр("ru='Не завершено. Проверьте результат общим аудитом.'"));
	ПоказатьПредупреждение(, РезультатДействия);
	ОсвободитьРекомендациюНаСервере(АдресРекомендации);
	АдресРекомендации = "";
	ЗакрытьОкноХодаОперации();
	
КонецПроцедуры

&НаСервере
Функция ПредпросмотрРекомендацииНаСервере(Знач Код, Знач Выбранные = Неопределено)
	
	Результат = РеквизитФормыВЗначение("Объект").ПредпросмотрРекомендации(Код, АдресПодтвержденийПаролей,
		Выбранные = Неопределено);
	
	Если Выбранные = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Ключи = Новый Соответствие;
	
	Для Каждого Выбранная Из Выбранные Цикл
		Ключи.Вставить(НРег(Выбранная.ИдентификаторПользователяИБ), Истина);
	КонецЦикла;
	
	Для Каждого ИмяГруппы Из СтрРазделить("Изменены,Пропущены,Ошибки", ",") Цикл
		
		Исходные = Результат[ИмяГруппы];
		Отобранные = Новый Массив;
		
		Для Каждого СтрокаПлана Из Исходные Цикл
			
			Если Ключи.Получить(НРег(СтрокаПлана.ИдентификаторПользователяИБ)) = Истина Тогда
				Отобранные.Добавить(СтрокаПлана);
			КонецЕсли;
			
		КонецЦикла;
		
		Результат[ИмяГруппы] = Отобранные;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция НоваяРекомендацияНаСервере(Код, Разрешенные, ОбщаяРекомендация)
	
	Возврат РеквизитФормыВЗначение("Объект").НоваяРекомендованнаяОперация(
		Код, Разрешенные, АдресПодтвержденийПаролей, УникальныйИдентификатор, ОбщаяРекомендация);
	
КонецФункции

&НаСервере
Функция СледующаяРекомендацияНаСервере(Адрес)
	
	Обработка = РеквизитФормыВЗначение("Объект");
	Результат = Обработка.СледующаяПорцияРекомендации(Адрес);
	ЗначениеВРеквизитФормы(Обработка, "Объект");
	ЗафиксироватьРезультатАудита(Обработка);
	
	Если Результат.Завершено Тогда
		
		Попытка
			
			Обработка.АктуализироватьРезультатРекомендации(Результат.Результат, ПорогНеактивности,
				АдресПодтвержденийПаролей);
			ЗафиксироватьСнимокАудита(Обработка);
			
		Исключение
			Результат.Вставить("ОшибкаОбновления",
				НСтр(
					"ru='Действие выполнено, но обновление аудита не завершено. Обновите общий аудит перед анализом результатов.'"));
		КонецПопытки;
		
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(Обработка, "Объект");
	
	Если Результат.Завершено Тогда
		ЗафиксироватьРезультатАудита(Обработка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ОтмененнаяРекомендацияНаСервере(Адрес)
	
	Обработка = РеквизитФормыВЗначение("Объект");
	Результат = Обработка.ОтмененнаяРекомендация(Адрес);
	ЗначениеВРеквизитФормы(Обработка, "Объект");
	ЗафиксироватьРезультатАудита(Обработка);
	
	Если Результат.Завершено Тогда
		
		Попытка
			
			Обработка.АктуализироватьРезультатРекомендации(Результат.Результат, ПорогНеактивности,
				АдресПодтвержденийПаролей);
			ЗафиксироватьСнимокАудита(Обработка);
			
		Исключение
			Результат.Вставить("ОшибкаОбновления",
				НСтр(
					"ru='Действие выполнено, но обновление аудита не завершено. Обновите общий аудит перед анализом результатов.'"));
		КонецПопытки;
		
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(Обработка, "Объект");
	
	Если Результат.Завершено Тогда
		ЗафиксироватьРезультатАудита(Обработка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ОсвободитьРекомендациюНаСервере(Адрес)
	
	Если Не ЗначениеЗаполнено(Адрес) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		РеквизитФормыВЗначение("Объект").ОсвободитьРекомендацию(Адрес);
	Исключение
		// Состояние уже завершённой операции удалено; остальное освобождается с формой.
		РекомендацияВыполняется = Ложь;
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура АктуализироватьПослеРекомендацииНаСервере()
	
	Обработка = РеквизитФормыВЗначение("Объект");
	Обработка.АктуализироватьПослеРекомендации(Ложь,
		ПорогНеактивности, АдресПодтвержденийПаролей, 100, 0);
	Обработка.УпорядочитьАудит(ПорядокАудита);
	ЗафиксироватьСнимокАудита(Обработка);
	ЗначениеВРеквизитФормы(Обработка, "Объект");
	ЗаполнитьЗначкиАудита();
	
КонецПроцедуры

#КонецОбласти

#Область НастройкаТребованийПаролей

&НаКлиенте
Процедура ОткрытьНастройкиПаролей()
	
	Если ДоступнаФормаНастроекВходаНаСервере() Тогда
		
		Настройки = НастройкиПаролейНаСервере();
		ПараметрыОкна = Новый Структура("ПоказатьНастройкиВнешнихПользователей", Ложь);
		ФормаНастроек = ОткрытьФорму("ОбщаяФорма.НастройкиВходаПользователей", ПараметрыОкна, ЭтотОбъект, , , ,
			Новый ОписаниеОповещения("НастройкиВходаЗакрыты", ЭтотОбъект),
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		АктуализироватьФлагиЗапретаСлабых(ФормаНастроек, Настройки);
		
		Возврат;
		
	КонецЕсли;
	
	Настройки = НастройкиПаролейНаСервере();
	ПараметрыОкна = Новый Структура("Настройки", Настройки);
	ИдентификаторДиалогаПаролей = Строка(Новый УникальныйИдентификатор);
	ПараметрыОкна.Вставить("ИдентификаторДиалога", ИдентификаторДиалогаПаролей);
	ОткрытьФорму("ВнешняяОбработка.АдминистрированиеИАудитПользователей.Форма.ТребованияПаролей", ПараметрыОкна,
		ЭтотОбъект, ИдентификаторДиалогаПаролей);
	
КонецПроцедуры

&НаКлиенте
Процедура АктуализироватьФлагиЗапретаСлабых(ФормаНастроек, Настройки)
	
	// В отдельных БСП заполнение внешних настроек перезаписывает флаг обычных пользователей.
	// Исправляем только представление: политики обеих групп уже прочитаны на сервере.
	Привязки = Новый Структура;
	Привязки.Вставить("ЗапретСлабыхПользователямБСП", "ПарольДолженОтсутствоватьВСпискеЗапрещенных");
	Привязки.Вставить("ЗапретСлабыхВнешнимБСП", "ПарольДолженОтсутствоватьВСпискеЗапрещенных2");
	
	Для Каждого Привязка Из Привязки Цикл
		
		Значение = Неопределено;
		
		Если Настройки.Свойство(Привязка.Ключ, Значение)
			И ФормаНастроек.Элементы.Найти(Привязка.Значение) <> Неопределено Тогда
			ФормаНастроек[Привязка.Значение] = Значение;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиВходаЗакрыты(Результат, ДополнительныеПараметры) Экспорт
	
	ОбновитьРекомендацииНаСервере();
	
КонецПроцедуры

&НаСервере
Функция ДоступнаФормаНастроекВходаНаСервере()
	
	Возврат РеквизитФормыВЗначение("Объект").ДоступнаФормаНастроекВхода();
	
КонецФункции

&НаКлиенте
Процедура РекомендуемыеНастройкиПодтверждены(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		Результат = УстановитьРекомендуемыеНастройкиНаСервере();
		
		Если Не Результат.Успех Тогда
			ПоказатьПредупреждение(, Результат.Текст);
		КонецЕсли;
		
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Функция УстановитьРекомендуемыеНастройкиНаСервере()
	
	Обработка = РеквизитФормыВЗначение("Объект");
	Результат = Обработка.УстановитьРекомендуемыеНастройкиВхода();
	ЗначениеВРеквизитФормы(Обработка, "Объект");
	ЗафиксироватьРезультатАудита(Обработка);
	ЗаписатьСтатусРекомендации("РезультатУстановкиПравилПаролей", Результат.Текст);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ТребованияПаролейВыбраны(Выбранные, ДополнительныеПараметры)
	
	Пакет = Новый Структура("Идентификатор,Результат,Ошибка", ИдентификаторДиалогаПаролей, Неопределено, "");
	
	Попытка
		
		Пакет.Результат = УстановитьПравилаПаролейНаСервере(Выбранные.Длина, Выбранные.Сложность, Выбранные.Ожидаемые);
		ЗаписатьСтатусРекомендации("ПравилаПаролей", Пакет.Результат.Текст);
		
	Исключение
		Пакет.Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Оповестить("АудитПользователей.РезультатПолитики", Пакет, ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Функция НастройкиПаролейНаСервере()
	
	Возврат РеквизитФормыВЗначение("Объект").ОбщиеПравилаПаролей();
	
КонецФункции

&НаСервере
Функция УстановитьПравилаПаролейНаСервере(Длина, Сложность, Ожидаемые)
	
	Обработка = РеквизитФормыВЗначение("Объект");
	Результат = Обработка.УстановитьПравилаПаролей(Длина, Сложность, Ожидаемые);
	ЗначениеВРеквизитФормы(Обработка, "Объект");
	ЗафиксироватьРезультатАудита(Обработка);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ФайловыйСценарийСнимков

&НаКлиенте
Функция ЕстьИзмененияПослеАудита()
	
	Если КарточкаОткрываласьПослеАудита = Истина Тогда
		Возврат Истина;
	КонецЕсли;
	
	НачалоПротокола = ?(ЗаписейПротоколаПриАудите = Неопределено, 0, ЗаписейПротоколаПриАудите);
	
	Для Индекс = НачалоПротокола По Объект.ПротоколДействий.Количество() - 1 Цикл
		
		Статус = Объект.ПротоколДействий[Индекс].Статус;
		
		Если Статус = "Выполнено" Или Статус = "Ошибка" Тогда
			Возврат Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Процедура СохранениеПослеВопросаОбАудите(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да И Ответ <> КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	Если Не СнимокАудитаДоступен() Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		Если Ответ = КодВозвратаДиалога.Да Тогда
			
			ОбновитьАудитПользователей("Сохранить");
			
			Возврат;
			
		КонецЕсли;
		
		НачатьСохранениеРезультата();
		
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьСохранениеРезультата()
	
	Если Не СнимокАудитаДоступен() Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		ПодготовитьФайлРезультатаНаСервере();
		ФайлСнимка = ФайлСнимкаНаСервере(АдресРезультатаАудита, УникальныйИдентификатор);
		Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
		Диалог.Заголовок = НСтр("ru='Сохранить результат аудита'");
		Диалог.Фильтр = НСтр("ru='Результат аудита (*.html)|*.html'");
		Диалог.ПолноеИмяФайла = ФайлСнимка.Имя;
		Диалог.Показать(Новый ОписаниеОповещения("СнимокПослеВыбораСохранения", ЭтотОбъект, ФайлСнимка.Адрес));
		
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Функция СнимокАудитаДоступен()
	
	Если Не ОбщийАудитВыполнен Тогда
		
		ПоказатьПредупреждение(, НСтр("ru='Сначала выполните «Общий аудит».'"));
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Если ПроверкаПаролейАктивна Или АктивностьВыполняется Или РекомендацияВыполняется Тогда
		
		ПоказатьПредупреждение(, НСтр("ru='Дождитесь завершения текущей операции.'"));
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Если Не ПустаяСтрока(ПричинаНедоступностиСнимка) Тогда
		
		ПоказатьПредупреждение(, НСтр("ru='Сохранение результата недоступно.'") + " " + ПричинаНедоступностиСнимка
			+ " " + НСтр("ru='Повторите общий аудит.'"));
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура СнимокПослеВыбораСохранения(ВыбранныеФайлы, Адрес) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Или ВыбранныеФайлы.Количество() = 0 Тогда
		
		УдалитьДанныеОтчетаНаСервере(Адрес);
		
		Возврат;
		
	КонецЕсли;
	
	Попытка
		
		Оповещение = Новый ОписаниеОповещения("СнимокПослеСохранения", ЭтотОбъект, Адрес);
		
		Если ПолучениеФайлаССервераДоступно() Тогда
			Выполнить("НачатьПолучениеФайлаССервера(Оповещение, Адрес, ВыбранныеФайлы[0]);");
		Иначе
			
			Файлы = Новый Массив;
			Файлы.Добавить(Новый ОписаниеПередаваемогоФайла(ВыбранныеФайлы[0], Адрес));
			НачатьПолучениеФайлов(Оповещение, Файлы, "", Ложь);
			
		КонецЕсли;
		
	Исключение
		
		УдалитьДанныеОтчетаНаСервере(Адрес);
		ПоказатьПредупреждение(,
			НСтр("ru='Не удалось сохранить файл снимка. Проверьте доступность выбранного каталога.'"));
		
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура СнимокПослеСохранения(Результат, Адрес) Экспорт
	
	УдалитьДанныеОтчетаНаСервере(Адрес);
	
КонецПроцедуры

&НаКлиенте
Процедура СнимокПослеВыбораСравнения(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Или ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		ВыбранныйФайл = Новый Файл(ВыбранныеФайлы[0]);
		
		Если ВыбранныйФайл.Размер() > 67108864 Тогда
			ВызватьИсключение НСтр("ru='Размер результата аудита не должен превышать 64 МиБ.'");
		КонецЕсли;
		
		Оповещение = Новый ОписаниеОповещения("СнимокПослеЗагрузки", ЭтотОбъект);
		НачатьПомещениеФайла(Оповещение, , ВыбранныеФайлы[0], Ложь, УникальныйИдентификатор);
		
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура СнимокПослеЗагрузки(Результат, Адрес, ИмяФайла, ДополнительныеПараметры) Экспорт
	
	Если Не Результат Тогда
		Возврат;
	КонецЕсли;
	
	ЗагруженныйСнимокСравнения = Адрес;
	АдресМаршрутаОпераций = МаршрутОперацииНаСервере();
	ОткрытьОкноХодаОперации(НСтр("ru='Сравнение результатов аудита'"), "");
	ПоказатьОжиданиеОкнаХода(НСтр("ru='Проверка файла и сравнение с текущим результатом аудита…'"));
	ПодключитьОбработчикОжидания("ПродолжитьСравнениеСнимка", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьСравнениеСнимка()
	
	Попытка
		
		ПодготовитьСнимокАудитаНаСервере();
		АдресПакета = ПакетСравненияСнимкаНаСервере(ЗагруженныйСнимокСравнения, АдресСнимкаАудита,
			АдресМаршрутаОпераций, УникальныйИдентификатор);
		ЗагруженныйСнимокСравнения = "";
		ЗакрытьОкноХодаОперации();
		ПараметрыСравнения = Новый Структура("АдресПакета", АдресПакета);
		ЧастиИмениФормы = СтрРазделить(ИмяФормы, ".");
		ПолноеИмяСравнения = ЧастиИмениФормы[0] + "." + ЧастиИмениФормы[1] + ".Форма.БылоСтало";
		ОткрытьФорму(ПолноеИмяСравнения, ПараметрыСравнения, ЭтотОбъект, Новый УникальныйИдентификатор);
		
	Исключение
		
		ЗагруженныйСнимокСравнения = "";
		ЗакрытьОкноХодаОперации();
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура СброситьСнимокАудита()
	
	Если Не ПустаяСтрока(АдресСнимкаАудита) Тогда
		УдалитьИзВременногоХранилища(АдресСнимкаАудита);
	КонецЕсли;
	
	Если Не ПустаяСтрока(АдресРезультатаАудита) Тогда
		УдалитьИзВременногоХранилища(АдресРезультатаАудита);
	КонецЕсли;
	
	Если Не ПустаяСтрока(АдресКонтекстаФайлаАудита) Тогда
		УдалитьИзВременногоХранилища(АдресКонтекстаФайлаАудита);
	КонецЕсли;
	
	АдресКонтекстаФайлаАудита = "";
	АдресРезультатаАудита = "";
	АдресСнимкаАудита = "";
	ПричинаНедоступностиСнимка = НСтр("ru='Обновите общий аудит.'");
	
КонецПроцедуры

&НаСервере
Процедура ЗафиксироватьСнимокАудита(Обработка)
	
	СтарыйСнимок = АдресСнимкаАудита;
	СтарыйКонтекст = АдресКонтекстаФайлаАудита;
	АдресСнимкаАудита = "";
	АдресКонтекстаФайлаАудита = "";
	ПричинаНедоступностиСнимка = "";
	ЗафиксироватьРезультатАудита(Обработка);
	
	Попытка
		
		Если Не ПустаяСтрока(СтарыйСнимок) Тогда
			УдалитьИзВременногоХранилища(СтарыйСнимок);
		КонецЕсли;
		
		Если Не ПустаяСтрока(СтарыйКонтекст) Тогда
			УдалитьИзВременногоХранилища(СтарыйКонтекст);
		КонецЕсли;
		
		Контекст = Обработка.КонтекстСнимкаРассчитанногоАудита();
		АдресКонтекстаФайлаАудита = ПоместитьВоВременноеХранилище(Контекст, УникальныйИдентификатор);
		
	Исключение
		// Ошибка служебного кеша не скрывает уже выполненное действие и его протокол.
		ПричинаНедоступностиСнимка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ЗафиксироватьРезультатАудита(Обработка)
	
	Если Не ПустаяСтрока(АдресРезультатаАудита) Тогда
		УдалитьИзВременногоХранилища(АдресРезультатаАудита);
	КонецЕсли;
	
	АдресРезультатаАудита = "";
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ФайлСнимкаНаСервере(АдресГотовогоРезультата, ИдентификаторФормы)
	
	Если ПустаяСтрока(АдресГотовогоРезультата) Тогда
		ВызватьИсключение НСтр("ru='Результат не подготовлен. Выполните общий аудит повторно.'");
	КонецЕсли;
	
	ФайлРезультата = ПолучитьИзВременногоХранилища(АдресГотовогоРезультата);
	
	Если ТипЗнч(ФайлРезультата) <> Тип("Структура") Тогда
		ВызватьИсключение НСтр("ru='Временный результат недоступен. Выполните общий аудит повторно.'");
	КонецЕсли;
	
	// Отдельный адрес загрузки можно удалить после получения/отмены; готовый файл остаётся для повторного сохранения.
	АдресЗагрузки = ПоместитьВоВременноеХранилище(ФайлРезультата.Данные, ИдентификаторФормы);
	Возврат Новый Структура("Адрес,Имя", АдресЗагрузки, ФайлРезультата.Имя);
	
КонецФункции

&НаСервереБезКонтекста
Функция ПакетСравненияСнимкаНаСервере(Адрес, АдресТекущегоСнимка, АдресМаршрута, ИдентификаторФормы)
	
	Данные = ПолучитьИзВременногоХранилища(Адрес);
	УдалитьИзВременногоХранилища(Адрес);
	
	Если ТипЗнч(Данные) <> Тип("ДвоичныеДанные") Тогда
		ВызватьИсключение НСтр("ru='Файл снимка не получен.'");
	КонецЕсли;
	
	Если Данные.Размер() > 67108864 Тогда
		ВызватьИсключение НСтр("ru='Размер результата аудита не должен превышать 64 МиБ.'");
	КонецЕсли;
	
	СтарыйJSON = ПолучитьСтрокуИзДвоичныхДанных(Данные, КодировкаТекста.UTF8);
	ТекущийJSON = ПолучитьИзВременногоХранилища(АдресТекущегоСнимка);
	Обработка = ФасадОперацииБезКонтекста(АдресМаршрута);
	Пакет = Обработка.ПакетСравненияФайлов(СтарыйJSON, ТекущийJSON);
	
	Возврат ПоместитьВоВременноеХранилище(Пакет, ИдентификаторФормы);
	
КонецФункции

#КонецОбласти

&НаСервере
Процедура ПодготовитьРезультатАудита(Обработка)
	
	СтарыйАдрес = АдресРезультатаАудита;
	АдресРезультатаАудита = "";
	
	Если Не ПустаяСтрока(АдресСнимкаАудита) Тогда
		
		Попытка
			
			Текст = ПолучитьИзВременногоХранилища(АдресСнимкаАудита);
			СтатистикаАктивности = Неопределено;
			
			Если ЗначениеЗаполнено(АдресСводкиАктивности) Тогда
				СтатистикаАктивности = ПолучитьИзВременногоХранилища(АдресСводкиАктивности);
			КонецЕсли;
			
			Пакет = Обработка.ПакетФайлаРезультатаАудита(Текст, СтатистикаАктивности);
			HTML = Пакет.HTML;
			ИмяФайла = Пакет.Имя;
			Данные = ПолучитьДвоичныеДанныеИзСтроки(HTML, КодировкаТекста.UTF8);
			ГотовыйФайл = Новый Структура("Имя,Данные", ИмяФайла, Данные);
			АдресРезультатаАудита = ПоместитьВоВременноеХранилище(ГотовыйФайл, УникальныйИдентификатор);
			
		Исключение
			ПричинаНедоступностиСнимка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		
	КонецЕсли;
	
	Если Не ПустаяСтрока(СтарыйАдрес) Тогда
		УдалитьИзВременногоХранилища(СтарыйАдрес);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФайлРезультатаНаСервере()
	
	ПодготовитьСнимокАудитаНаСервере();
	
	Если ПустаяСтрока(АдресРезультатаАудита) Тогда
		ПодготовитьРезультатАудита(РеквизитФормыВЗначение("Объект"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ВыбранныеПользователиСписка()
	
	ВыбранныеУчетки = Новый Массив;
	
	Для Каждого Ссылка Из Элементы.СписокПользователей.ВыделенныеСтроки Цикл
		
		Если ЗначениеЗаполнено(Ссылка) И ВыбранныеУчетки.Найти(Ссылка) = Неопределено Тогда
			ВыбранныеУчетки.Добавить(Ссылка);
		КонецЕсли;
		
	КонецЦикла;
	
	Если ВыбранныеУчетки.Количество() = 0 Тогда
		ВыбранныеУчетки.Добавить(ВыбранныйПользовательСписка());
	КонецЕсли;
	
	Возврат ВыбранныеУчетки;
	
КонецФункции

&НаСервере
Функция ДействиеНадПользователямиНаСервере(Пользователи, Код, Параметр = Неопределено)
	
	Обработка = РеквизитФормыВЗначение("Объект");
	Результат = Обработка.ДействиеНадПользователями(Пользователи, Код, Параметр, ПолныйМеханизмПользователейБСП());
	ЗначениеВРеквизитФормы(Обработка, "Объект");
	ЗафиксироватьРезультатАудита(Обработка);
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ПоказатьПроекциюДействий()
	
	Если Не ЗначениеЗаполнено(АдресКешаДействий) Тогда
		Возврат;
	КонецЕсли;
	
	Обработка = РеквизитФормыВЗначение("Объект");
	Статистика = Обработка.ПроекцияДействий(АдресКешаДействий, ДействияПользователяПериод,
		ИдентификаторПользователяДействий, УникальныйИдентификатор);
	
	Если Статистика = Неопределено Тогда
		
		Если ЗначениеЗаполнено(АдресГрафикаДействий) Тогда
			
			УдалитьИзВременногоХранилища(АдресГрафикаДействий);
			АдресГрафикаДействий = "";
			
		КонецЕсли;
		
		HTMLДействийПользователя
			= ("<html><body style='font:14px Arial;padding:20px'>"
				+ HTMLТекст(НСтр(
				"ru='Для выбранного пользователя или периода ещё не все дни рассчитаны. Нажмите «Рассчитать»: будут прочитаны только недостающие дни и текущий день.'")) + "</body></html>");
		
		Возврат;
		
	КонецЕсли;
	
	РабочиеДниДействийДоступны = Статистика.РабочиеДаты <> Неопределено;
	АдресГрафикаДействий = ЗамененныйАдресГрафика(АдресГрафикаДействий, Статистика);
	ПерерисоватьГрафикДействий();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьHTMLКатегорий()
	
	HTMLКатегории = РеквизитФормыВЗначение("Объект").HTMLКатегорий(
		РеквизитФормыВЗначение("КатегорииПроблем"), КатегорияАудита);
	
КонецПроцедуры

&НаСервере
Процедура СортироватьПодробныйСписокНаСервере(Знач ИмяПоля, Знач ПоУбыванию, Выбранные)
	
	Поле = Элементы.Найти(ИмяПоля);
	
	Если Поле = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Путь = Поле.ПутьКДанным;
	
	Если Не СтрНачинаетсяС(Путь, "РабочийСписок.") Тогда
		Возврат;
	КонецЕсли;
	
	Колонка = Сред(Путь, СтрДлина("РабочийСписок.") + 1);
	Таблица = РеквизитФормыВЗначение("РабочийСписок");
	
	Если Таблица.Колонки.Найти(Колонка) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СброситьКонтекстныйПорядок();
	
	Если Колонка = "ПрочаяАктивность" Тогда
		
		ПорядокАудита = ?(ПоУбыванию, 5, 6);
		
	Иначе
		
		ПорядокАудита = 0;
		ПолеПорядкаПодробногоСписка = ?(Колонка = "ПоследнийВходВДнях", "ДнейПослеАктивности", Колонка);
		НаправлениеПорядкаПодробногоСписка = ?(ПоУбыванию, "Убыв", "Возр");
		КолонкаПодробногоПорядка = ИмяПоля;
		ЗаголовокКолонкиПодробногоПорядка = Поле.Заголовок;
		Поле.Заголовок = ЗаголовокКолонкиПодробногоПорядка + ?(ПоУбыванию, " ▼", " ▲");
		
	КонецЕсли;
	
	ОбновитьРабочееМестоАудита(Выбранные);
	
КонецПроцедуры

&НаСервере
Процедура СброситьКонтекстныйПорядок()
	
	Если Не ПустаяСтрока(КолонкаПодробногоПорядка) Тогда
		Элементы[КолонкаПодробногоПорядка].Заголовок = ЗаголовокКолонкиПодробногоПорядка;
	КонецЕсли;
	
	КолонкаПодробногоПорядка = "";
	ЗаголовокКолонкиПодробногоПорядка = "";
	ПолеПорядкаПодробногоСписка = "";
	НаправлениеПорядкаПодробногоСписка = "";
	
КонецПроцедуры

&НаСервере
Функция ТабличныйДокументСпискаНаСервере()
	
	Документ = Новый ТабличныйДокумент;
	НомерКолонки = 0;
	Таблица = РеквизитФормыВЗначение("РабочийСписок");
	
	Для Каждого Элемент Из Элементы Цикл
		
		Если ТипЗнч(Элемент) <> Тип("ПолеФормы") Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ВидимаКолонкаСписка(Элемент) Или Не СтрНачинаетсяС(Элемент.ПутьКДанным, "РабочийСписок.") Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяПоля = Сред(Элемент.ПутьКДанным, СтрДлина("РабочийСписок.") + 1);
		
		Если Таблица.Колонки.Найти(ИмяПоля) = Неопределено Или Элемент.Вид = ВидПоляФормы.ПолеКартинки Тогда
			Продолжить;
		КонецЕсли;
		
		НомерКолонки = НомерКолонки + 1;
		Документ.Область(1, НомерКолонки).Текст = Элемент.Заголовок;
		Документ.Область(1, НомерКолонки).ЦветФона = Новый Цвет(230, 237, 245);
		НомерСтроки = 1;
		
		Для Каждого СтрокаСписка Из Таблица Цикл
			
			НомерСтроки = НомерСтроки + 1;
			Документ.Область(НомерСтроки, НомерКолонки).Текст = Строка(СтрокаСписка[ИмяПоля]);
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Документ;
	
КонецФункции

&НаСервере
Функция ВидимаКолонкаСписка(Элемент)
	
	Текущий = Элемент;
	
	Пока ТипЗнч(Текущий) = Тип("ПолеФормы") Или ТипЗнч(Текущий) = Тип("ГруппаФормы")
		Или ТипЗнч(Текущий) = Тип("ТаблицаФормы") Цикл
		
		Если Не Текущий.Видимость Тогда
			Возврат Ложь;
		КонецЕсли;
		
		Текущий = Текущий.Родитель;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Процедура ПодготовитьСнимокАудитаНаСервере()
	
	Если Не ПустаяСтрока(АдресСнимкаАудита) Тогда
		Возврат;
	КонецЕсли;
	
	Контекст = ПолучитьИзВременногоХранилища(АдресКонтекстаФайлаАудита);
	
	Если ТипЗнч(Контекст) <> Тип("Структура") Тогда
		ВызватьИсключение НСтр("ru='Описание результата аудита недоступно. Выполните общий аудит повторно.'");
	КонецЕсли;
	
	Текст = РеквизитФормыВЗначение("Объект").ФайлСнимкаРассчитанногоАудита(Контекст);
	АдресСнимкаАудита = ПоместитьВоВременноеХранилище(Текст, УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Функция ПодписиДействияПользователя(Код)
	
	Если Код = "СменаВыбранным" Или Код = "ПустойСмена" Или Код = "СлабыйСмена" Или Код = "СменитьСлабые" Тогда
		
		Одному = НСтр("ru='Потребовать смену пароля при следующем входе для пользователя «%1»?'");
		Нескольким = НСтр("ru='Потребовать смену пароля при следующем входе для выбранных пользователей (%1)?'");
		ИтогОдному = НСтр("ru='Для пользователя «%1» потребован новый пароль при следующем входе.'");
		ИтогНескольким = НСтр("ru='Потребован новый пароль при следующем входе для пользователей: %1.'");
		
	ИначеЕсли Код = "БезПароля" Или Код = "ОтключитьСлабые" Тогда
		
		Одному = НСтр("ru='Отключить стандартный вход пользователя «%1»?'");
		Нескольким = НСтр("ru='Отключить стандартный вход выбранных пользователей (%1)?'");
		ИтогОдному = НСтр("ru='Отключён стандартный вход пользователя «%1».'");
		ИтогНескольким = НСтр("ru='Отключён стандартный вход пользователей: %1.'");
		
	ИначеЕсли Код = "СкрытьВсех" Тогда
		
		Одному = НСтр("ru='Скрыть пользователя «%1» из списка выбора при входе?'");
		Нескольким = НСтр("ru='Скрыть выбранных пользователей из списка выбора при входе (%1)?'");
		ИтогОдному = НСтр("ru='Пользователь «%1» скрыт из списка выбора при входе.'");
		ИтогНескольким = НСтр("ru='Скрыты из списка выбора при входе пользователи: %1.'");
		
	ИначеЕсли Код = "РолиБлок" Тогда
		
		Одному = НСтр("ru='Заблокировать вход пользователя «%1»?'");
		Нескольким = НСтр("ru='Заблокировать вход выбранных пользователей (%1)?'");
		ИтогОдному = НСтр("ru='Заблокирован вход пользователя «%1».'");
		ИтогНескольким = НСтр("ru='Заблокирован вход пользователей: %1.'");
		
	ИначеЕсли Код = "РолиНедействителен" Или Код = "ЗапрещенНедействителен"
		Или Код = "СвязиНедействителен" Тогда
		
		Одному = НСтр("ru='Сделать недействительным пользователя «%1»?'");
		Нескольким = НСтр("ru='Сделать недействительными выбранных пользователей (%1)?'");
		ИтогОдному = НСтр("ru='Сделан недействительным пользователь «%1».'");
		ИтогНескольким = НСтр("ru='Сделаны недействительными пользователи: %1.'");
		
	ИначеЕсли Код = "Блокировать" Или Код = "Неактивные" Или Код = "НеактивныеВыбранные" Тогда
		
		Одному = НСтр("ru='Заблокировать и сделать недействительным пользователя «%1»?'");
		Нескольким = НСтр("ru='Заблокировать и сделать недействительными выбранных пользователей (%1)?'");
		ИтогОдному = НСтр("ru='Заблокирован и сделан недействительным пользователь «%1».'");
		ИтогНескольким = НСтр("ru='Заблокированы и сделаны недействительными пользователи: %1.'");
		
	ИначеЕсли Код = "ДобавитьВГруппу" Тогда
		
		Одному = НСтр("ru='Включить пользователя «%1» в группу?'");
		Нескольким = НСтр("ru='Включить выбранных пользователей в группу (%1)?'");
		ИтогОдному = НСтр("ru='Пользователь «%1» включён в группу.'");
		ИтогНескольким = НСтр("ru='Включены в группу пользователи: %1.'");
		
	ИначеЕсли Код = "Копировать" Тогда
		
		Одному = НСтр("ru='Скопировать права пользователю «%1»?'");
		Нескольким = НСтр("ru='Скопировать права выбранным пользователям (%1)?'");
		ИтогОдному = НСтр("ru='Права скопированы пользователю «%1».'");
		ИтогНескольким = НСтр("ru='Скопированы права пользователям: %1.'");
		
	Иначе
		
		Одному = НСтр("ru='Выполнить действие для пользователя «%1»?'");
		Нескольким = НСтр("ru='Выполнить действие для выбранных пользователей (%1)?'");
		ИтогОдному = НСтр("ru='Действие выполнено для пользователя «%1».'");
		ИтогНескольким = НСтр("ru='Действие выполнено для пользователей: %1.'");
		
	КонецЕсли;
	
	Подписи = Новый Структура;
	Подписи.Вставить("ВопросОдному", Одному);
	Подписи.Вставить("ВопросНескольким", Нескольким);
	Подписи.Вставить("ИтогОдному", ИтогОдному);
	Подписи.Вставить("ИтогНескольким", ИтогНескольким);
	
	Возврат Подписи;
	
КонецФункции

&НаКлиенте
Функция ВопросПоДействию(Код, Количество, Имя)
	
	Подписи = ПодписиДействияПользователя(Код);
	
	Возврат ?(Количество = 1, СтрШаблон(Подписи.ВопросОдному, Имя), СтрШаблон(Подписи.ВопросНескольким, Количество));
	
КонецФункции

&НаКлиенте
Функция СообщениеРезультатаОперации(Результат, Предпросмотр, Код)
	
	Выполнено = Результат.Изменены.Количество();
	Пропущено = Результат.Пропущены.Количество();
	Ошибок = Результат.Ошибки.Количество();
	Текст = "";
	
	Если Не Предпросмотр И Выполнено > 0 Тогда
		
		Подписи = ПодписиДействияПользователя(Код);
		Текст = ?(Выполнено = 1, СтрШаблон(Подписи.ИтогОдному, Результат.Изменены[0].Пользователь),
			СтрШаблон(Подписи.ИтогНескольким, Выполнено));
		
	КонецЕсли;
	
	ЗаголовокСообщения = ?(Выполнено > 0, НСтр("ru='Успешно выполнено'"), НСтр("ru='Нет изменений'"));
	
	Если Предпросмотр Или Ошибок > 0 Или Пропущено > 0 Тогда
		
		ЗаголовокСообщения = ?(Предпросмотр, НСтр("ru='Некоторые пользователи будут пропущены'"), ?(Выполнено > 0,
			НСтр("ru='Выполнено частично'"), НСтр("ru='Не выполнено'")));
		
		Если Не ПустаяСтрока(Текст) Тогда
			Текст = Текст + Символы.ПС;
		КонецЕсли;
		
		Текст = Текст + СтрШаблон(НСтр("ru='Пропущено: %1; ошибок: %2.'"), Пропущено, Ошибок);
		Показано = 0;
		
		Для Каждого ИмяНабора Из СтрРазделить("Пропущены,Ошибки", ",") Цикл
			
			Для Каждого Детали Из Результат[ИмяНабора] Цикл
				
				Если Показано = 3 Тогда
					Прервать;
				КонецЕсли;
				
				Текст = Текст + Символы.ПС + Детали.Пользователь + ": " + Детали.Причина;
				Показано = Показано + 1;
				
			КонецЦикла;
			
		КонецЦикла;
		
		Если Ошибок + Пропущено > Показано Тогда
			Текст = Текст + Символы.ПС + НСтр("ru='Остальные подробности сохранены в протоколе действий.'");
		КонецЕсли;
		
	КонецЕсли;
	
	ОшибкаОбновления = "";
	
	Если Результат.Свойство("ОшибкаОбновления", ОшибкаОбновления) Тогда
		
		ЗаголовокСообщения = НСтр("ru='Действие выполнено, список не обновлён'");
		Текст = Текст + Символы.ПС + ОшибкаОбновления;
		
	КонецЕсли;
	
	Если ПустаяСтрока(Текст) Тогда
		Текст = НСтр("ru='Изменения не потребовались.'");
	КонецЕсли;
	
	Возврат Новый Структура("Заголовок,Текст", ЗаголовокСообщения, Текст);
	
КонецФункции

&НаКлиенте
Процедура ПоказатьРезультатОперации(Результат, Предпросмотр, Код = "")
	
	Сообщение = СообщениеРезультатаОперации(Результат, Предпросмотр, Код);
	ПоказатьПредупреждение(, Сообщение.Текст, , Сообщение.Заголовок);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьИзмененныеПараметрыАктивности()
	
	Если ПараметрыРезультатаАктивности = Неопределено Или ИсходныйHTMLАктивности = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РассчитанныеПараметры = ПараметрыРезультатаАктивности;
	ТребуетсяРасчет = НачалоДня(АктивностьПериод.ДатаНачала) <> НачалоДня(РассчитанныеПараметры.Начало)
		Или НачалоДня(АктивностьПериод.ДатаОкончания) <> НачалоДня(РассчитанныеПараметры.Окончание)
		Или ИдентификаторПользователяАктивности <> РассчитанныеПараметры.Пользователь
		Или (ЗначениеЗаполнено(АктивностьПользователь) И АктивностьПользователь <> "Все пользователи"
			И Не ЗначениеЗаполнено(ИдентификаторПользователяАктивности));
	HTMLАктивности = HTMLОжиданияРасчетаАктивности(ИсходныйHTMLАктивности, ТребуетсяРасчет);
	
КонецПроцедуры

&НаКлиенте
Функция HTMLОжиданияРасчетаАктивности(HTML, ТребуетсяРасчет)
	
	Если Не ТребуетсяРасчет Тогда
		Возврат HTML;
	КонецЕсли;
	
	Начало = ("<body><div style='position:fixed;top:0;left:0;right:0;z-index:10;"
		+ "background:#fff4cd;border-bottom:1px solid #d7b34a;padding:14px;font:14px Arial;" + "color:#594500'>")
		+ (НСтр("ru='Параметры изменены. Нажмите <b>«Рассчитать»</b>, чтобы обновить данные.'") + "</div>")
		+ "<div style='opacity:0.35;filter:alpha(opacity=35)'>";
	Результат = СтрЗаменить(HTML, "<body>", Начало);
	
	Возврат СтрЗаменить(Результат, "</body>", "</div></body>");
	
КонецФункции

#Область ОформлениеHTML

// Экранирует локализованные подписи при вставке в HTML формы.
//
// Параметры:
//  Текст - Строка - отображаемая подпись.
//
// Возвращаемое значение:
//  Строка - безопасное содержимое текста или заключённого в кавычки HTML-атрибута.
&НаКлиентеНаСервереБезКонтекста
Функция HTMLТекст(Текст)
	
	Текст = СтрЗаменить(Строка(Текст), "&", "&amp;");
	Текст = СтрЗаменить(Текст, "<", "&lt;");
	Текст = СтрЗаменить(Текст, ">", "&gt;");
	Текст = СтрЗаменить(Текст, """", "&quot;");
	
	Возврат СтрЗаменить(Текст, "'", "&#39;");
	
КонецФункции

&НаКлиенте
Процедура ОбновитьТемуHTML()
	
	Если ГотовыеПоляHTML = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ИспользуетсяТемаHTML() Тогда
		Возврат;
	КонецЕсли;
	
	Фон = ЦветСтиляДляHTML(ЦветТемыHTML("base"));
	
	Если Фон = ФонТекущейТемыHTML Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ИмяПоля Из ГотовыеПоляHTML Цикл
		ПрименитьТемуHTML(Элементы[ИмяПоля.Ключ]);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьРазмерыДляКлиента()
	
	Воздушный = ИспользуетсяТемаHTML();
	СведенияПлатформы = Новый СистемнаяИнформация;
	ВерсияКлиента = СведенияПлатформы.ВерсияПриложения;
	
	Если Не Воздушный И Не СтрНачинаетсяС(ВерсияКлиента, "8.3.10.") Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ИмяПоля Из СтрРазделить("АктивностьПериод,ДействияПользователяПериод", ",") Цикл
		
		ПолеПериода = Элементы[ИмяПоля];
		ПолеПериода.МаксимальнаяШирина = 23;
		ПолеПериода.Ширина = 23;
		
	КонецЦикла;
	
	Если Воздушный Тогда
		
		Элементы.КодРазрешения.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Лево;
		Элементы.ФормаПерейтиНаСтраницуАвтора.Ширина = 12;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ЦветТемыHTML(ИмяЦвета)
	
	// Привязка к системным цветам задана в XML: глобальный набор ЦветаСтиля есть не во всех конфигурациях.
	Возврат Элементы["ЦветHTML" + ИмяЦвета].ЦветФона;
	
КонецФункции

&НаКлиенте
Функция ИспользуетсяТемаHTML()
	
	СведенияПлатформы = Новый СистемнаяИнформация;
	НомерВерсии = СтрРазделить(СведенияПлатформы.ВерсияПриложения, ".");
	
	Если Число(НомерВерсии[0]) < 8 Или (Число(НомерВерсии[0]) = 8 И Число(НомерВерсии[1]) < 5) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Вариант = КлиентскоеПриложение.ТекущийВариантИнтерфейса();
	
	Возврат Вариант <> ВариантИнтерфейсаКлиентскогоПриложения.Такси
		И Вариант <> ВариантИнтерфейсаКлиентскогоПриложения.Версия8_2;
	
КонецФункции

// Служебный клиентский интерфейс для HTML собственных форм обработки.
//
// Параметры:
//  ПолеHTML - ПолеФормы - поле с уже сформированным документом.
&НаКлиенте
Процедура ПрименитьТемуHTML(ПолеHTML) Экспорт
	
	Если Не ИспользуетсяТемаHTML() Тогда
		Возврат;
	КонецЕсли;
	
	Если ГотовыеПоляHTML = Неопределено Тогда
		ГотовыеПоляHTML = Новый Соответствие;
	КонецЕсли;
	
	Если Элементы.Найти(ПолеHTML.Имя) <> Неопределено Тогда
		ГотовыеПоляHTML.Вставить(ПолеHTML.Имя, Истина);
	КонецЕсли;
	
	ДокументHTML = ПолеHTML.Документ;
	
	Если ДокументHTML = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Фон = ЦветСтиляДляHTML(ЦветТемыHTML("base"));
	
	Если Фон <> ФонТекущейТемыHTML Или СтильТекущейТемыHTML = Неопределено Тогда
		
		СтильТекущейТемыHTML = СтильТемыДляHTML();
		ФонТекущейТемыHTML = Фон;
		
	КонецЕсли;
	
	СтильДокумента = ДокументHTML.getElementById("user-admin-application-theme");
	
	Если СтильДокумента = Неопределено Тогда
		
		СтильДокумента = ДокументHTML.createElement("style");
		СтильДокумента.id = "user-admin-application-theme";
		ДокументHTML.head.appendChild(СтильДокумента);
		
	КонецЕсли;
	
	СтильДокумента.innerHTML = СтильТекущейТемыHTML;
	ДокументHTML.documentElement.setAttribute("data-ua-view", ПолеHTML.Имя);
	
КонецПроцедуры

&НаКлиенте
Функция ЦветСтиляДляHTML(ЦветСтиля)
	
	ЦветRGB = ЦветСтиля.ПолучитьАбсолютный();
	
	Возврат "rgb(" + Формат(ЦветRGB.Красный, "ЧГ=0") + "," + Формат(ЦветRGB.Зеленый, "ЧГ=0")
		+ "," + Формат(ЦветRGB.Синий, "ЧГ=0") + ")";
	
КонецФункции

&НаКлиенте
Функция СтильТемыДляHTML()
	
	ФонRGB = ЦветТемыHTML("base").ПолучитьАбсолютный();
	ТекстRGB = ЦветТемыHTML("text").ПолучитьАбсолютный();
	Темная = ФонRGB.Красный + ФонRGB.Зеленый + ФонRGB.Синий < ТекстRGB.Красный + ТекстRGB.Зеленый + ТекстRGB.Синий;
	Палитра = Новый Структура;
	Палитра.Вставить("base", ЦветСтиляДляHTML(ЦветТемыHTML("base")));
	Палитра.Вставить("text", ЦветСтиляДляHTML(ЦветТемыHTML("text")));
	Палитра.Вставить("head", ЦветСтиляДляHTML(ЦветТемыHTML("head")));
	Палитра.Вставить("headtext", ЦветСтиляДляHTML(ЦветТемыHTML("headtext")));
	Палитра.Вставить("border", ЦветСтиляДляHTML(ЦветТемыHTML("border")));
	Палитра.Вставить("field", ЦветСтиляДляHTML(ЦветТемыHTML("field")));
	Палитра.Вставить("fieldtext", ЦветСтиляДляHTML(ЦветТемыHTML("fieldtext")));
	Палитра.Вставить("selection", ЦветСтиляДляHTML(ЦветТемыHTML("selection")));
	Палитра.Вставить("selectiontext", ЦветСтиляДляHTML(ЦветТемыHTML("selectiontext")));
	Палитра.Вставить("tooltip", ЦветСтиляДляHTML(ЦветТемыHTML("tooltip")));
	Палитра.Вставить("tooltiptext", ЦветСтиляДляHTML(ЦветТемыHTML("tooltiptext")));
	Палитра.Вставить("link", ?(Темная, "#83b9ff", "#1759ae"));
	Палитра.Вставить("muted", ?(Темная, "#abb0bc", "#64748b"));
	Палитра.Вставить("danger", ?(Темная, "#ff8585", "#b52c3a"));
	Палитра.Вставить("warning", ?(Темная, "#f2bf53", "#b66a00"));
	Палитра.Вставить("notice", ?(Темная, "#393222", "#fff7dd"));
	Палитра.Вставить("hover", ?(Темная, "#293340", "#eef4fb"));
	ПеременныеCSS = "";
	
	Для Каждого ЦветПалитры Из Палитра Цикл
		ПеременныеCSS = ПеременныеCSS + "--ua-" + ЦветПалитры.Ключ + ":" + ЦветПалитры.Значение + ";";
	КонецЦикла;
	
	Возврат ":root{" + ПеременныеCSS + "color-scheme:" + ?(Темная, "dark", "light") + ";}"
		+ "html,body{background-color:var(--ua-base)!important;color:var(--ua-text)!important}"
		+ "th{background-color:var(--ua-head)!important;color:var(--ua-headtext)!important}"
		+ "td,th,.row,.select,.other-issues{border-color:var(--ua-border)!important}"
		+ "a{color:var(--ua-link)!important}th a,html[data-ua-view=HTMLКатегории] a{color:inherit!important}"
		+ "small,.muted,.inactive,.empty,.other-issues,.help{color:var(--ua-muted)!important}"
		+ ".critical,.red{color:var(--ua-danger)!important}.warn,.yellow{color:var(--ua-warning)!important}"
		+ (".blue{color:var(--ua-link)!important}tr:hover,"
			+ ".select:hover{background-color:var(--ua-hover)!important}")
		+ ("tr.active,tr.active a{background-color:var(--ua-selection)!important;"
			+ "color:var(--ua-selectiontext)!important}")
		+ (".issue-tooltip{background-color:var(--ua-tooltip)!important;"
			+ "color:var(--ua-tooltiptext)!important;border-color:var(--ua-border)!important}")
		+ ("input,select,textarea,button{background-color:var(--ua-field)!important;"
			+ "color:var(--ua-fieldtext)!important;border-color:var(--ua-border)!important}")
		+ ("tr.totals td{background-color:var(--ua-head)!important;"
			+ "color:var(--ua-headtext)!important;border-color:var(--ua-border)!important}")
		+ (".note,[style*='background:#fff4f1'],"
			+ "[style*='background:#fff4cd']{background-color:var(--ua-notice)!important;"
			+ "color:var(--ua-text)!important}")
		+ "[style*='background:#f6f8fb']{background-color:var(--ua-head)!important}"
		+ (".heat td[style*='background:#f1f4f8']{background-color:var(--ua-head)!important;"
			+ "color:var(--ua-muted)!important}")
		+ "svg text{fill:var(--ua-text)!important}svg text[fill='#d94a4a']{fill:var(--ua-danger)!important}"
		+ ("svg path[stroke='#245d9e']{stroke:var(--ua-link)!important}svg "
			+ "circle[fill='#245d9e']{fill:var(--ua-link)!important}");
	
КонецФункции


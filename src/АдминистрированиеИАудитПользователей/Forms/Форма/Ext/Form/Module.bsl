	Справочник = СтрЗаменить(Имя, "ТекущегоПользователя", "");
	Добавить = СтрЗаканчиваетсяНа(Команда.Имя, "Добавить");
	Группа = Неопределено;
	
	Если Не Добавить Тогда
		Группа = Элементы[Имя].ТекущаяСтрока;
	КонецЕсли;
	
	НачатьИзменениеГруппы(Справочник, Добавить, Группа);
	

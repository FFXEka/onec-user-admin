#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Заголовок = НСтр("ru='Заблокировать неактивных'");
	ПорогДней = 90;
	
	Если Параметры.Свойство("ПорогДней") Тогда
		ПорогДней = Параметры.ПорогДней;
	КонецЕсли;
	
	Если Параметры.Свойство("ТолькоПорог") И Параметры.ТолькоПорог Тогда
		
		Заголовок = НСтр("ru='Порог неактивности'");
		Элементы.Заблокировать.Заголовок = НСтр("ru='Применить'");
		Элементы.Пояснение.Заголовок = НСтр("ru='Аудит обновится по новому порогу. Пользователи не изменятся.'");
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Заблокировать(Команда)
	
	Если ПорогДней < 1 Или ПорогДней > 3650 Тогда
		
		ПоказатьПредупреждение(, НСтр("ru='Укажите положительное количество дней.'"));
		
		Возврат;
		
	КонецЕсли;
	
	Закрыть(ПорогДней);
	
КонецПроцедуры

&НаКлиенте
Процедура Отменить(Команда)
	
	Закрыть();
	
КонецПроцедуры

#КонецОбласти

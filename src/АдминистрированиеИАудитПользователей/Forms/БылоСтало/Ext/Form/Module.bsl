#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Пакет = ПолучитьИзВременногоХранилища(Параметры.АдресПакета);
	
	Если ТипЗнч(Пакет) <> Тип("Структура") Тогда
		ВызватьИсключение НСтр("ru='Данные сравнения недоступны. Повторите выбор снимка.'");
	КонецЕсли;
	
	Результат = Пакет.Сравнение;
	ПрименитьСравнение(Пакет.СтарыйJSON, Пакет.ТекущийJSON, Результат);
	УдалитьИзВременногоХранилища(Параметры.АдресПакета);
	Элементы.ВидИзменений.СписокВыбора.Добавить("Все", НСтр("ru='Все изменения'"));
	Элементы.ВидИзменений.СписокВыбора.Добавить("Появились", "Появились");
	Элементы.ВидИзменений.СписокВыбора.Добавить("Исчезли", "Исчезли");
	Элементы.ВидИзменений.СписокВыбора.Добавить("Изменились", "Изменились");
	ВидИзменений = "Все";
	ЗаполнитьСписокСравнения();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВидИзмененийПриИзменении(Элемент)
	
	ОбновитьОтборСравнения();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоискПриИзменении(Элемент)
	
	ОбновитьОтборСравнения();
	
КонецПроцедуры

&НаКлиенте
Процедура HTMLДеталиДокументСформирован(Элемент)
	
	Если ВладелецФормы <> Неопределено Тогда
		ВладелецФормы.ПрименитьТемуHTML(Элемент);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыИзменения

&НаКлиенте
Процедура ИзмененияПриАктивизацииСтроки(Элемент)
	
	ДанныеСтроки = Элементы.Изменения.ТекущиеДанные;
	
	Если ДанныеСтроки <> Неопределено Тогда
		ДеталиСравненияНаСервере(ДанныеСтроки.Ключ);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыбратьПравыйСнимок(Команда)
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = НСтр("ru='Выберите снимок для правой стороны «Стало»'");
	Диалог.Фильтр = НСтр("ru='Результат аудита (*.html;*.json)|*.html;*.json'");
	Диалог.МножественныйВыбор = Ложь;
	Диалог.Показать(Новый ОписаниеОповещения("ПравыйСнимокВыбран", ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьСравнение(Команда)
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.ПолноеИмяФайла = "UserAuditComparison.html";
	Диалог.Фильтр = НСтр("ru='Отчёт HTML (*.html)|*.html'");
	Диалог.Заголовок = НСтр("ru='Сохранить результат сравнения'");
	Диалог.Показать(Новый ОписаниеОповещения("ОтчетСравненияВыбран", ЭтотОбъект));
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область МодельФормы

&НаСервере
Процедура ПрименитьСравнение(СтарыйJSON, ТекущийJSON, Результат)
	
	Индекс = Новый Соответствие;
	
	Для Каждого СтрокаРезультата Из Результат.Строки Цикл
		Индекс.Вставить(СтрокаРезультата.Ключ, ПоместитьВоВременноеХранилище(СтрокаРезультата.Детали,
			УникальныйИдентификатор));
	КонецЦикла;
	
	АдресПолногоРезультата = ПоместитьВоВременноеХранилище(Результат, УникальныйИдентификатор);
	
	Для Каждого СтрокаРезультата Из Результат.Строки Цикл
		СтрокаРезультата.Детали = Неопределено;
	КонецЦикла;
	
	Контекст = Новый Структура;
	Контекст.Вставить("ПолныйРезультат", АдресПолногоРезультата);
	Контекст.Вставить("СтарыйJSON", ПоместитьВоВременноеХранилище(СтарыйJSON, УникальныйИдентификатор));
	Контекст.Вставить("ТекущийJSON", ПоместитьВоВременноеХранилище(ТекущийJSON, УникальныйИдентификатор));
	Контекст.Вставить("Результат", Результат);
	Контекст.Вставить("Индекс", Индекс);
	СтарыйАдрес = АдресДанныхСравнения;
	АдресДанныхСравнения = ПоместитьВоВременноеХранилище(Контекст, УникальныйИдентификатор);
	
	Если Не ПустаяСтрока(СтарыйАдрес) Тогда
		
		СтарыйКонтекст = ПолучитьИзВременногоХранилища(СтарыйАдрес);
		
		Если ТипЗнч(СтарыйКонтекст) = Тип("Структура") Тогда
			
			Для Каждого ЭлементИндекса Из СтарыйКонтекст.Индекс Цикл
				УдалитьИзВременногоХранилища(ЭлементИндекса.Значение);
			КонецЦикла;
			
			УдалитьИзВременногоХранилища(СтарыйКонтекст.СтарыйJSON);
			УдалитьИзВременногоХранилища(СтарыйКонтекст.ТекущийJSON);
			УдалитьИзВременногоХранилища(СтарыйКонтекст.ПолныйРезультат);
			
		КонецЕсли;
		
		УдалитьИзВременногоХранилища(СтарыйАдрес);
		
	КонецЕсли;
	
	Элементы.Было.Заголовок = НСтр("ru='Было:'") + " " + Результат.Раньше;
	Элементы.Стало.Заголовок = НСтр("ru='Стало:'") + " " + Результат.Сейчас;
	Сводка = СтрШаблон(НСтр("ru='Появились: %1 · Исчезли: %2 · Изменились: %3 · Сопоставлено: %4'"),
		Результат.Появились, Результат.Исчезли, Результат.Изменились, Результат.Сопоставлено);
	
	Если Результат.ОбратнаяХронология Тогда
		Сводка = Сводка + НСтр("ru='. Внимание: «Было» новее «Стало». Сравнение выполнено в выбранном направлении.'");
	КонецЕсли;
	
	Элементы.Сводка.Заголовок = Сводка;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьОтборСравнения()
	
	ЗаполнитьСписокСравнения();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокСравнения()
	
	Контекст = ПолучитьИзВременногоХранилища(АдресДанныхСравнения);
	Изменения.Очистить();
	
	Если СтрРазделить("Все,Появились,Исчезли,Изменились", ",").Найти(ВидИзменений) = Неопределено Тогда
		ВидИзменений = "Все";
	КонецЕсли;
	
	Для Каждого ДанныеСтроки Из Контекст.Результат.Строки Цикл
		
		Если ВидИзменений <> "Все" И ДанныеСтроки.Вид <> ВидИзменений Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ПустаяСтрока(Поиск) И СтрНайти(НРег(ДанныеСтроки.ПолноеИмя + " " + ДанныеСтроки.Имя),
			НРег(СокрЛП(Поиск))) = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаСписка = Изменения.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаСписка, ДанныеСтроки);
		
	КонецЦикла;
	
	Если Изменения.Количество() = 0 Тогда
		
		Текст = ?(Контекст.Результат.Строки.Количество() = 0, НСтр("ru='Изменений нет.'"),
			НСтр("ru='В выбранном отборе изменений нет.'"));
		HTMLДетали = ("<!DOCTYPE html><html lang='ru'><meta charset='utf-8'><body style='font:14px "
			+ "Arial;color:#64748b;padding:20px'>") + Текст + "</body></html>";
		
	Иначе
		ДеталиСравненияНаСервере(Изменения[0].Ключ);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДеталиСравненияНаСервере(Ключ)
	
	Контекст = ПолучитьИзВременногоХранилища(АдресДанныхСравнения);
	Детали = Контекст.Индекс.Получить(Ключ);
	
	Если Детали = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Детали = ПолучитьИзВременногоХранилища(Детали);
	HTMLДетали = РеквизитФормыВЗначение("Объект").HTMLДеталейСнимка(Детали);
	
КонецПроцедуры

#КонецОбласти

#Область ФайловыйОбмен

&НаКлиенте
Процедура ПравыйСнимокВыбран(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Или ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		ВыбранныйФайл = Новый Файл(ВыбранныеФайлы[0]);
		
		Если ВыбранныйФайл.Размер() > 67108864 Тогда
			ВызватьИсключение НСтр("ru='Размер снимка не должен превышать 64 МиБ.'");
		КонецЕсли;
		
		Оповещение = Новый ОписаниеОповещения("ПравыйСнимокЗагружен", ЭтотОбъект);
		НачатьПомещениеФайла(Оповещение, , ВыбранныеФайлы[0], Ложь, УникальныйИдентификатор);
		
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ПравыйСнимокЗагружен(Результат, Адрес, ИмяФайла, ДополнительныеПараметры) Экспорт
	
	Если Не Результат Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		ЗаменитьПравыйСнимокНаСервере(Адрес);
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ЗаменитьПравыйСнимокНаСервере(Адрес)
	
	Данные = ПолучитьИзВременногоХранилища(Адрес);
	УдалитьИзВременногоХранилища(Адрес);
	
	Если ТипЗнч(Данные) <> Тип("ДвоичныеДанные") Тогда
		ВызватьИсключение НСтр("ru='Файл снимка не получен.'");
	КонецЕсли;
	
	Если Данные.Размер() > 67108864 Тогда
		ВызватьИсключение НСтр("ru='Размер снимка не должен превышать 64 МиБ.'");
	КонецЕсли;
	
	Текст = ПолучитьСтрокуИзДвоичныхДанных(Данные, КодировкаТекста.UTF8);
	Контекст = ПолучитьИзВременногоХранилища(АдресДанныхСравнения);
	Обработка = РеквизитФормыВЗначение("Объект");
	Левый = Обработка.ДанныеФайлаСнимка(ПолучитьИзВременногоХранилища(Контекст.СтарыйJSON));
	Правый = Обработка.ДанныеФайлаСнимка(Текст);
	Сравнение = Обработка.СравнениеФайловАудита(Левый, Правый);
	ПрименитьСравнение(ПолучитьИзВременногоХранилища(Контекст.СтарыйJSON), Текст, Сравнение);
	ЗаполнитьСписокСравнения();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтчетСравненияВыбран(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныеФайлы = Неопределено Или ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		Адрес = ФайлОтчетаСравненияНаСервере();
		Оповещение = Новый ОписаниеОповещения("ОтчетСравненияСохранен", ЭтотОбъект, Адрес);
		Система = Новый СистемнаяИнформация;
		Части = СтрРазделить(Система.ВерсияПриложения, ".");
		СовременныйAPI = Число(Части[0]) > 8 Или Число(Части[1]) > 3 Или Число(Части[2]) >= 15;
		
		Если СовременныйAPI Тогда
			Выполнить("НачатьПолучениеФайлаССервера(Оповещение, Адрес, ВыбранныеФайлы[0]);");
		Иначе
			
			Файлы = Новый Массив;
			Файлы.Добавить(Новый ОписаниеПередаваемогоФайла(ВыбранныеФайлы[0], Адрес));
			НачатьПолучениеФайлов(Оповещение, Файлы, "", Ложь);
			
		КонецЕсли;
		
	Исключение
		
		Если ЗначениеЗаполнено(Адрес) Тогда
			УдалитьФайлОтчетаНаСервере(Адрес);
		КонецЕсли;
		
		ПоказатьПредупреждение(, НСтр("ru='Не удалось сохранить отчёт сравнения. Проверьте выбранный каталог.'"));
		
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтчетСравненияСохранен(Результат, Адрес) Экспорт
	
	УдалитьФайлОтчетаНаСервере(Адрес);
	
КонецПроцедуры

&НаСервере
Функция ФайлОтчетаСравненияНаСервере()
	
	Контекст = ПолучитьИзВременногоХранилища(АдресДанныхСравнения);
	HTML = РеквизитФормыВЗначение("Объект").HTMLСравненияСнимков(ПолучитьИзВременногоХранилища(
		Контекст.ПолныйРезультат));
	Данные = ПолучитьДвоичныеДанныеИзСтроки(HTML, КодировкаТекста.UTF8);
	
	Возврат ПоместитьВоВременноеХранилище(Данные, УникальныйИдентификатор);
	
КонецФункции

&НаСервере
Процедура УдалитьФайлОтчетаНаСервере(Адрес)
	
	УдалитьИзВременногоХранилища(Адрес);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

// Строит категории и строки текущего аудита с доступными действиями по строкам.
//
// Параметры:
//  Категория - Строка - код выбранной категории замечаний.
//  Поиск - Строка - текст фильтра по имени.
//
//  ПорогНеактивности - Число - число дней, после которого учётка попадает в категорию неактивных.
//
// Возвращаемое значение:
//  Структура - модель рабочего места и возможность смены пароля.
Функция РабочееМестоАудита(Категория, Поиск, ПорогНеактивности = 90) Экспорт
	
	Строки = КомпонентДанные().СтрокиСнимка(АудитПользователей.Выгрузить());
	Модель = Компонент("Интерфейс").РабочееМесто(Строки,
		ДанныеИзJSONИнтерфейса(КодыЗамечанийJSON), ДанныеИзJSONИнтерфейса(НаблюденияПаролейJSON), Категория, Поиск,
			ПорогНеактивности);
	Поддержка = Компонент("Исправления").ПоддержкаСменыПароля();
	Ссылки = Новый Массив;
	
	Для Каждого Данные Из Модель.Строки Цикл
		
		Если Данные.КодДействия = "СменитьПароль" Тогда
			Ссылки.Добавить(АудитПользователей[Данные.Индекс].ПользовательБСП);
		КонецЕсли;
		
	КонецЦикла;
	
	Требования = Компонент("Исправления").ТребованияСменыПароля(Ссылки);
	ТекущаяУчетка = НРег(СтрРазделить(КомпонентДанные().КонтекстОперации(), Символы.ПС)[0]);
	
	Для Каждого Данные Из Модель.Строки Цикл
		
		Источник = АудитПользователей[Данные.Индекс];
		
		Если НРег(Строка(Источник.ИдентификаторПользователяИБ)) = ТекущаяУчетка Тогда
			
			Данные.КодДействия = "";
			Данные.Действие = "";
			Продолжить;
			
		КонецЕсли;
		
		Если Данные.КодДействия = "СменитьПароль" Тогда
			
			Если Требования.Получить(Источник.ПользовательБСП) = Истина Тогда
				
				Данные.КодДействия = "ОтменитьСмену";
				Данные.Действие = НСтр("ru='Смена запрошена · Отменить'");
				
				Если Не Поддержка.Доступна Тогда
					
					Данные.КодДействия = "";
					Данные.Действие = НСтр("ru='Смена пароля запрошена'");
					
				КонецЕсли;
				
			ИначеЕсли Не Поддержка.Доступна Или Не ЗначениеЗаполнено(Источник.ПользовательБСП)
				Или Требования.Получить(Источник.ПользовательБСП) = Неопределено Тогда
				
				Данные.КодДействия = "";
				Данные.Действие = "";
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Модель.Вставить("ПоддержкаСменыПароля", Поддержка);
	
	Возврат Модель;
	
КонецФункции

// Устанавливает или снимает требование нового пароля и записывает исход в протокол.
//
// Параметры:
//  Идентификатор - Строка - UUID учётной записи ИБ.
//  Ссылка - СправочникСсылка.Пользователи - карточка пользователя БСП.
//  Требовать - Булево - признак установки требования смены пароля.
//  АдресПодтверждения - Строка - адрес серверного подтверждения результата проверки пароля.
//
// Возвращаемое значение:
//  Структура - признак фактического изменения.
Функция ИзменитьТребованиеСменыПароля(Идентификатор, Ссылка, Требовать, АдресПодтверждения = "") Экспорт
	
	КомпонентДанные().ПроверитьЗащитуТекущейУчетки(Идентификатор);
	Строки = АудитПользователей.НайтиСтроки(Новый Структура("ИдентификаторПользователяИБ,ПользовательБСП",
		Идентификатор, Ссылка));
	
	Если Строки.Количество() <> 1 Тогда
		ВызватьИсключение НСтр("ru='Строка аудита не найдена однозначно. Обновите аудит.'");
	КонецЕсли;
	
	Ожидаемое = Неопределено;
	Действия = КомпонентДействия();
	
	Попытка
		
		Если Требовать Тогда
			Ожидаемое = Компонент("СлабыеПароли").ПодтверждениеДляСмены(АдресПодтверждения, Идентификатор);
		КонецЕсли;
		
		Результат = Компонент("Исправления").УстановитьТребование(Ссылка, Идентификатор, Требовать, Ожидаемое);
		
	Исключение
		
		Действия.ЗаписатьТребованиеСменыПароля(Строки[0].ПолноеИмя, Идентификатор, Требовать, "Ошибка");
		ПротоколДействий.Загрузить(Действия.ЗаписиПротокола());
		ВызватьИсключение;
		
	КонецПопытки;
	
	Действия.ЗаписатьТребованиеСменыПароля(Строки[0].ПолноеИмя, Идентификатор, Требовать,
		?(Результат.Изменено, "Выполнено", НСтр("ru='Уже установлено'")));
	ПротоколДействий.Загрузить(Действия.ЗаписиПротокола());
	
	Возврат Результат;
	
КонецФункции


Функция ОбщиеПравилаПаролей() Экспорт
	
	Возврат КомпонентРекомендаций().ОбщиеНастройкиПаролей();
	
КонецФункции

// Применяет общую политику паролей при совпадении ожидаемых настроек и записывает результат в протокол.
//
// Параметры:
//  Длина - Число - новая минимальная длина пароля.
//  Сложность - Булево - новый признак проверки сложности.
//  Ожидаемые - Структура - настройки, прочитанные при открытии диалога.
//
// Возвращаемое значение:
//  Структура - результат применения и фактические параметры.
Функция УстановитьПравилаПаролей(Длина, Сложность, Ожидаемые) Экспорт
	
	Исполнитель = КомпонентРекомендаций();
	Результат = Исполнитель.УстановитьНастройкиПаролей(Длина, Сложность, Ожидаемые);
	ПротоколДействий.Загрузить(Исполнитель.ЗаписиПротокола());
	
	Возврат Результат;
	
КонецФункции

// Повторяет общий аудит и сохраняет только подтверждённые актуальные наблюдения о паролях.
//
// Параметры:
//  ПоказыватьНедействительных - Булево - передаётся в настройки общего аудита.
//  СрокНеактивности - Число - порог неактивности в днях.
//  АдресПодтверждений - Строка - адрес серверных подтверждений результатов проверки паролей.
//  ПорогВидимости - Число - порог числа учётных записей в списке входа.
//  ПорогПривилегий - Число - порог доли привилегированных записей в процентах.
Процедура АктуализироватьПослеРекомендации(ПоказыватьНедействительных, СрокНеактивности, АдресПодтверждений, ПорогВидимости, ПорогПривилегий) Экспорт
	
	Наблюдения = ДанныеИзJSONИнтерфейса(НаблюденияПаролейJSON);
	ПроизвестиАудитПользователей(ПоказыватьНедействительных, СрокНеактивности, ПорогВидимости, ПорогПривилегий);
	
	Если Наблюдения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Актуальные = КомпонентРекомендаций().АктуальныеНаблюденияПаролей(Наблюдения, АдресПодтверждений);
	БазовыеСтроки = КомпонентДанные().СтрокиСнимка(АудитПользователей.Выгрузить());
	ПрименитьПроверкуПаролей(БазовыеСтроки, Актуальные, СрокНеактивности);
	
КонецПроцедуры


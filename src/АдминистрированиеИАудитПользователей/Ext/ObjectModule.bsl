// Пересчитывает замечания базовых строк с учётом наблюдений завершённой проверки.
//
// Параметры:
//  БазовыеСтроки - Массив из Структура - строки общего аудита до проверки паролей.
//  Наблюдения - Массив из Структура - статусы и причины проверки по идентификаторам пользователей.
//  СрокНеактивностиВДнях - Число - порог давности последней активности.
Процедура ПрименитьПроверкуПаролей(БазовыеСтроки, Наблюдения, СрокНеактивностиВДнях) Экспорт
	
	НаблюденияПаролейJSON = JSONИнтерфейса(Наблюдения);
	НаблюденияДляЯдра = Новый Массив;
	
	Для Каждого Наблюдение Из Наблюдения Цикл
		
		ДанныеНаблюдения = Новый Структура;
		ДанныеНаблюдения.Вставить("ИдентификаторПользователяИБ", Наблюдение.ИдентификаторПользователяИБ);
		ДанныеНаблюдения.Вставить("Статус", Наблюдение.Статус);
		ДанныеНаблюдения.Вставить("Причина", Наблюдение.Причина);
		НаблюденияДляЯдра.Добавить(ДанныеНаблюдения);
		
	КонецЦикла;
	
	Строки = КомпонентЯдро().СтрокиСЗамечаниямиПроверкиПаролей(БазовыеСтроки, НаблюденияДляЯдра,
		СрокНеактивностиВДнях, ТекущаяДатаСеанса(), ДанныеИзJSONИнтерфейса(КодыЗамечанийJSON));
	Источник = АудитПользователей.Выгрузить();
	АудитПользователей.Загрузить(КомпонентДанные().ТаблицаРезультатаАудита(Строки, Источник));
	

	Возврат КомпонентРекомендаций().НоваяОперация(Код, АудитПользователей.Выгрузить(),
		Разрешенные, АдресПодтверждений, ИдентификаторФормы, ОбщаяРекомендация);
	
КонецФункции

// Выполняет очередную порцию операции и переносит записи в протокол.
//
// Параметры:

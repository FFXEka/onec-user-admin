#Область HTMLРабочегоСписка

// Строит сокращённый список пользователей с действиями и ссылками, привязанными к версии представления.
//
// Параметры:
//  Строки - Массив из Структура - строки для обработки или отображения.
//  Категория - Строка - код выбранной категории замечаний.
//  Версия - Строка - маркер текущего представления для проверки ссылок действий.
//  АктивностьДоступна - Булево - наличие данных о последнем входе.
//  Порядок - Число - код порядка сортировки.
//  МожноВыбирать - Булево - доступность отметок выбора строк.
//
// Возвращаемое значение:
//  Строка - HTML сокращённого списка.
Функция HTMLРабочегоСписка(Строки, Категория, Версия, АктивностьДоступна, Порядок = 0, МожноВыбирать = Истина, ЗаголовокПрочейАктивности = "") Экспорт
	
	Совпадения = Новый Соответствие;
	ОбластиПроверки = Новый Соответствие;
	
	Для Каждого Наблюдение Из ДанныеИзJSONИнтерфейса(НаблюденияПаролейJSON) Цикл
		
		Область = "";
		
		Если Наблюдение.Свойство("ОбластьПроверки", Область) И Область = "PBKDF2_SHORT" Тогда
			ОбластиПроверки.Вставить(Наблюдение.ИдентификаторПользователяИБ, Истина);
		КонецЕсли;
		
		Если Наблюдение.Статус = "FOUND" И Наблюдение.Причина <> "EMPTY" Тогда
			Совпадения.Вставить(Наблюдение.ИдентификаторПользователяИБ, Истина);
		КонецЕсли;
		
	КонецЦикла;
	
	СтрокиИнтерфейса = Новый Массив;
	ТекущаяУчетка = НРег(СтрРазделить(КомпонентДанные().КонтекстОперации(), Символы.ПС)[0]);
	
	Для Каждого Исходная Из Строки Цикл
		
		Данные = Новый Структура;
		
		Если ТипЗнч(Строки) = Тип("ТаблицаЗначений") Тогда
			
			Для Каждого Колонка Из Строки.Колонки Цикл
				Данные.Вставить(Колонка.Имя, Исходная[Колонка.Имя]);
			КонецЦикла;
			
		Иначе
			
			Для Каждого Поле Из Исходная Цикл
				Данные.Вставить(Поле.Ключ, Поле.Значение);
			КонецЦикла;
			
		КонецЕсли;
		
		Данные.Вставить("СлабыйПароль", Совпадения.Получить(Данные.ИдентификаторПользователяИБ) = Истина);
		Данные.Вставить("КороткаяПроверкаПароля",
			ОбластиПроверки.Получить(Данные.ИдентификаторПользователяИБ) = Истина);
		Данные.Вставить("МожноОтключитьСтандартныйВход",
			(Категория = "ПустойПароль" Или Категория = "СлабыйПароль")
			И Данные.НайденПользовательИБ И Данные.АутентификацияСтандартная
			И НРег(Данные.ИдентификаторПользователяИБ) <> ТекущаяУчетка);
		СтрокиИнтерфейса.Добавить(Данные);
		
	КонецЦикла;
	
	Возврат Компонент("Интерфейс").HTMLРабочегоСписка(СтрокиИнтерфейса, Категория, Версия, АктивностьДоступна, Порядок,
		МожноВыбирать, ЗаголовокПрочейАктивности);
	
КонецФункции

#КонецОбласти

#Область РекомендуемыеДействия

// Подбирает общие действия по текущему аудиту, включая подходящие неактивные учётные записи.
//
// Параметры:
//  АудитВыполнен - Булево - признак наличия результата общего аудита.
//
//  ПорогНеактивности - Число - общий для открытой формы порог неактивности.
//
// Возвращаемое значение:
//  Массив из Структура - карточки предложений с кодами и количествами.
Функция ПредложенияРекомендаций(АудитВыполнен, ПорогНеактивности = 90, СчетчикиПрочейАктивности = Неопределено) Экспорт
	
	СтрокиАудита = АудитПользователей.Выгрузить();
	Результат = КомпонентРекомендаций().Предложения(ДанныеИзJSONИнтерфейса(НаблюденияПаролейJSON), АудитВыполнен,
		СтрокиАудита);
	Неактивные = НеактивныеПользователи(СтрокиАудита, ПорогНеактивности, СчетчикиПрочейАктивности);
	
	Если АудитВыполнен Тогда
		КомпонентРекомендаций().ДобавитьПредложениеОНеактивных(Результат, Неактивные, ПорогНеактивности,
			СчетчикиПрочейАктивности <> Неопределено);
	КонецЕсли;
	
	Если АудитВыполнен Тогда
		
		Защита = КомпонентДанные().РекомендацияЗащитыВхода();
		
		Если Защита <> Неопределено Тогда
			Результат.Добавить(Защита);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Подбирает свободные учётные записи для устранения несопоставленной строки.
//
// Параметры:
//  Связь - Структура - исходная сторона связи и направление подбора.
//  Версия - Строка - маркер текущего представления для проверки ссылок действий.
//
// Возвращаемое значение:
//  Структура - кандидаты и HTML выбора.
Функция ВариантыСвязиАудита(Связь, Версия) Экспорт
	
	Кандидаты = Компонент("Исправления").КандидатыСвязи(Связь, КомпонентДанные());
	HTML = Компонент("Интерфейс").HTMLВыбораСвязи(Кандидаты, Связь.ПодбираетсяИБ, Версия);
	Возврат Новый Структура("Кандидаты,HTML", Кандидаты, HTML);
	
КонецФункции

// Удаляет непривязанную учётку ИБ после повторной проверки её имени и отсутствия связи БСП.
//
// Параметры:
//  Идентификатор - Строка - UUID учётной записи ИБ.
//  ОжидаемоеИмя - Строка - имя учётки на момент подтверждения удаления.
Процедура УдалитьУчеткуИзАудита(Идентификатор, ОжидаемоеИмя) Экспорт
	
	Компонент("Исправления").УдалитьНепривязаннуюУчеткуИБ(Идентификатор, ОжидаемоеИмя, КомпонентДанные());
	Детали = Новый Структура("Пользователь,ИдентификаторПользователяИБ,Причина", ОжидаемоеИмя, Идентификатор,
		НСтр("ru='Удалена учётная запись ИБ без карточки БСП.'"));
	Действия = КомпонентДействия();
	Действия.ЗаписатьРекомендованноеДействие(НСтр("ru='Удаление учётки ИБ'"), Детали, "Выполнено");
	ПротоколДействий.Загрузить(Действия.ЗаписиПротокола());
	
КонецПроцедуры

// Связывает карточку БСП с пользователем ИБ после проверки прежнего идентификатора.
//
// Параметры:
//  Ссылка - СправочникСсылка.Пользователи - карточка пользователя БСП.
//  Идентификатор - Строка - UUID учётной записи ИБ.
//  СтарыйИдентификатор - Строка - ожидаемый прежний UUID пользователя ИБ в карточке.
Процедура СвязатьПользователяАудита(Ссылка, Идентификатор, СтарыйИдентификатор) Экспорт
	
	Компонент("Исправления").СвязатьУчетныеЗаписи(Ссылка, Идентификатор, СтарыйИдентификатор, КомпонентДанные());
	Детали = Новый Структура("Пользователь,ИдентификаторПользователяИБ,Причина", Строка(Ссылка), Идентификатор,
		НСтр("ru='Установлена связь с учётной записью ИБ.'"));
	Действия = КомпонентДействия();
	Действия.ЗаписатьРекомендованноеДействие(НСтр("ru='Связывание ИБ/БСП'"), Детали, "Выполнено");
	ПротоколДействий.Загрузить(Действия.ЗаписиПротокола());
	
КонецПроцедуры

// Проверяет или применяет выбранное действие над учётными записями и собирает результат по каждой строке.
//
// Параметры:
//  Код - Строка - код выбранного действия.
//  Выбранные - Массив из Структура - пары карточек БСП и UUID, выбранные для действия.
//  Предпросмотр - Булево - режим проверки без применения изменений.
//  АдресПодтверждения - Строка - адрес серверного подтверждения результата проверки пароля.
//  ПорогДней - Число - минимум дней неактивности для массового действия.
//
// Возвращаемое значение:
//  Структура - массивы изменённых, пропущенных и ошибочных строк.
Функция ИзменениеДоступаПоАудиту(Код, Выбранные, Предпросмотр, АдресПодтверждения, ПорогДней = 90, СчетчикиПрочейАктивности = Неопределено) Экспорт
	
	ТолькоВыбранные = Код = "НеактивныеВыбранные";
	
	Если ТолькоВыбранные Тогда
		Код = "Неактивные";
	КонецЕсли;
	
	Если СтрРазделить(
		"СменаВыбранным,РолиБлок,РолиНедействителен,ЗапрещенНедействителен,СвязиНедействителен,Неактивные",
		",").Найти(Код) = Неопределено Тогда
		ВызватьИсключение НСтр("ru='Неизвестное действие по результату аудита.'");
	КонецЕсли;
	
	Данные = КомпонентДанные();
	
	Если Код = "Неактивные" Тогда
		
		Допустимые = КомпонентДанные().НеактивныеПользователиАудита(АудитПользователей.Выгрузить(),
			ПорогДней, Не ТолькоВыбранные);
		
		Если Предпросмотр Тогда
			
			Если Не ТолькоВыбранные Тогда
				Выбранные = БезПрочейАктивности(Допустимые, СчетчикиПрочейАктивности);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Исправления = Компонент("Исправления");
	Протокол = КомпонентДействия();
	Результат = Новый Структура("Изменены,Пропущены,Ошибки", Новый Массив, Новый Массив, Новый Массив);
	
	Для Каждого Выбранный Из Выбранные Цикл
		
		Строки = АудитПользователей.НайтиСтроки(Новый Структура("ИдентификаторПользователяИБ,ПользовательБСП",
			Выбранный.ИдентификаторПользователяИБ, Выбранный.ПользовательБСП));
		
		Если Строки.Количество() <> 1 Тогда
			
			Детали = Новый Структура;
			Детали.Вставить("Пользователь", НСтр("ru='Учётная запись'") + " " + Выбранный.ИдентификаторПользователяИБ);
			Детали.Вставить("ИдентификаторПользователяИБ", Выбранный.ИдентификаторПользователяИБ);
			Детали.Вставить("Причина", НСтр("ru='Строка аудита отсутствует или неоднозначна. Обновите общий аудит.'"));
			Результат.Пропущены.Добавить(Детали);
			
			Если Не Предпросмотр Тогда
				Протокол.ЗаписатьРекомендованноеДействие(Код, Детали, "Пропущено");
			КонецЕсли;
			
			Продолжить;
			
		КонецЕсли;
		
		СтрокаАудита = Строки[0];
		Детали = Новый Структура;
		Детали.Вставить("Пользователь", СтрокаАудита.ПолноеИмя);
		Детали.Вставить("ИдентификаторПользователяИБ", СтрокаАудита.ИдентификаторПользователяИБ);
		Детали.Вставить("ПользовательБСП", СтрокаАудита.ПользовательБСП);
		Детали.Вставить("Причина", "");
		Статус = "Выполнено";
		
		Попытка
			
			Если Код = "Неактивные" Тогда
				
				ПользовательИБ = Данные.ПользовательИБПоИдентификатору(Детали.ИдентификаторПользователяИБ);
				
				Если ПользовательИБ <> Неопределено И Данные.ЭтоТекущийПользовательИБ(ПользовательИБ) Тогда
					
					Детали.Причина = НСтр("ru='Текущая учётная запись защищена от блокировки.'");
					Результат.Пропущены.Добавить(Детали);
					
					Если Не Предпросмотр Тогда
						Протокол.ЗаписатьРекомендованноеДействие(Код, Детали, "Пропущен");
					КонецЕсли;
					
					Продолжить;
					
				КонецЕсли;
				
			КонецЕсли;
			
			Данные.ПроверитьЗащитуТекущейУчетки(Детали.ИдентификаторПользователяИБ);
			
			Если Код = "Неактивные" И Не ТолькоВыбранные
				И Не ДопустимаПоПрочейАктивности(СчетчикиПрочейАктивности, Детали.ИдентификаторПользователяИБ) Тогда
				
				Детали.Причина = ?(СчетчикиПрочейАктивности.Получить(НРег(Детали.ИдентификаторПользователяИБ))
					= Неопределено, НСтр("ru='Для учётки нет актуального расчёта прочей активности.'"),
				НСтр("ru='В журнале найдены веб- или COM-сеансы пользователя.'"));
				Статус = "Пропущен";
				Результат.Пропущены.Добавить(Детали);
				
			ИначеЕсли Код = "Неактивные" И Не ЕстьВНеактивных(Допустимые, Детали) Тогда
				
				Детали.Причина = ?(СтрокаАудита.СтатусПроверкиАктивности = "Проверка не выполнена"
					Или Не Данные.ЕстьДанныеАктивностиБСП(), НСтр("ru='Источник дат активности БСП недоступен.'"),
					НСтр("ru='Учётная запись не соответствует условиям блокировки по неактивности.'"));
				Статус = "Пропущен";
				Результат.Пропущены.Добавить(Детали);
				
			ИначеЕсли Код = "СменаВыбранным" Тогда
				
				Детали.Причина = НСтр("ru='Потребовать новый пароль при следующем входе'");
				
				Если Предпросмотр Тогда
					
					Ожидаемое = Компонент("СлабыеПароли").ПодтверждениеДляСмены(АдресПодтверждения,
						Детали.ИдентификаторПользователяИБ);
					Исправления.ПроверитьТребованиеПароля(Детали.ПользовательБСП, Детали.ИдентификаторПользователяИБ,
						Ожидаемое);
					
				Иначе
					ИзменитьТребованиеСменыПароля(Детали.ИдентификаторПользователяИБ, Детали.ПользовательБСП, Истина,
						АдресПодтверждения);
				КонецЕсли;
				
				Результат.Изменены.Добавить(Детали);
				
			Иначе
				
				Доступ = Исправления.ИзменитьДоступ(Код, Детали.ПользовательБСП,
					Детали.ИдентификаторПользователяИБ, Предпросмотр, Данные, ПорогДней,
					Код = "Неактивные" И Не ТолькоВыбранные);
				Детали.Причина = Доступ.Причина;
				
				Если Доступ.Пропущено Тогда
					
					Статус = "Пропущен";
					Результат.Пропущены.Добавить(Детали);
					
				Иначе
					Результат.Изменены.Добавить(Детали);
				КонецЕсли;
				
			КонецЕсли;
			
		Исключение
			
			Статус = "Ошибка";
			Детали.Причина = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			Результат.Ошибки.Добавить(Детали);
			
		КонецПопытки;
		
		Если Не Предпросмотр И Код <> "СменаВыбранным" Тогда
			Протокол.ЗаписатьРекомендованноеДействие(Код, Детали, Статус);
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не Предпросмотр И Код <> "СменаВыбранным" Тогда
		ПротоколДействий.Загрузить(Протокол.ЗаписиПротокола());
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаписатьОтклоненныеСтрокиАудита(Код, Предпросмотр) Экспорт
	
	Протокол = КомпонентДействия();
	
	Для Каждого Строка Из Предпросмотр.Пропущены Цикл
		Протокол.ЗаписатьРекомендованноеДействие(Код, Строка, "Пропущен");
	КонецЦикла;
	
	Для Каждого Строка Из Предпросмотр.Ошибки Цикл
		Протокол.ЗаписатьРекомендованноеДействие(Код, Строка, "Ошибка");
	КонецЦикла;
	
	ПротоколДействий.Загрузить(Протокол.ЗаписиПротокола());
	
КонецПроцедуры

// Рисует список общих действий с текущими состояниями и ссылками на предварительный просмотр.
//
// Параметры:
//  Предложения - Массив из Структура - доступные общие рекомендации.
//  Статусы - ТаблицаЗначений - тексты состояний по кодам рекомендаций.
//  Версия - Строка - маркер текущего представления для проверки ссылок действий.
//  Занят - Булево - признак выполнения операции, блокирующей ссылки.
//  АудитВыполнен - Булево - признак наличия результата общего аудита.
//
// Возвращаемое значение:
//  Строка - HTML представления рекомендаций.
Функция HTMLРекомендуемыхДействий(Предложения, Статусы, Версия, Занят, АудитВыполнен = Истина) Экспорт
	
	Возврат Компонент("Интерфейс").HTMLРекомендуемыхДействий(Предложения, Статусы, Версия, Занят, АудитВыполнен);
	
КонецФункции

// Возвращает параметры защиты входа для подтверждения настройки администратором.
//
// Возвращаемое значение:
//  Структура - прочитанные параметры и доступность.
Функция ПолитикаЗащитыВхода() Экспорт
	
	Возврат КомпонентДанные().ПолитикаОграниченияПопытокАудита();
	
КонецФункции

// Применяет подтверждённый лимит и добавляет результат в общий протокол.
//
// Параметры:
//  Политика - Структура - параметры, показанные в подтверждении.
//
// Возвращаемое значение:
//  Строка - результат настройки.
Функция НастроитьЗащитуВхода(Политика) Экспорт
	
	Текст = КомпонентДанные().НастроитьЗащитуВхода(Политика);
	Запись = ПротоколДействий.Добавить();
	Запись.Дата = ТекущаяДатаСеанса();
	Запись.Администратор = КомпонентДанные().ИмяТекущегоАдминистратора();
	Запись.Действие = НСтр("ru='Настроить защиту от перебора пароля'");
	Запись.Подробности = Текст;
	Запись.Статус = "Выполнено";
	Возврат Текст;
	
КонецФункции

// Подбирает и проверяет кандидатов перед запуском массового действия.

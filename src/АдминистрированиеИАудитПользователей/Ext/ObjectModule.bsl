// Меняет порядок строк текущего результата, сохраняя их состав.
//
// Параметры:
//  Порядок - Число - код порядка сортировки.
Процедура УпорядочитьАудит(Порядок) Экспорт
	
	Если Порядок = 5 Или Порядок = 6 Тогда
		// Вычисляемая колонка сортируется только в рабочем списке формы.
		Возврат;
	КонецЕсли;
	
	Данные = КомпонентДанные();
	Источник = АудитПользователей.Выгрузить();
	Строки = Данные.СтрокиСнимка(Источник);
	Строки = КомпонентЯдро().УпорядоченныеСтрокиСнимка(Строки, Порядок);
	АудитПользователей.Загрузить(Данные.ТаблицаРезультатаАудита(Строки, Источник));
	
КонецПроцедуры


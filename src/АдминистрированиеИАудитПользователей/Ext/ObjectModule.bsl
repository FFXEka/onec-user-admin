// Описывает регистрацию обработки в БСП и её команду открытия формы.
//
// Возвращаемое значение:
//  Структура - вид, версия, наименование, режим и команды регистрации.
Функция СведенияОВнешнейОбработке() Экспорт
	
	ИмяОбработки = Метаданные().Имя;
	СинонимОбработки = Метаданные().Синоним;
	СинонимОбработки = ?(ЗначениеЗаполнено(СинонимОбработки), СинонимОбработки, ИмяОбработки);
	
	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("Наименование", СинонимОбработки);
	ПараметрыРегистрации.Вставить("Информация", СинонимОбработки);
	ПараметрыРегистрации.Вставить("Вид", "ДополнительнаяОбработка");
	ПараметрыРегистрации.Вставить("Версия", ВерсияОбработки);
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Ложь);
	
	Команды = НовыеКоманды();
	
	ДобавитьКоманду(Команды, СинонимОбработки, ИмяОбработки, "ОткрытиеФормы", Истина);
	
	ПараметрыРегистрации.Вставить("Команды", Команды);
	
	Возврат ПараметрыРегистрации;
	
КонецФункции


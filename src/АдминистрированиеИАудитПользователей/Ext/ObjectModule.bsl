#Область ОписаниеПеременных

Перем ВерсияОбработки;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Формирует шаблон сведений о внешнем отчете или обработке для последующего заполнения.
//
// Параметры:
//   ВерсияБСП - см. СтандартныеПодсистемыСервер.ВерсияБиблиотеки.
//
// Возвращаемое значение:
//   Структура - параметры внешнего отчета или обработки:
//       * Вид - ПеречислениеСсылка.ВидыДополнительныхОтчетовИОбработок
//             - Строка - вид внешнего отчета или обработки. Для указания вида рекомендуется использовать функции
//           ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработки<ИмяВида>.
//           Также вид можно указать явно:
//           "ПечатнаяФорма",
//           "ЗаполнениеОбъекта",
//           "СозданиеСвязанныхОбъектов",
//           "Отчет",
//           "ШаблонСообщения",
//           "ДополнительнаяОбработка",
//           "ДополнительныйОтчет".
//
//       * Версия - Строка - версия отчета или обработки (далее - обработки).
//           Задается в формате: "<Старший номер>.<Младший номер>".
//
//       * Назначение - Массив - полные имена объектов конфигурации (Строка), для которых предназначен эта обработка.
//                               Необязательное свойство.
//
//       * Наименование - Строка - представление для администратора (наименование элемента справочника).
//                                 Если не заполнено, то берется представление объекта метаданных внешней обработки.
//                                 Необязательное свойство.
//
//       * БезопасныйРежим - Булево - признак подключения внешней обработки в безопасном режиме.
//                                    Значение по умолчанию Истина (обработка будет выполняться безопасно).
//                                    В безопасном режиме:
//                                     Игнорируется привилегированный режим.
//                                     Запрещены внешние по отношению к платформе 1С:Предприятия действия:
//                                      COM;
//                                      загрузка внешних компонент;
//                                      запуск внешних приложений и команд операционной системы;
//                                      доступ к файловой системе, кроме временных файлов;
//                                      доступ к Интернету.
//                                    Необязательное свойство.
//
//       * Разрешения - Массив из ОбъектXDTO - дополнительные разрешения, необходимые внешней обработке при работе в
//                               безопасном режиме. Элемент массива - ОбъектXDTO - разрешение типа
//                               {http://www.1c.ru/1cFresh/ApplicationExtensions/Permissions/a.b.c.d}PermissionBase.
//                               Для формирования описания разрешения рекомендуется использовать функции
//                               РаботаВБезопасномРежиме.Разрешение<ВидРазрешения>(<ПараметрыРазрешения>).
//                               Необязательное свойство.
//
//       * Информация - Строка - краткая информация о внешней обработке.
//                               В этом параметре для администратора рекомендуется дать описание ее возможностей.
//                               Если не заполнено, то берется комментарий объекта метаданных внешней обработки.
//
//       * ВерсияБСП - см. СтандартныеПодсистемыСервер.ВерсияБиблиотеки.
//
//       * ОпределитьНастройкиФормы - Булево - только для дополнительных отчетов, подключенных к общей форме ФормаОтчета.
//                                             Позволяет переопределять некоторые настройки общей формы отчета и
//                                             подписываться на ее события.
//                                             Если Истина, то в модуле объекта отчета следует определить процедуру по шаблону:
//
//       * НазначениеВариантаОтчета - ПеречислениеСсылка.НазначенияВариантовОтчетов - назначение варианта отчета
//										(ДляКомпьютеровИПланшетов, ДляСмартфонов, ДляЛюбыхУстройств).
//
//           // Задать настройки формы отчета.
//           //
//           // Параметры:
//           //   Форма - ФормаКлиентскогоПриложения, Неопределено
//           //   КлючВарианта - Строка, Неопределено
//           //   Настройки - см. ОтчетыКлиентСервер.НастройкиОтчетаПоУмолчанию
//           //
//           Процедура ОпределитьНастройкиФормы(Форма, КлючВарианта, Настройки) Экспорт
//           	// Код процедуры.
//           КонецПроцедуры
//
//           Подробнее см. в документации к подсистемам "Дополнительные отчеты и обработки" и "Варианты отчетов".
//           Необязательное свойство.
//
//       * Команды - ТаблицаЗначений - настройки команд, поставляемых внешней обработкой (необязательно для отчетов):
//           ** Идентификатор - Строка - внутреннее имя команды. Для внешних печатных форм (когда Вид = "ПечатнаяФорма"):
//                 Идентификатор может содержать имена одной или нескольких команд печати,
//                 разделенные запятыми. Подробнее см. описание колонки Идентификатор
//                 в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати.
//           ** Представление - Строка - пользовательское представление команды.
//           ** Использование - Строка - тип команды:
//               "ВызовКлиентскогоМетода",
//               "ВызовСерверногоМетода",
//               "ЗаполнениеФормы",
//               "ОткрытиеФормы" или
//               "СценарийВБезопасномРежиме".
//               Для получения типов команд рекомендуется использовать функции
//               ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКоманды<ИмяТипа>.
//               В комментариях к этим функциям также даны шаблоны процедур-обработчиков команд.
//           ** ПоказыватьОповещение - Булево - если Истина, то при запуске команды выводится оповещение "Команда выполняется...".
//              Действует для всех типов команд, кроме команд по открытию формы (Использование = "ОткрытиеФормы").
//           ** Модификатор - Строка - дополнительная классификация команды.
//               Для внешних печатных форм (когда Вид = "ПечатнаяФорма"):
//                 "ПечатьMXL" - для печатных форм на основе табличных макетов.
//               Для загрузки данных из файла (когда Вид = "ПечатнаяФорма" и Использование = "ЗагрузкаДанныхИзФайла"):
//                 Модификатор является обязательным для заполнения
//                 и должен содержать полное имя объекта метаданных (справочника),
//                 для которого выполняется загрузка данных.
//           ** Скрыть - Булево - необязательный. Признак того, что это служебная команда.
//               Если установить в значение Истина, то команда скрывается в карточке дополнительного объекта.
//
Функция СведенияОВнешнейОбработке() Экспорт
	
	ИмяОбработки = Метаданные().Имя;
	СинонимОбработки = Метаданные().Синоним;
	СинонимОбработки = ?(ЗначениеЗаполнено(СинонимОбработки), СинонимОбработки, ИмяОбработки);
	
	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("Наименование", СинонимОбработки);
	ПараметрыРегистрации.Вставить("Информация", СинонимОбработки);
	ПараметрыРегистрации.Вставить("Вид", "ДополнительнаяОбработка");
	ПараметрыРегистрации.Вставить("Версия", ВерсияОбработки);
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Ложь);
	
	Команды = НовыеКоманды();
	
	ДобавитьКоманду(Команды, СинонимОбработки, ИмяОбработки, "ОткрытиеФормы", Истина);
	
	ПараметрыРегистрации.Вставить("Команды", Команды);
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Копирует настройки доступа от одного пользователя другому.
//
// Параметры:
//   Приемник - СправочникСсылка.Пользователи - пользователь, которому назначаются права.
//   Источник - СправочникСсылка.Пользователи - пользователь, с которого копируются права.
//   ИспользоватьПолныйМеханизм - Булево - признак используемого механизма назначения прав:
//       Истина - полный механизм пользователей БСП: группы доступа и группы пользователей;
//       Ложь   - упрощенный механизм: группы доступа и персональные группы доступа.
//
Процедура СкопироватьПраваДоступаПользователей(Приемник, Источник, ИспользоватьПолныйМеханизм) Экспорт
	
	ПроверитьПараметрыКопированияПрав(Приемник, Источник, ИспользоватьПолныйМеханизм);
	
	НачатьТранзакцию();
	
	Попытка
		
		Если ИспользоватьПолныйМеханизм Тогда
			СкопироватьПраваПолныйМеханизм(Приемник, Источник);
		Иначе
			СкопироватьПраваУпрощенныйМеханизм(Приемник, Источник);
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		ВызватьИсключение;
		
	КонецПопытки;
	
КонецПроцедуры

Процедура ПроизвестиАудитПользователей(ПоказыватьНедействительныхПользователей) Экспорт
	
	АудитПользователей.Очистить();
	
	ПользователиБСП = ПользователиБСП();
	
	Пока ПользователиБСП.Следующий() Цикл
		НоваяСтрока = АудитПользователей.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ПользователиБСП);
		НоваяСтрока.ИдентификаторПользователяИБ = СтрокаИдентификатораПользователяИБ(
			ПользователиБСП.ИдентификаторПользователяИБ);
	КонецЦикла;
	
	ПользователиИБ = ПользователиИнформационнойБазы.ПолучитьПользователей();
	ПараметрыПоиска = Новый Структура("ИдентификаторПользователяИБ");
	
	Для Каждого ТекПользовательИБ Из ПользователиИБ Цикл
		
		ПараметрыПоиска.ИдентификаторПользователяИБ = Строка(ТекПользовательИБ.УникальныйИдентификатор);
		Поиск = АудитПользователей.НайтиСтроки(ПараметрыПоиска);
		
		Если Поиск.Количество() = 0 Тогда
			Поиск.Добавить(АудитПользователей.Добавить());
		КонецЕсли;
		
		Для Каждого СтрокаАудита Из Поиск Цикл
			ЗаполнитьСтрокуПоПользователюИБ(СтрокаАудита, ТекПользовательИБ);
		КонецЦикла;
		
	КонецЦикла;
	
	УдалитьНедействительныхПользователейПриНеобходимости(ПоказыватьНедействительныхПользователей);
	
	АудитПользователей.Сортировать("ПолноеИмя");
	
КонецПроцедуры

// Возвращает результаты изменения действительности пользователей БСП.
//
// Параметры:
//   Пользователи - Массив - ссылки на выбранных пользователей БСП.
//   ПредварительныйПросмотр - Булево - только проверить актуальное состояние без записи.
//   РазрешенныеПользователи - Массив, Неопределено - поле Изменены из подтвержденного просмотра.
//
// Возвращаемое значение:
//   Структура - массивы Изменены, Пропущены, Ошибки с пользователем, идентификатором и причиной.
Функция СделатьНедействительнымиПользователей(Пользователи, ПредварительныйПросмотр = Ложь,
	РазрешенныеПользователи = Неопределено) Экспорт
	
	Результат = НовыйРезультатМассовойОперации();
	Обработанные = Новый Соответствие;
	
	Для Каждого Пользователь Из Пользователи Цикл
		
		Если Обработанные.Получить(Пользователь) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Обработанные.Вставить(Пользователь, Истина);
		ИзменитьДействительностьПользователя(Пользователь, ПредварительныйПросмотр,
			РазрешенныеПользователи, Результат);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция УбратьВсехПользователейИзСпискаВыбора(ПредварительныйПросмотр = Ложь,
	РазрешенныеПользователи = Неопределено) Экспорт
	
	Возврат ИзменитьНастройкиПользователейИБ("Скрыть", ПредварительныйПросмотр, РазрешенныеПользователи);
	
КонецФункции

// Отключает только стандартную аутентификацию. Остальные способы входа сохраняются.
//
// Параметры:
//   ПредварительныйПросмотр - Булево - только проверить актуальное состояние без записи.
//   РазрешенныеПользователи - Массив, Неопределено - поле Изменены из подтвержденного просмотра.
//
// Возвращаемое значение:
//   Структура - массивы Изменены, Пропущены, Ошибки с пользователем, идентификатором и причиной.
Функция ЗаблокироватьВходПользователямБезПароля(ПредварительныйПросмотр = Ложь,
	РазрешенныеПользователи = Неопределено) Экспорт
	
	Возврат ИзменитьНастройкиПользователейИБ("ОтключитьСтандартнуюАутентификацию",
		ПредварительныйПросмотр, РазрешенныеПользователи);
	
КонецФункции

Функция ИнформацияОПользователе(Пользователь) Экспорт
	
	ИнформацияОПользователе = НоваяИнформацияОПользователе();
	
	Если Пользователь <> Неопределено Тогда
		
		ИдентификаторПользователяИБ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Пользователь, "ИдентификаторПользователяИБ");
		ПользовательИБ = ПользовательИБПоИдентификатору(ИдентификаторПользователяИБ);
		
		Если ПользовательИБ <> Неопределено Тогда
			
			ЗаполнитьЗначенияСвойств(ИнформацияОПользователе, ПользовательИБ);
			ИнформацияОПользователе.Вставить("ЕстьПолныеПрава", ЕстьПолныеПраваПользователя(ПользовательИБ));
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ИнформацияОПользователе;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область БСП

Функция НовыеКоманды()
	
	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	
	Возврат Команды;
	
КонецФункции

Процедура ДобавитьКоманду(Команды, Представление, Идентификатор, Использование, ПоказыватьОповещение = Ложь, Модификатор = "")
	
	НоваяКоманда = Команды.Добавить();
	НоваяКоманда.Представление = Представление;
	НоваяКоманда.Идентификатор = Идентификатор;
	НоваяКоманда.Использование = Использование;
	НоваяКоманда.ПоказыватьОповещение = ПоказыватьОповещение;
	НоваяКоманда.Модификатор = Модификатор;
	
КонецПроцедуры

#КонецОбласти

#Область КомандаСкопироватьПраваДоступа

Процедура СкопироватьПраваПолныйМеханизм(Приемник, Источник)
	
	ГруппыДоступаКИзменению = ГруппыДоступаКИзменению(Приемник, Источник);
	ГруппыПользователейКИзменению = ГруппыПользователейКИзменению(Приемник, Источник);
	ПерсональныеГруппыКИзменению = Неопределено;
	Если ЕстьРеквизитыСправочника("ГруппыДоступа", "Пользователь") Тогда
		ПерсональныеГруппыКИзменению = ПерсональныеГруппыДоступаКСозданиюИзменению(Приемник, Источник,
			Неопределено, Истина);
	КонецЕсли;
	
	УдалитьПользователяИзТабличнойЧасти(Приемник, ГруппыДоступаКИзменению.Удалить, "Пользователи");
	УдалитьПользователяИзТабличнойЧасти(Приемник, ГруппыПользователейКИзменению.Удалить, "Состав");
	
	ДобавитьПользователяВТабличнуюЧасть(Приемник, ГруппыДоступаКИзменению.Добавить, "Пользователи");
	ДобавитьПользователяВТабличнуюЧасть(Приемник, ГруппыПользователейКИзменению.Добавить, "Состав");
	СкопироватьПерсональныеНазначения(Приемник, ПерсональныеГруппыКИзменению, Истина);
	
КонецПроцедуры

Процедура СкопироватьПраваУпрощенныйМеханизм(Приемник, Источник)
	
	ГруппаПерсональныеГруппыДоступа = ПерсональныеГруппыДоступа();
	
	ГруппыДоступаКИзменению = ГруппыДоступаКИзменению(Приемник, Источник);
	ПерсональныеГруппыДоступаКСозданиюИзменению = ПерсональныеГруппыДоступаКСозданиюИзменению(Приемник,
		Источник,
		ГруппаПерсональныеГруппыДоступа);
	
	УдалитьПользователяИзТабличнойЧасти(Приемник, ГруппыДоступаКИзменению.Удалить, "Пользователи");
	ДобавитьПользователяВТабличнуюЧасть(Приемник, ГруппыДоступаКИзменению.Добавить, "Пользователи");
	СкопироватьПерсональныеНазначения(Приемник, ПерсональныеГруппыДоступаКСозданиюИзменению);
	
КонецПроцедуры

Процедура СкопироватьПерсональныеНазначения(Приемник, ГруппыКИзменению, ОбновлятьНастройки = Ложь)
	
	Если ГруппыКИзменению = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	УдалитьПользователяИзТабличнойЧасти(Приемник,
		ГруппыКИзменению.Удалить,
		"Пользователи");
	ДобавитьПользователяВТабличнуюЧастьСоздатьЭлементПриНеобходимости(Приемник,
		ГруппыКИзменению.Добавить,
		"Пользователи", ОбновлятьНастройки);
	
КонецПроцедуры

Функция ПерсональныеГруппыДоступаКСозданиюИзменению(Приемник, Источник,
	ПерсональныеГруппыДоступа, ОбновлятьНастройки = Ложь)
	
	Если Не ЕстьРеквизитыСправочника("ГруппыДоступа", "Профиль,Пользователь") Тогда
		ВызватьИсключение "Для переноса персональных назначений необходимы реквизиты Профиль и Пользователь";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ГруппыДоступа.Ссылка КАК Ссылка,
		|	ГруппыДоступа.Профиль КАК Профиль
		|ПОМЕСТИТЬ ВсеГруппыДоступаПриемника
		|ИЗ
		|	Справочник.ГруппыДоступа КАК ГруппыДоступа
		|ГДЕ
		|	ГруппыДоступа.Пользователь = &Приемник
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВсеГруппыДоступаПриемника.Ссылка КАК Ссылка,
		|	ВсеГруппыДоступаПриемника.Профиль КАК Профиль,
		|	НЕ ГруппыДоступаПользователи.Ссылка ЕСТЬ NULL КАК Включена
		|ПОМЕСТИТЬ ГруппыДоступаПриемника
		|ИЗ
		|	ВсеГруппыДоступаПриемника КАК ВсеГруппыДоступаПриемника
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ГруппыДоступа.Пользователи КАК ГруппыДоступаПользователи
		|		ПО ВсеГруппыДоступаПриемника.Ссылка = ГруппыДоступаПользователи.Ссылка
		|			И (ГруппыДоступаПользователи.Пользователь = &Приемник)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ГруппыДоступаПользователи.Ссылка КАК Ссылка,
		|	ГруппыДоступаПользователи.Ссылка.Профиль КАК Профиль,
		|	ГруппыДоступаПользователи.Ссылка.Наименование КАК Наименование,
		|	ГруппыДоступаПользователи.Ссылка.Родитель КАК Родитель
		|ПОМЕСТИТЬ ВключенныеГруппыДоступаИсточника
		|ИЗ
		|	Справочник.ГруппыДоступа.Пользователи КАК ГруппыДоступаПользователи
		|ГДЕ
		|	ГруппыДоступаПользователи.Пользователь = &Источник
		|	И ГруппыДоступаПользователи.Ссылка.Пользователь = &Источник
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ГруппыДоступаПриемника.Ссылка КАК Ссылка
		|ИЗ
		|	ГруппыДоступаПриемника КАК ГруппыДоступаПриемника
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВключенныеГруппыДоступаИсточника КАК ВключенныеГруппыДоступаИсточника
		|		ПО ГруппыДоступаПриемника.Профиль = ВключенныеГруппыДоступаИсточника.Профиль
		|ГДЕ
		|	ВключенныеГруппыДоступаИсточника.Ссылка ЕСТЬ NULL
		|	И ГруппыДоступаПриемника.Включена
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ГруппыДоступаПользователи.Ссылка
		|ИЗ
		|	Справочник.ГруппыДоступа.Пользователи КАК ГруппыДоступаПользователи
		|ГДЕ
		|	ГруппыДоступаПользователи.Пользователь = &Приемник
		|	И ГруппыДоступаПользователи.Ссылка В (&ГруппыСЛичнымиНазначениями)
		|	И ГруппыДоступаПользователи.Ссылка.Пользователь <> &Приемник
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ГруппыДоступаПриемника.Ссылка КАК Ссылка,
		|	ГруппыДоступаПриемника.Ссылка ЕСТЬ NULL КАК НеобходимоСоздать,
		|	ВключенныеГруппыДоступаИсточника.Ссылка КАК ГруппаИсточник,
		|	ВключенныеГруппыДоступаИсточника.Профиль КАК Профиль,
		|	ВключенныеГруппыДоступаИсточника.Наименование КАК Наименование,
		|	ВЫБОР
		|		КОГДА &ПерсональныеГруппыДоступа = НЕОПРЕДЕЛЕНО
		|			ТОГДА ВключенныеГруппыДоступаИсточника.Родитель
		|		ИНАЧЕ &ПерсональныеГруппыДоступа
		|	КОНЕЦ КАК Родитель,
		|	&Приемник КАК Пользователь
		|ИЗ
		|	ВключенныеГруппыДоступаИсточника КАК ВключенныеГруппыДоступаИсточника
		|		ЛЕВОЕ СОЕДИНЕНИЕ ГруппыДоступаПриемника КАК ГруппыДоступаПриемника
		|		ПО ВключенныеГруппыДоступаИсточника.Профиль = ГруппыДоступаПриемника.Профиль
		|ГДЕ
		|	&ОбновлятьНастройки
		|	ИЛИ НЕ ЕСТЬNULL(ГруппыДоступаПриемника.Включена, ЛОЖЬ)
		|;
		|
		|ВЫБРАТЬ
		|	ВсеГруппыДоступаПриемника.Ссылка КАК Ссылка,
		|	ВсеГруппыДоступаПриемника.Профиль КАК Профиль
		|ИЗ
		|	ВсеГруппыДоступаПриемника КАК ВсеГруппыДоступаПриемника
		|;
		|
		|ВЫБРАТЬ
		|	ВключенныеГруппыДоступаИсточника.Ссылка КАК Ссылка,
		|	ВключенныеГруппыДоступаИсточника.Профиль КАК Профиль
		|ИЗ
		|	ВключенныеГруппыДоступаИсточника КАК ВключенныеГруппыДоступаИсточника";
	
	Запрос.УстановитьПараметр("Источник", Источник);
	Запрос.УстановитьПараметр("Приемник", Приемник);
	Запрос.УстановитьПараметр("ПерсональныеГруппыДоступа", ПерсональныеГруппыДоступа);
	Запрос.УстановитьПараметр("ОбновлятьНастройки", ОбновлятьНастройки);
	Запрос.УстановитьПараметр("ГруппыСЛичнымиНазначениями", ГруппыСЛичнымиНазначениями());
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	ПроверитьОднозначностьПерсональныхГрупп(РезультатЗапроса[5].Выгрузить());
	ПроверитьОднозначностьПерсональныхГрупп(РезультатЗапроса[6].Выгрузить());
	Если ОбновлятьНастройки Тогда
		ПроверитьУчастниковПерсональныхГрупп(РезультатЗапроса[4].Выгрузить(), Приемник);
	КонецЕсли;
	
	ГруппыДоступа = Новый Структура;
	ГруппыДоступа.Вставить("Удалить", РезультатЗапроса[3].Выбрать());
	ГруппыДоступа.Вставить("Добавить", РезультатЗапроса[4].Выбрать());
	
	Возврат ГруппыДоступа;
	
КонецФункции

Функция ГруппыДоступаКИзменению(Приемник, Источник)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ГруппыДоступаПользователи.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ГруппыДоступаПриемника
		|ИЗ
		|	Справочник.ГруппыДоступа.Пользователи КАК ГруппыДоступаПользователи
		|ГДЕ
		|	ГруппыДоступаПользователи.Пользователь = &Приемник
		|	И НЕ ГруппыДоступаПользователи.Ссылка В (&ГруппыСЛичнымиНазначениями)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ГруппыДоступаПользователи.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ГруппыДоступаИсточника
		|ИЗ
		|	Справочник.ГруппыДоступа.Пользователи КАК ГруппыДоступаПользователи
		|ГДЕ
		|	ГруппыДоступаПользователи.Пользователь = &Источник
		|	И НЕ ГруппыДоступаПользователи.Ссылка В (&ГруппыСЛичнымиНазначениями)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ГруппыДоступаПриемника.Ссылка КАК Ссылка
		|ИЗ
		|	ГруппыДоступаПриемника КАК ГруппыДоступаПриемника
		|		ЛЕВОЕ СОЕДИНЕНИЕ ГруппыДоступаИсточника КАК ГруппыДоступаИсточника
		|		ПО ГруппыДоступаПриемника.Ссылка = ГруппыДоступаИсточника.Ссылка
		|ГДЕ
		|	ГруппыДоступаИсточника.Ссылка ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ГруппыДоступаИсточника.Ссылка КАК Ссылка
		|ИЗ
		|	ГруппыДоступаИсточника КАК ГруппыДоступаИсточника
		|		ЛЕВОЕ СОЕДИНЕНИЕ ГруппыДоступаПриемника КАК ГруппыДоступаПриемника
		|		ПО ГруппыДоступаИсточника.Ссылка = ГруппыДоступаПриемника.Ссылка
		|ГДЕ
		|	ГруппыДоступаПриемника.Ссылка ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("Источник", Источник);
	Запрос.УстановитьПараметр("Приемник", Приемник);
	Запрос.УстановитьПараметр("ГруппыСЛичнымиНазначениями", ГруппыСЛичнымиНазначениями());
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ГруппыДоступа = Новый Структура;
	ГруппыДоступа.Вставить("Удалить", РезультатЗапроса[2].Выбрать());
	ГруппыДоступа.Вставить("Добавить", РезультатЗапроса[3].Выбрать());
	
	Возврат ГруппыДоступа;
	
КонецФункции

Функция ГруппыСЛичнымиНазначениями()
	
	Группы = Новый Массив;
	Если Не ЕстьРеквизитыСправочника("ГруппыДоступа", "Пользователь") Тогда
		Возврат Группы;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ГруппыДоступа.Ссылка КАК Ссылка,
		|	ГруппыДоступа.Пользователь КАК Пользователь
		|ИЗ
		|	Справочник.ГруппыДоступа КАК ГруппыДоступа";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если ЗначениеЗаполнено(Выборка.Пользователь) Тогда
			Группы.Добавить(Выборка.Ссылка);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Группы;
	
КонецФункции

Процедура ПроверитьОднозначностьПерсональныхГрупп(Группы)
	
	Профили = Новый Соответствие;
	Для Каждого Группа Из Группы Цикл
		
		Если Не ЗначениеЗаполнено(Группа.Профиль) Тогда
			ВызватьИсключение "В персональной группе доступа не заполнен профиль";
		КонецЕсли;
		
		Если Профили.Получить(Группа.Профиль) <> Неопределено Тогда
			ВызватьИсключение "Найдено несколько персональных групп одного профиля. Устраните неоднозначность перед копированием";
		КонецЕсли;
		
		Профили.Вставить(Группа.Профиль, Группа.Ссылка);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьУчастниковПерсональныхГрупп(Группы, Пользователь)
	
	Для Каждого Группа Из Группы Цикл
		
		Если Группа.НеобходимоСоздать Тогда
			Продолжить;
		КонецЕсли;
		
		ОбъектГруппы = Группа.Ссылка.ПолучитьОбъект();
		Для Каждого Участник Из ОбъектГруппы.Пользователи Цикл
			
			Если Участник.Пользователь <> Пользователь Тогда
				ВызватьИсключение "Персональная группа приемника содержит других участников. Нельзя изменять их права при копировании";
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ГруппыПользователейКИзменению(Приемник, Источник)
	
	ГруппыПользователей = Новый Структура("Удалить, Добавить");
	
	Если Не СправочникГруппыПользователейСуществует() Тогда
		Возврат ГруппыПользователей;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ГруппыПользователейСостав.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ГруппыПользователейПриемника
		|ИЗ
		|	Справочник.ГруппыПользователей.Состав КАК ГруппыПользователейСостав
		|ГДЕ
		|	ГруппыПользователейСостав.Пользователь = &Приемник
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ГруппыПользователейСостав.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ГруппыПользователейИсточника
		|ИЗ
		|	Справочник.ГруппыПользователей.Состав КАК ГруппыПользователейСостав
		|ГДЕ
		|	ГруппыПользователейСостав.Пользователь = &Источник
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ГруппыПользователейПриемника.Ссылка КАК Ссылка
		|ИЗ
		|	ГруппыПользователейПриемника КАК ГруппыПользователейПриемника
		|		ЛЕВОЕ СОЕДИНЕНИЕ ГруппыПользователейИсточника КАК ГруппыПользователейИсточника
		|		ПО ГруппыПользователейПриемника.Ссылка = ГруппыПользователейИсточника.Ссылка
		|ГДЕ
		|	ГруппыПользователейИсточника.Ссылка ЕСТЬ NULL
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ГруппыПользователейИсточника.Ссылка КАК Ссылка
		|ИЗ
		|	ГруппыПользователейИсточника КАК ГруппыПользователейИсточника
		|		ЛЕВОЕ СОЕДИНЕНИЕ ГруппыПользователейПриемника КАК ГруппыПользователейПриемника
		|		ПО ГруппыПользователейИсточника.Ссылка = ГруппыПользователейПриемника.Ссылка
		|ГДЕ
		|	ГруппыПользователейПриемника.Ссылка ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("Источник", Источник);
	Запрос.УстановитьПараметр("Приемник", Приемник);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ГруппыПользователей.Удалить = РезультатЗапроса[2].Выбрать();
	ГруппыПользователей.Добавить = РезультатЗапроса[3].Выбрать();
	
	Возврат ГруппыПользователей;
	
КонецФункции

Процедура УдалитьПользователяИзТабличнойЧасти(Пользователь, Выборка, ИмяТЧ)
	
	Если Выборка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыПоиска = Новый Структура("Пользователь");
	
	Пока Выборка.Следующий() Цикл
		ТекущийОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ПараметрыПоиска.Пользователь = Пользователь;
		Поиск = ТекущийОбъект[ИмяТЧ].НайтиСтроки(ПараметрыПоиска);
		Для Каждого ТекСтрока Из Поиск Цикл
			ТекущийОбъект[ИмяТЧ].Удалить(ТекСтрока);
		КонецЦикла;
		ТекущийОбъект.Записать();
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьПользователяВТабличнуюЧасть(Пользователь, Выборка, ИмяТЧ)
	
	Если Выборка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Пока Выборка.Следующий() Цикл
		ТекущийОбъект = Выборка.Ссылка.ПолучитьОбъект();
		НоваяСтрока = ТекущийОбъект[ИмяТЧ].Добавить();
		НоваяСтрока.Пользователь = Пользователь;
		ТекущийОбъект.Записать();
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьПользователяВТабличнуюЧастьСоздатьЭлементПриНеобходимости(Пользователь,
	Выборка, ИмяТЧ, ОбновлятьНастройки = Ложь)
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.НеобходимоСоздать Тогда
			ТекущийОбъект = НоваяПерсональнаяГруппаДоступа(Выборка);
		Иначе
			ТекущийОбъект = Выборка.Ссылка.ПолучитьОбъект();
			Если ОбновлятьНастройки Тогда
				ОбновитьНастройкиПерсональнойГруппы(ТекущийОбъект, Выборка.ГруппаИсточник);
			КонецЕсли;
		КонецЕсли;
		
		Если ТекущийОбъект[ИмяТЧ].Найти(Пользователь, "Пользователь") = Неопределено Тогда
			НоваяСтрока = ТекущийОбъект[ИмяТЧ].Добавить();
			НоваяСтрока.Пользователь = Пользователь;
		КонецЕсли;
		
		ТекущийОбъект.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

Функция НоваяПерсональнаяГруппаДоступа(ПараметрыЗаполнения)
	
	ОбъектИсточника = ПараметрыЗаполнения.ГруппаИсточник.ПолучитьОбъект();
	НоваяГруппаДоступа = ОбъектИсточника.Скопировать();
	НоваяГруппаДоступа.Пользователи.Очистить();
	ЗаполнитьЗначенияСвойств(НоваяГруппаДоступа, ПараметрыЗаполнения, "Родитель, Пользователь");
	
	Возврат НоваяГруппаДоступа;
	
КонецФункции

Процедура ОбновитьНастройкиПерсональнойГруппы(ГруппаПриемника, ГруппаИсточника)
	
	ОбъектИсточника = ГруппаИсточника.ПолучитьОбъект();
	Для Каждого Реквизит Из ОбъектИсточника.Метаданные().Реквизиты Цикл
		
		Если Реквизит.Имя <> "Пользователь" Тогда
			ГруппаПриемника[Реквизит.Имя] = ОбъектИсточника[Реквизит.Имя];
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого ТабличнаяЧасть Из ОбъектИсточника.Метаданные().ТабличныеЧасти Цикл
		
		Если ТабличнаяЧасть.Имя <> "Пользователи" Тогда
			ГруппаПриемника[ТабличнаяЧасть.Имя].Загрузить(ОбъектИсточника[ТабличнаяЧасть.Имя].Выгрузить());
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция СправочникГруппыПользователейСуществует()
	
	МетаСправочник = Метаданные.Справочники.Найти("ГруппыПользователей");
	
	Если МетаСправочник = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат (МетаСправочник.ТабличныеЧасти.Найти("Состав") <> Неопределено);
	
КонецФункции

#КонецОбласти

#Область АудитПользователей

Процедура УдалитьНедействительныхПользователейПриНеобходимости(ПоказыватьНедействительныхПользователей)
	
	Если ПоказыватьНедействительныхПользователей Тогда
		Возврат;
	КонецЕсли;
	
	Индекс = АудитПользователей.Количество() - 1;
	
	Пока Индекс >= 0 Цикл
		
		Если АудитПользователей[Индекс].Недействителен Тогда
			АудитПользователей.Удалить(Индекс);
		КонецЕсли;
		
		Индекс = Индекс - 1;
	КонецЦикла;
	
КонецПроцедуры

Функция ПользователиБСП()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Пользователи.Ссылка КАК ПользовательБСП,
		|	Пользователи.ИдентификаторПользователяИБ КАК ИдентификаторПользователяИБ,
		|	Пользователи.Недействителен КАК Недействителен
		|ИЗ
		|	Справочник.Пользователи КАК Пользователи
		|ГДЕ
		|	НЕ Пользователи.Служебный";
	
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

Процедура ЗаполнитьСтрокуПоПользователюИБ(ТекущаяСтрока, ПользовательИБ)
	
	ЗаполнитьЗначенияСвойств(ТекущаяСтрока, ПользовательИБ);
	
	ТекущаяСтрока.ИдентификаторПользователяИБ = ПользовательИБ.УникальныйИдентификатор;
	ТекущаяСтрока.НайденПользовательИБ = Истина;
	ТекущаяСтрока.НетНикакихПрав = Истина;
	ТекущаяСтрока.ЕстьПолныеПрава = ЕстьПолныеПраваПользователя(ПользовательИБ);
	
	Для Каждого ТекРоль Из ПользовательИБ.Роли Цикл
		ТекущаяСтрока.НетНикакихПрав = Ложь;
		Прервать;
	КонецЦикла;
	
КонецПроцедуры

Функция НоваяИнформацияОПользователе()
	
	ИнформацияОПользователе = Новый Структура;
	ИнформацияОПользователе.Вставить("Имя", "");
	ИнформацияОПользователе.Вставить("ПарольУстановлен", Ложь);
	ИнформацияОПользователе.Вставить("ПоказыватьВСпискеВыбора", Ложь);
	ИнформацияОПользователе.Вставить("АутентификацияСтандартная", Ложь);
	ИнформацияОПользователе.Вставить("АутентификацияOpenID", Ложь);
	ИнформацияОПользователе.Вставить("АутентификацияOpenIDConnect", Ложь);
	ИнформацияОПользователе.Вставить("АутентификацияТокеномДоступа", Ложь);
	ИнформацияОПользователе.Вставить("АутентификацияОС", Ложь);
	ИнформацияОПользователе.Вставить("ПользовательОС", "");
	ИнформацияОПользователе.Вставить("ЕстьПолныеПрава", Ложь);
	
	Возврат ИнформацияОПользователе;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СовместимостьМетаданных

Функция НастройкиСовместимости(ИспользоватьПолныйМеханизм) Экспорт
	
	Настройки = Новый Структура;
	Настройки.Вставить("ГруппыДоступаДоступны",
		ЕстьРеквизитТабличнойЧасти("ГруппыДоступа", "Пользователи", "Пользователь"));
	Настройки.Вставить("ГруппыПользователейДоступны",
		ЕстьРеквизитТабличнойЧасти("ГруппыПользователей", "Состав", "Пользователь")
		И ЕстьПредопределенноеЗначение("Справочник.ГруппыПользователей.ВсеПользователи"));
	Настройки.Вставить("ПрофилиГруппДоступаДоступны", ДоступныПолномочияСотрудников());
	Настройки.Вставить("РабочиеГруппыДоступны",
		ЕстьРеквизитТабличнойЧасти("РабочиеГруппы", "Состав", "Участник")
		И ЕстьРеквизитыРегистра("СотрудникиПользователей", "Сотрудник,Пользователь"));
	Настройки.Вставить("ПричинаНедоступности", ПричинаНедоступностиКопирования(ИспользоватьПолныйМеханизм));
	Настройки.Вставить("КопированиеПравДоступно", Настройки.ПричинаНедоступности = "");
	
	Возврат Настройки;
	
КонецФункции

Функция ЕстьРеквизитТабличнойЧасти(ИмяСправочника, ИмяТабличнойЧасти, ИмяРеквизита)
	
	Справочник = Метаданные.Справочники.Найти(ИмяСправочника);
	Если Справочник = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТабличнаяЧасть = Справочник.ТабличныеЧасти.Найти(ИмяТабличнойЧасти);
	
	Возврат ТабличнаяЧасть <> Неопределено И ТабличнаяЧасть.Реквизиты.Найти(ИмяРеквизита) <> Неопределено;
	
КонецФункции

Функция ЕстьРеквизитыСправочника(ИмяСправочника, ИменаРеквизитов)
	
	Справочник = Метаданные.Справочники.Найти(ИмяСправочника);
	Если Справочник = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого ИмяРеквизита Из СтрРазделить(ИменаРеквизитов, ",", Ложь) Цикл
		
		Если Справочник.Реквизиты.Найти(ИмяРеквизита) = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция ЕстьРеквизитыРегистра(ИмяРегистра, ИменаРеквизитов)
	
	Регистр = Метаданные.РегистрыСведений.Найти(ИмяРегистра);
	Если Регистр = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого ИмяРеквизита Из СтрРазделить(ИменаРеквизитов, ",", Ложь) Цикл
		
		Если Регистр.Измерения.Найти(ИмяРеквизита) = Неопределено
			И Регистр.Ресурсы.Найти(ИмяРеквизита) = Неопределено
			И Регистр.Реквизиты.Найти(ИмяРеквизита) = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция ЕстьПредопределенноеЗначение(ИмяЗначения)
	
	Попытка
		Возврат ЗначениеЗаполнено(ПредопределенноеЗначение(ИмяЗначения));
	Исключение
		// В разных версиях БСП набор предопределенных элементов различается.
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

Функция ДоступныПолномочияСотрудников()
	
	Профили = Метаданные.Справочники.Найти("ПрофилиГруппДоступа");
	
	Возврат Профили <> Неопределено И Профили.Иерархический
		И ЕстьРеквизитыРегистра("ПолномочияСотрудников", "Полномочия,Владелец")
		И ЕстьРеквизитыРегистра("СотрудникиВКонтейнерах", "Сотрудник,Контейнер")
		И ЕстьРеквизитыРегистра("СотрудникиПользователей", "Сотрудник,Пользователь");
	
КонецФункции

Функция ПричинаНедоступностиКопирования(ИспользоватьПолныйМеханизм)
	
	Если Не ЕстьРеквизитыСправочника("Пользователи", "ИдентификаторПользователяИБ,Недействителен,Служебный")
		Или Не ЕстьРеквизитТабличнойЧасти("ГруппыДоступа", "Пользователи", "Пользователь") Тогда
		Возврат "Метаданные пользователей или групп доступа не соответствуют поддерживаемому механизму";
	КонецЕсли;
	
	ГруппыДоступа = Метаданные.Справочники.Найти("ГруппыДоступа");
	Если Не ГруппыДоступа.Иерархический Тогда
		Возврат "Для копирования необходим иерархический справочник групп доступа";
	КонецЕсли;
	
	Если ИспользоватьПолныйМеханизм Тогда
		
		Если Метаданные.Справочники.Найти("ГруппыПользователей") <> Неопределено
			И Не ЕстьРеквизитТабличнойЧасти("ГруппыПользователей", "Состав", "Пользователь") Тогда
			Возврат "В группах пользователей отсутствует поддерживаемая табличная часть Состав.Пользователь";
		КонецЕсли;
		
	Иначе
		
		Если Не ЕстьРеквизитыСправочника("ГруппыДоступа", "Профиль,Пользователь") Тогда
			Возврат "Для персональных групп доступа необходимы реквизиты Профиль и Пользователь";
		КонецЕсли;
		
	КонецЕсли;
	Возврат "";
КонецФункции

Процедура ПроверитьПараметрыКопированияПрав(Приемник, Источник, ИспользоватьПолныйМеханизм)
	
	ПричинаНедоступности = ПричинаНедоступностиКопирования(ИспользоватьПолныйМеханизм);
	Если ПричинаНедоступности <> "" Тогда
		ВызватьИсключение ПричинаНедоступности;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Приемник) Или Не ЗначениеЗаполнено(Источник) Или Приемник = Источник Тогда
		ВызватьИсключение "Необходимо выбрать двух разных пользователей для копирования прав";
	КонецЕсли;
	
	Если ТипЗнч(Приемник) <> Тип("СправочникСсылка.Пользователи")
		Или ТипЗнч(Источник) <> Тип("СправочникСсылка.Пользователи") Тогда
		ВызватьИсключение "Копирование прав поддерживается только для пользователей БСП";
	КонецЕсли;
	
	ПользовательПриемник = Приемник.ПолучитьОбъект();
	ПользовательИсточник = Источник.ПолучитьОбъект();
	Если ПользовательПриемник = Неопределено Или ПользовательИсточник = Неопределено Тогда
		ВызватьИсключение "Один из выбранных пользователей больше не существует";
	КонецЕсли;
	
	Если ПользовательПриемник.ПометкаУдаления Или ПользовательИсточник.ПометкаУдаления Тогда
		ВызватьИсключение "Нельзя копировать права пользователей, помеченных на удаление";
	КонецЕсли;
	
	ПользовательИБ = ПользовательИБПоИдентификатору(ПользовательПриемник.ИдентификаторПользователяИБ);
	Если ПользовательИБ <> Неопределено И ЭтоТекущийПользовательИБ(ПользовательИБ) Тогда
		ВызватьИсключение "Копирование прав текущему пользователю исключено для сохранения административного доступа";
	КонецЕсли;
	
КонецПроцедуры

Функция ПерсональныеГруппыДоступа()
	
	Попытка
		ПредопределеннаяГруппа = ПредопределенноеЗначение("Справочник.ГруппыДоступа.ПерсональныеГруппыДоступа");
	Исключение
		ПредопределеннаяГруппа = Неопределено;
	КонецПопытки;
	
	Если ЗначениеЗаполнено(ПредопределеннаяГруппа) Тогда
		
		Если ПредопределеннаяГруппа.ЭтоГруппа И Не ПредопределеннаяГруппа.ПометкаУдаления Тогда
			Возврат ПредопределеннаяГруппа;
		КонецЕсли;
		
		ВызватьИсключение "Предопределенная папка персональных групп доступа недоступна";
		
	КонецЕсли;
	
	НайденнаяГруппа = Неопределено;
	Выборка = Справочники.ГруппыДоступа.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.ЭтоГруппа И Не Выборка.ПометкаУдаления
			И Выборка.Наименование = "Персональные группы доступа" Тогда
			
			Если НайденнаяГруппа <> Неопределено Тогда
				ВызватьИсключение "Найдены несколько папок персональных групп доступа; копирование отменено";
			КонецЕсли;
			
			НайденнаяГруппа = Выборка.Ссылка;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если НайденнаяГруппа = Неопределено Тогда
		ВызватьИсключение "Не найдена однозначная папка персональных групп доступа";
	КонецЕсли;
	
	Возврат НайденнаяГруппа;
	
КонецФункции

#КонецОбласти

#Область МассовыеИзмененияПользователей

Функция НовыйРезультатМассовойОперации()
	
	Результат = Новый Структура;
	Результат.Вставить("Изменены", Новый Массив);
	Результат.Вставить("Пропущены", Новый Массив);
	Результат.Вставить("Ошибки", Новый Массив);
	
	Возврат Результат;
	
КонецФункции

Функция НоваяСтрокаРезультатаОперации(Пользователь, Причина, Идентификатор = "", ПользовательБСП = Неопределено)
	
	ПредставлениеПользователя = Строка(Пользователь);
	Если ПредставлениеПользователя = "" И ЗначениеЗаполнено(ПользовательБСП) Тогда
		ПредставлениеПользователя = Строка(ПользовательБСП);
	КонецЕсли;
	
	СтрокаРезультата = Новый Структура;
	СтрокаРезультата.Вставить("Пользователь", ПредставлениеПользователя);
	СтрокаРезультата.Вставить("Причина", Причина);
	СтрокаРезультата.Вставить("ИдентификаторПользователяИБ", СтрокаИдентификатораПользователяИБ(Идентификатор));
	СтрокаРезультата.Вставить("ПользовательБСП", ПользовательБСП);
	
	Возврат СтрокаРезультата;
	
КонецФункции

Функция ПользовательРазрешенКИзменению(РазрешенныеПользователи, Идентификатор, ПользовательБСП = Неопределено)
	
	Если РазрешенныеПользователи = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	Для Каждого Разрешенный Из РазрешенныеПользователи Цикл
		
		Если ПользовательБСП <> Неопределено Тогда
			
			Если Разрешенный.ПользовательБСП = ПользовательБСП Тогда
				Возврат Истина;
			КонецЕсли;
			
		Иначе
			
			Если Разрешенный.ИдентификаторПользователяИБ = Идентификатор Тогда
				Возврат Истина;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ИзменитьНастройкиПользователейИБ(ВидОперации, ПредварительныйПросмотр, РазрешенныеПользователи)
	
	Результат = НовыйРезультатМассовойОперации();
	Обработанные = Новый Соответствие;
	
	Для Каждого СтрокаАудита Из АудитПользователей Цикл
		
		Идентификатор = СтрокаИдентификатораПользователяИБ(СтрокаАудита.ИдентификаторПользователяИБ);
		КлючОбработки = ?(ЗначениеЗаполнено(Идентификатор), Идентификатор, СтрокаАудита.ПользовательБСП);
		Если Обработанные.Получить(КлючОбработки) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Обработанные.Вставить(КлючОбработки, Истина);
		ИзменитьНастройкиПользователяИБ(СтрокаАудита, ВидОперации, ПредварительныйПросмотр,
			РазрешенныеПользователи, Результат);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ИзменитьНастройкиПользователяИБ(СтрокаАудита, ВидОперации, ПредварительныйПросмотр,
	РазрешенныеПользователи, Результат)
	
	Идентификатор = СтрокаИдентификатораПользователяИБ(СтрокаАудита.ИдентификаторПользователяИБ);
	Детали = НоваяСтрокаРезультатаОперации(СтрокаАудита.Имя, "", Идентификатор, СтрокаАудита.ПользовательБСП);
	
	Попытка
		
		Если Не ПользовательРазрешенКИзменению(РазрешенныеПользователи, Идентификатор) Тогда
			Возврат;
		КонецЕсли;
		
		ПользовательИБ = ПользовательИБПоИдентификатору(Идентификатор);
		Детали.Причина = ПричинаПропускаИзмененияИБ(ПользовательИБ, ВидОперации);
		Если Детали.Причина <> "" Тогда
			Результат.Пропущены.Добавить(Детали);
			Возврат;
		КонецЕсли;
		
		Детали.Пользователь = ПользовательИБ.Имя;
		Если Не ПредварительныйПросмотр Тогда
			
			Если ВидОперации = "Скрыть" Тогда
				ПользовательИБ.ПоказыватьВСпискеВыбора = Ложь;
			Иначе
				ПользовательИБ.АутентификацияСтандартная = Ложь;
			КонецЕсли;
			
			ПользовательИБ.Записать();
			
		КонецЕсли;
		
		Детали.Причина = ?(ВидОперации = "Скрыть", "Скрыть из списка выбора",
			"Отключить стандартную аутентификацию; остальные способы входа сохраняются");
		Результат.Изменены.Добавить(Детали);
		
	Исключение
		Детали.Причина = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Результат.Ошибки.Добавить(Детали);
	КонецПопытки;
	
КонецПроцедуры

Функция ПользовательИБПоИдентификатору(Идентификатор)
	
	СтрокаИдентификатора = СтрокаИдентификатораПользователяИБ(Идентификатор);
	Если СтрокаИдентификатора = "" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	УИД = Новый УникальныйИдентификатор(СтрокаИдентификатора);
	
	Возврат ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(УИД);
	
КонецФункции

Функция СтрокаИдентификатораПользователяИБ(Идентификатор)
	
	Если Идентификатор = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	СтрокаИдентификатора = НРег(СокрЛП(Строка(Идентификатор)));
	Если СтрокаИдентификатора = "00000000-0000-0000-0000-000000000000" Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат СтрокаИдентификатора;
	
КонецФункции

Функция ПричинаПропускаИзмененияИБ(ПользовательИБ, ВидОперации)
	
	Если ПользовательИБ = Неопределено Тогда
		Возврат "Пользователь информационной базы не найден";
	КонецЕсли;
	
	Если ЭтоТекущийПользовательИБ(ПользовательИБ) Тогда
		Возврат "Текущий пользователь исключен для сохранения доступа администратора";
	КонецЕсли;
	
	Если ВидОперации = "Скрыть" Тогда
		Возврат ?(ПользовательИБ.ПоказыватьВСпискеВыбора, "", "Пользователь уже скрыт из списка выбора");
	КонецЕсли;
	
	Если ЕстьПолныеПраваПользователя(ПользовательИБ) Или ЕстьАдминистративныеПраваПользователя(ПользовательИБ) Тогда
		Возврат "Пользователь с административными или полными правами исключен для сохранения доступа";
	КонецЕсли;
	
	Если Не ПользовательИБ.АутентификацияСтандартная Тогда
		Возврат "Стандартная аутентификация уже отключена";
	КонецЕсли;
	
	Если ПользовательИБ.ПарольУстановлен Тогда
		Возврат "При повторной проверке у пользователя установлен пароль";
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Процедура ИзменитьДействительностьПользователя(Пользователь, ПредварительныйПросмотр,
	РазрешенныеПользователи, Результат)
	
	Детали = НоваяСтрокаРезультатаОперации(Пользователь, "", "", Пользователь);
	
	Попытка
		
		Если Не ПользовательРазрешенКИзменению(РазрешенныеПользователи, "", Пользователь) Тогда
			Возврат;
		КонецЕсли;
		
		ПользовательОбъект = Пользователь.ПолучитьОбъект();
		Детали.Причина = ПричинаПропускаНедействительности(ПользовательОбъект);
		Если Детали.Причина <> "" Тогда
			Результат.Пропущены.Добавить(Детали);
			Возврат;
		КонецЕсли;
		
		Детали.ИдентификаторПользователяИБ = СтрокаИдентификатораПользователяИБ(
			ПользовательОбъект.ИдентификаторПользователяИБ);
		Если Не ПредварительныйПросмотр Тогда
			ПользовательОбъект.Недействителен = Истина;
			ПользовательОбъект.Записать();
		КонецЕсли;
		
		Детали.Причина = "Пометить пользователя БСП как недействительного";
		Результат.Изменены.Добавить(Детали);
		
	Исключение
		Детали.Причина = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Результат.Ошибки.Добавить(Детали);
	КонецПопытки;
	
КонецПроцедуры

Функция ПричинаПропускаНедействительности(ПользовательОбъект)
	
	Если ПользовательОбъект = Неопределено Тогда
		Возврат "Пользователь БСП не найден";
	КонецЕсли;
	
	Если ПользовательОбъект.Недействителен Тогда
		Возврат "Пользователь уже недействителен";
	КонецЕсли;
	
	Если ПользовательОбъект.Служебный Тогда
		Возврат "Служебный пользователь исключен";
	КонецЕсли;
	
	ПользовательИБ = ПользовательИБПоИдентификатору(ПользовательОбъект.ИдентификаторПользователяИБ);
	Если ПользовательИБ <> Неопределено Тогда
		
		Если ЭтоТекущийПользовательИБ(ПользовательИБ)
			Или ЕстьПолныеПраваПользователя(ПользовательИБ)
			Или ЕстьАдминистративныеПраваПользователя(ПользовательИБ) Тогда
			Возврат "Текущий пользователь и пользователи с административными или полными правами исключены";
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция ЭтоТекущийПользовательИБ(ПользовательИБ)
	
	ТекущийПользователь = ПользователиИнформационнойБазы.ТекущийПользователь();
	
	Возврат ТекущийПользователь <> Неопределено
		И ТекущийПользователь.УникальныйИдентификатор = ПользовательИБ.УникальныйИдентификатор;
	
КонецФункции

Функция ЕстьПолныеПраваПользователя(ПользовательИБ)
	
	РольПолныеПрава = Метаданные.Роли.Найти("ПолныеПрава");
	
	Возврат РольПолныеПрава <> Неопределено И ПользовательИБ.Роли.Содержит(РольПолныеПрава);
	
КонецФункции

Функция ЕстьАдминистративныеПраваПользователя(ПользовательИБ)
	
	Возврат ПравоДоступа("Администрирование", Метаданные, ПользовательИБ);
	
КонецФункции


Функция Компонент(Назначение)
	
	Если СтрРазделить(
		("Данные,Ядро,Пароли,Копирование,Действия,Отчеты,СлабыеПароли,Исправления,"
			+ "Интерфейс,Активность,Рекомендации,Снимки,КриптографияПаролей"), ",").Найти(Назначение)
			= Неопределено Тогда
		ВызватьИсключение НСтр("ru='Неизвестный компонент обработки.'");
	КонецЕсли;
	
	Если КомпонентыСеанса = Неопределено Тогда
		КомпонентыСеанса = Новый Соответствие;
	КонецЕсли;
	
	Исполнитель = КомпонентыСеанса.Получить(Назначение);
	
	Если Исполнитель <> Неопределено Тогда
		Возврат Исполнитель;
	КонецЕсли;
	
	Исполнитель = НовыйКомпонентИзМакета(Назначение);
	
	Если Исполнитель.КонтрактКомпонента() <> Назначение Или Исполнитель.ВерсияКомпонента() <> "2.11" Тогда
		ВызватьИсключение НСтр("ru='Компоненты обработки не соответствуют контракту 2.11.'");
	КонецЕсли;
	
	КомпонентыСеанса.Вставить(Назначение, Исполнитель);
	
	Возврат Исполнитель;
	
КонецФункции

Функция НовыйКомпонентИзМакета(Назначение)
	
	ИмяРегистрации = "UserAdmin211" + Назначение + "_" + КодПакетаКомпонентов();
	
	Попытка
		Возврат ВнешниеОбработки.Создать(ИмяРегистрации);
	Исключение
		
		// Первый промах регистрации допустим: далее подключаем макет. Это не ошибка операции пользователя.
		СведенияПервогоСоздания = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		
		Попытка
			ЗаписьЖурналаРегистрации(НСтр("ru='Администрирование пользователей.Подключение компонента'"),
				УровеньЖурналаРегистрации.Примечание, , , СведенияПервогоСоздания);
		Исключение
			Сообщить(СведенияПервогоСоздания);
		КонецПопытки;
		
	КонецПопытки;
	
	Адрес = ПоместитьВоВременноеХранилище(ПолучитьМакет("Компонент" + Назначение));
	
	Попытка
		
		Защита = Новый ОписаниеЗащитыОтОпасныхДействий;
		Защита.ПредупреждатьОбОпасныхДействиях = Ложь;
		БезопасныйРежим = Назначение = "Ядро" Или Назначение = "Отчеты" Или Назначение = "Интерфейс"
			Или Назначение = "Снимки";
		Имя = ВнешниеОбработки.Подключить(Адрес, ИмяРегистрации, БезопасныйРежим, Защита);
		Исполнитель = ВнешниеОбработки.Создать(Имя);
		
	Исключение
		
		УдалитьИзВременногоХранилища(Адрес);
		ВызватьИсключение;
		
	КонецПопытки;
	
	УдалитьИзВременногоХранилища(Адрес);
	
	Возврат Исполнитель;
	
КонецФункции

Функция КодПакетаКомпонентов()
	
	Возврат "99a70da15b66ef5c4506";
	
КонецФункции


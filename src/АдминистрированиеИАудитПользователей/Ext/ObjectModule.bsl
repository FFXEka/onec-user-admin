#КонецОбласти

#Область АудитИСнимки

Процедура ПроизвестиАудитПользователей(ПоказыватьНедействительныхПользователей, СрокНеактивностиВДнях = 90, ПорогВидимыхУчеток = 100, ПорогДолиПривилегированных = 0) Экспорт
	
	ПроверкаРисковВыполнена = Ложь;
	ТекстРисковАудита = НСтр("ru='Проверка рисков не завершена. Выполните аудит повторно.'");
	МетрикиРисковАудита = "";
	КонтекстРисковАудита = "";
	ПолитикаВходаАудита = "";
	Настройки = НовыеНастройкиАудита();
	Настройки.ПоказыватьНедействительныхПользователей = Ложь;
	Настройки.СрокНеактивностиВДнях = СрокНеактивностиВДнях;
	Настройки.ПорогВидимыхУчеток = ПорогВидимыхУчеток;
	Настройки.ПорогДолиПривилегированных = ПорогДолиПривилегированных;
	Ядро = КомпонентЯдро();
	Ядро.ПроверитьНастройкиАудита(Настройки);
	Данные = КомпонентДанные();
	Сбор = Данные.СборДанныхАудита("current", Истина);
	Результат = Ядро.АудитСнимка(Сбор.Снимок, Настройки);
	КодыЗамечанийJSON = JSONИнтерфейса(Результат.Замечания);
	НаблюденияПаролейJSON = "";
	АудитПользователей.Загрузить(Данные.ТаблицаРезультатаАудита(Результат.Строки, Сбор.ТаблицаИсточника));
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Результат.Показатели);
	АктивностьАудитаДоступна = Сбор.Снимок.АктивностьАудитаДоступна;
	КомментарийПроверокАудита = Сбор.Снимок.КомментарийПроверокАудита;
	
КонецПроцедуры

#КонецОбласти

#Область ДействияИПротокол

Функция ВыполнитьМассовуюОперацию(ВидОперации, Выбранные, ВесьАудит, Предпросмотр, РазрешенныеПользователи = Неопределено) Экспорт
	
	Действия = КомпонентДействия();
	
	Попытка
		Результат = Действия.ВыполнитьМассовуюОперацию(ВидОперации, Выбранные, ВесьАудит,
			Предпросмотр, РазрешенныеПользователи);
	Исключение
		
		ПротоколДействий.Загрузить(Действия.ЗаписиПротокола());
		ВызватьИсключение;
		
	КонецПопытки;
	
	ПротоколДействий.Загрузить(Действия.ЗаписиПротокола());
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область Отчеты

Функция КомпонентОтчеты()
	
	ИсполнительОтчетов = Компонент("Отчеты");
	Параметры = Новый Структура;
	Параметры.Вставить("ВерсияОбработки", ВерсияОбработки);
	Параметры.Вставить("ДатаФормирования", ТекущаяДатаСеанса());
	Параметры.Вставить("База", КомпонентДанные().ОписаниеБазыДляОтчета(Компонент("Снимки")));
	Параметры.Вставить("АктивностьАудитаДоступна", АктивностьАудитаДоступна);
	Параметры.Вставить("ПроверкаРисковВыполнена", ПроверкаРисковВыполнена);
	Параметры.Вставить("ТекстРисковАудита", ТекстРисковАудита);
	Параметры.Вставить("МетрикиРисковАудита", МетрикиРисковАудита);
	Параметры.Вставить("ПолитикаВходаАудита", ПолитикаВходаАудита);
	Параметры.Вставить("КонтекстРисковАудита", КонтекстРисковАудита);
	Параметры.Вставить("ОписаниеПроверкиПаролей",
		Компонент("Интерфейс").ОписаниеОбластиПроверкиПаролей(ДанныеИзJSONИнтерфейса(НаблюденияПаролейJSON)));
	Строки = КомпонентДанные().СтрокиСнимка(АудитПользователей.Выгрузить());
	ИсполнительОтчетов.Инициализировать(Строки, ПротоколДействий.Выгрузить(), Параметры);
	
	Возврат ИсполнительОтчетов;
	
КонецФункции

#КонецОбласти

#Область Компоненты

// Старые платформы используют SHA-1 внутри проверяющего компонента без загрузки нового API.
// Возвращаемое значение:
//  ВнешняяОбработкаОбъект - проверяющий компонент с подходящим криптографическим маршрутом.
Функция ИсполнительПроверкиПаролей()
	
	Исполнитель = Компонент("СлабыеПароли");
	Криптография = Неопределено;
	
	Если КомпонентДанные().НативнаяКриптографияПаролейДоступна() Тогда
		Криптография = Компонент("КриптографияПаролей");
	КонецЕсли;
	
	Исполнитель.ИнициализироватьКриптографию(Криптография);
	
	Возврат Исполнитель;
	
КонецФункции

Функция НеактивныеПользователи(СтрокиАудита, ПорогДней, СчетчикиПрочейАктивности = Неопределено)
	
	Результат = КомпонентДанные().НеактивныеПользователиАудита(СтрокиАудита, ПорогДней);
	
	Возврат БезПрочейАктивности(Результат, СчетчикиПрочейАктивности);
	
КонецФункции

Функция БезПрочейАктивности(Строки, СчетчикиПрочейАктивности)
	
	Если СчетчикиПрочейАктивности = Неопределено Тогда
		Возврат Строки;
	КонецЕсли;
	
	Результат = Новый Массив;
	
	Для Каждого СтрокаАудита Из Строки Цикл
		
		Если ДопустимаПоПрочейАктивности(СчетчикиПрочейАктивности, СтрокаАудита.ИдентификаторПользователяИБ) Тогда
			Результат.Добавить(СтрокаАудита);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ЕстьСпособВходаДляПрочихПодключений(СтрокаАудита)
	
	Возврат СтрокаАудита.АутентификацияСтандартная Или СтрокаАудита.АутентификацияОС
		Или СтрокаАудита.АутентификацияOpenID Или СтрокаАудита.АутентификацияOpenIDConnect
		Или СтрокаАудита.АутентификацияТокеномДоступа Или СтрокаАудита.АутентификацияQRКодом
		Или СтрокаАудита.АутентификацияЧерезЭлектроннуюПочту;
	
КонецФункции

Функция ДопустимаПоПрочейАктивности(СчетчикиПрочейАктивности, ИдентификаторПользователяИБ)
	
	Если СчетчикиПрочейАктивности = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	Количество = СчетчикиПрочейАктивности.Получить(НРег(ИдентификаторПользователяИБ));
	
	Возврат Количество <> Неопределено И Количество = 0;
	
КонецФункции

Функция ЕстьВНеактивных(Строки, Данные)
	
	Для Каждого СтрокаАудита Из Строки Цикл
		
		Если СтрокаАудита.ИдентификаторПользователяИБ = Данные.ИдентификаторПользователяИБ
			И СтрокаАудита.ПользовательБСП = Данные.ПользовательБСП Тогда
			Возврат Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции


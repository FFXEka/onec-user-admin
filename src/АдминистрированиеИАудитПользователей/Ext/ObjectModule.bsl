// Блокирует выбранного пользователя и отмечает его недействительным.
// Параметры:
//  Пользователь - СправочникСсылка.Пользователи - выбранная карточка БСП.
Процедура ЗаблокироватьПользователяИзСписка(Пользователь) Экспорт
	
	Компонент("Исправления").ЗаблокироватьИНедействителен(Пользователь, КомпонентДанные());
	Детали = Новый Структура("Пользователь,ИдентификаторПользователяИБ,Причина", Строка(Пользователь),
		Строка(Пользователь.ИдентификаторПользователяИБ),
			НСтр("ru='Вход запрещён, пользователь отмечен недействительным.'"));
	Действия = КомпонентДействия();
	Действия.ЗаписатьРекомендованноеДействие(НСтр("ru='Блокировка пользователя'"), Детали, "Выполнено");
	ПротоколДействий.Загрузить(Действия.ЗаписиПротокола());
	
КонецПроцедуры

// Изменяет прямое членство пользователя в выбранной группе.
// Параметры:
//  Пользователь - СправочникСсылка.Пользователи - выбранная карточка БСП.
//  Группа - СправочникСсылка - группа доступа, пользователей или рабочая группа.
//  Добавить - Булево - Истина для включения, Ложь для исключения.
Функция ИзменитьЧленствоГруппы(Пользователь, Группа, Добавить) Экспорт
	
	Изменено = Компонент("Исправления").ИзменитьЧленствоГруппы(Пользователь, Группа, Добавить, КомпонентДанные());
	Детали = Новый Структура("Пользователь,ИдентификаторПользователяИБ,Причина", Строка(Пользователь),
		Строка(Пользователь.ИдентификаторПользователяИБ), Строка(Группа));
	
	Если Не Изменено Тогда
		Детали.Причина = СтрШаблон(НСтр("ru='Пользователь уже состоит в группе «%1».'"), Группа);
	КонецЕсли;
	
	Протокол = КомпонентДействия();
	Протокол.ЗаписатьРекомендованноеДействие(?(Добавить, НСтр("ru='Включение в группу'"),
		НСтр("ru='Исключение из группы'")), Детали, ?(Изменено, "Выполнено", "Пропущен"));
	ПротоколДействий.Загрузить(Протокол.ЗаписиПротокола());
	
	Возврат Изменено;
	
КонецФункции


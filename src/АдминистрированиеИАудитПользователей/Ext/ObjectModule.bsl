// Обновляет затронутые строки и пересчитывает замечания по уже собранному снимку.
// Параметры:
//  Выбранные - Массив из Структура - ключи строк выполненного действия.
//  СрокНеактивности - Число - порог дней текущего аудита.
//  АдресПодтверждений - Строка - адрес ранее подтверждённых результатов аудита паролей.
Процедура АктуализироватьВыбранных(Выбранные, СрокНеактивности, АдресПодтверждений = "") Экспорт
	
	Данные = КомпонентДанные();
	
	Если Данные.ИзменилисьСвязиКарточек(Выбранные) Тогда
		
		АктуализироватьПослеРекомендации(Ложь, СрокНеактивности, АдресПодтверждений, 100, 0);
		
		Возврат;
		
	КонецЕсли;
	
	Таблица = АудитПользователей.Выгрузить();
	Данные.ОбновитьСтрокиДоступа(Таблица, Выбранные);
	Снимок = Новый Структура;
	Снимок.Вставить("ВерсияСхемы", 1);
	Снимок.Вставить("ИдентификаторБазы", "current");
	Снимок.Вставить("ДатаПроверки", ТекущаяДата());
	Снимок.Вставить("РежимБазы", Данные.РежимБазыТекущегоАудита());
	Учетки = Новый Соответствие;
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		
		Если СтрокаТаблицы.НайденПользовательИБ Тогда
			Учетки.Вставить(НРег(СтрокаТаблицы.ИдентификаторПользователяИБ), Истина);
		КонецЕсли;
		
	КонецЦикла;
	
	Снимок.Вставить("ВсегоПользователейИБ", Учетки.Количество());
	Снимок.Вставить("АктивностьАудитаДоступна", АктивностьАудитаДоступна);
	Снимок.Вставить("КомментарийПроверокАудита", КомментарийПроверокАудита);
	Снимок.Вставить("ПолитикаОграниченияПопыток", Данные.ПолитикаОграниченияПопытокАудита());
	Снимок.Вставить("ПодтвержденныеСлужебныеПользователи", Данные.ПодтвержденныеСлужебныеПользователи());
	Снимок.Вставить("Строки", Данные.СтрокиСнимка(Таблица));
	Настройки = НовыеНастройкиАудита();
	Настройки.ПоказыватьНедействительныхПользователей = Ложь;
	Настройки.СрокНеактивностиВДнях = СрокНеактивности;
	Результат = КомпонентЯдро().АудитСнимка(Снимок, Настройки);
	КодыЗамечанийJSON = JSONИнтерфейса(Результат.Замечания);
	АудитПользователей.Загрузить(Данные.ТаблицаРезультатаАудита(Результат.Строки, Таблица));
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Результат.Показатели);
	Наблюдения = ДанныеИзJSONИнтерфейса(НаблюденияПаролейJSON);
	
	Если Наблюдения.Количество() > 0 И Не ПустаяСтрока(АдресПодтверждений) Тогда
		
		Затронутые = Новый Соответствие;
		
		Для Каждого Ключ Из Выбранные Цикл
			Затронутые.Вставить(НРег(Ключ.ИдентификаторПользователяИБ), Истина);
		КонецЦикла;
		
		Проверяемые = Новый Массив;
		Сохраненные = Новый Массив;
		
		Для Каждого Наблюдение Из Наблюдения Цикл
			
			Если Затронутые.Получить(НРег(Наблюдение.ИдентификаторПользователяИБ)) = Истина Тогда
				Проверяемые.Добавить(Наблюдение);
			Иначе
				Сохраненные.Добавить(Наблюдение);
			КонецЕсли;
			
		КонецЦикла;
		
		Для Каждого Наблюдение Из КомпонентРекомендаций().АктуальныеНаблюденияПаролей(Проверяемые,
			АдресПодтверждений) Цикл
			Сохраненные.Добавить(Наблюдение);
		КонецЦикла;
		
		Наблюдения = Сохраненные;
		
	КонецЕсли;
	
	НаблюденияПаролейJSON = JSONИнтерфейса(Наблюдения);
	
	Если Наблюдения.Количество() > 0 Тогда
		ПрименитьПроверкуПаролей(Данные.СтрокиСнимка(АудитПользователей.Выгрузить()), Наблюдения, СрокНеактивности);
	КонецЕсли;
	
КонецПроцедуры

// Применяет одно действие ко всем выбранным карточкам с отдельным исходом по каждой.
// Параметры:
//  Пользователи - Массив из СправочникСсылка.Пользователи - получатели.
//  Код - Строка - блокировка, включение в группу или копирование прав.
//  Параметр - СправочникСсылка, Неопределено - группа либо источник прав.
//  ПолныйМеханизм - Булево - штатный механизм совместимости БСП.
// Возвращаемое значение:
//  Структура - изменённые, пропущенные и ошибки по каждому пользователю.
Функция ДействиеНадПользователями(Пользователи, Код, Параметр, ПолныйМеханизм) Экспорт
	
	Если СтрРазделить("Блокировать,ДобавитьВГруппу,Копировать,КопироватьПоддерживаемые",
		",").Найти(Код) = Неопределено Тогда
		ВызватьИсключение НСтр("ru='Неизвестное действие над пользователями.'");
	КонецЕсли;
	
	Результат = Новый Структура("Изменены,Пропущены,Ошибки", Новый Массив, Новый Массив, Новый Массив);
	
	Для Каждого Пользователь Из Пользователи Цикл
		
		Детали = Новый Структура("Пользователь,Причина,ИдентификаторПользователяИБ", Строка(Пользователь), "", "");
		
		Попытка
			
			Детали.ИдентификаторПользователяИБ = Строка(Пользователь.ИдентификаторПользователяИБ);
			Данные = КомпонентДанные();
			Копирование = Код = "Копировать" Или Код = "КопироватьПоддерживаемые";
			
			Если Копирование И (Пользователь = Параметр
				Или Данные.СовпадаетСТекущимПользователем(Детали.ИдентификаторПользователяИБ)) Тогда
				
				Детали.Причина = ?(Пользователь = Параметр, НСтр("ru='Источник и получатель совпадают.'"),
					НСтр("ru='Текущая учётная запись защищена от изменения.'"));
				Результат.Пропущены.Добавить(Детали);
				Протокол = КомпонентДействия();
				Протокол.ЗаписатьРекомендованноеДействие(Код, Детали, "Пропущен");
				ПротоколДействий.Загрузить(Протокол.ЗаписиПротокола());
				Продолжить;
				
			КонецЕсли;
			
			Данные.ПроверитьЗащитуТекущейУчетки(Детали.ИдентификаторПользователяИБ);
			
			Если Код = "Блокировать" Тогда
				ЗаблокироватьПользователяИзСписка(Пользователь);
			ИначеЕсли Код = "ДобавитьВГруппу" Тогда
				
				Если Не ИзменитьЧленствоГруппы(Пользователь, Параметр, Истина) Тогда
					
					Детали.Причина = НСтр("ru='Пользователь уже состоит в группе.'");
					Результат.Пропущены.Добавить(Детали);
					
					Продолжить;
					
				КонецЕсли;
				
			ИначеЕсли Код = "КопироватьПоддерживаемые" Тогда
				
				КомпонентКопирование().СкопироватьПоддерживаемыеПрава(Пользователь, Параметр);
				Возможности = ВозможностиКопированияПрав();
				Детали.Причина = НСтр("ru='Перенесены:'") + " " + Возможности.Описание + НСтр("ru='. Не перенесены:'")
					+ " " + Возможности.Ограничения;
				Действия = КомпонентДействия();
				Действия.ЗаписатьРекомендованноеДействие("Копировать", Детали, НСтр("ru='Выполнено частично'"));
				ПротоколДействий.Загрузить(Действия.ЗаписиПротокола());
				
			Иначе
				
				СкопироватьПраваДоступаПользователей(Пользователь, Параметр, ПолныйМеханизм);
				ЗаписатьКопированиеВПротокол(Пользователь, Параметр, Истина);
				
			КонецЕсли;
			
			Если Код <> "КопироватьПоддерживаемые" Тогда
				Детали.Причина = НСтр("ru='Действие выполнено.'");
			КонецЕсли;
			
			Результат.Изменены.Добавить(Детали);
			
		Исключение
			
			Детали.Причина = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			Результат.Ошибки.Добавить(Детали);
			Действия = КомпонентДействия();
			Действия.ЗаписатьРекомендованноеДействие(Код, Детали, "Ошибка");
			ПротоколДействий.Загрузить(Действия.ЗаписиПротокола());
			
		КонецПопытки;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает представление из уже прочитанных дней.
//
// Параметры:
//  АдресКеша - Строка - адрес кеша текущей формы.
//  Период - СтандартныйПериод - выбранные границы.
//  ИдентификаторПользователя - Строка - UUID; пустая строка означает всех.
//  ИдентификаторФормы - УникальныйИдентификатор - владелец временных данных.
//
// Возвращаемое значение:
//  Структура, Неопределено - статистика либо недостающие дни.
Функция ПроекцияДействий(АдресКеша, Период, ИдентификаторПользователя, ИдентификаторФормы) Экспорт
	
	Возврат Компонент("Активность").ПроекцияДействий(АдресКеша, Период.ДатаНачала,
		Период.ДатаОкончания, ИдентификаторПользователя, ИдентификаторФормы);
	
КонецФункции

// Обновляет только записи, затронутые массовым действием.
//
// Параметры:
//  Результат - Структура - изменённые и пропущенные учётки.
//  ПорогДней - Число - порог неактивности.
//  АдресПодтверждений - Строка - адрес результатов проверки паролей.
Процедура АктуализироватьРезультатРекомендации(Результат, ПорогДней, АдресПодтверждений = "") Экспорт
	
	Выбранные = Новый Массив;
	Идентификаторы = Новый Соответствие;
	
	Для Каждого ИмяГруппы Из СтрРазделить("Изменены,Пропущены,Ошибки", ",") Цикл
		
		Для Каждого Детали Из Результат[ИмяГруппы] Цикл
			Идентификаторы.Вставить(Детали.ИдентификаторПользователяИБ, Истина);
		КонецЦикла;
		
	КонецЦикла;
	
	Для Каждого СтрокаАудита Из АудитПользователей Цикл
		
		Если Идентификаторы.Получить(СтрокаАудита.ИдентификаторПользователяИБ) = Истина Тогда
			Выбранные.Добавить(Новый Структура("ИдентификаторПользователяИБ,ПользовательБСП",
				СтрокаАудита.ИдентификаторПользователяИБ, СтрокаАудита.ПользовательБСП));
		КонецЕсли;
		
	КонецЦикла;
	
	АктуализироватьВыбранных(Выбранные, ПорогДней, АдресПодтверждений);
	
КонецПроцедуры

// Формирует навигацию по текущим категориям.
//
// Параметры:
//  Категории - ТаблицаЗначений - видимые категории.
//  ТекущаяКатегория - Строка - код выбранной категории.
//
// Возвращаемое значение:
//  Строка - HTML навигации.
Функция HTMLКатегорий(Категории, ТекущаяКатегория) Экспорт
	
	Возврат Компонент("Интерфейс").HTMLКатегорий(Категории, ТекущаяКатегория);
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область РегистрацияБСП

Функция НовыеКоманды()
	
	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("Использование", Новый ОписаниеТипов("Строка"));
	Команды.Колонки.Добавить("ПоказыватьОповещение", Новый ОписаниеТипов("Булево"));
	Команды.Колонки.Добавить("Модификатор", Новый ОписаниеТипов("Строка"));
	
	Возврат Команды;
	
КонецФункции

Процедура ДобавитьКоманду(Команды, Представление, Идентификатор, Использование, ПоказыватьОповещение = Ложь, Модификатор = "")
	
	НоваяКоманда = Команды.Добавить();
	НоваяКоманда.Представление = Представление;
	НоваяКоманда.Идентификатор = Идентификатор;
	НоваяКоманда.Использование = Использование;
	НоваяКоманда.ПоказыватьОповещение = ПоказыватьОповещение;
	НоваяКоманда.Модификатор = Модификатор;
	
КонецПроцедуры

#КонецОбласти


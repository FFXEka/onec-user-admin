	Если Не ПравоДоступа("Администрирование", Метаданные) Тогда
		ВызватьИсключение НСтр("ru='Для снимков аудита нужны права администратора информационной базы.'");
	КонецЕсли;
	
	Строки = КомпонентДанные().СтрокиСнимка(АудитПользователей.Выгрузить());
	
	Возврат Компонент("Снимки").ФайлАудита(Строки, Контекст.Источник, Контекст.Дата, Контекст.Признаки,
		ВерсияОбработки);
	
КонецФункции


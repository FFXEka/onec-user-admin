//
// Возвращаемое значение:
//  Структура - начальный прогресс и строки аудита для последующего применения результата.
Функция НоваяПроверкаСлабыхПаролей(ИдентификаторФормы, АдресКеша = "") Экспорт
	
	Если Не ПроверкаСлабыхПаролейДоступна() Тогда
		ВызватьИсключение НСтр("ru='Проверка слабых паролей требует платформу 1С 8.3.10 или новее.'");
	КонецЕсли;
	
	Если АудитПользователей.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru='Сначала выполните аудит пользователей.'");
	КонецЕсли;
	
	Строки = КомпонентДанные().СтрокиСнимка(АудитПользователей.Выгрузить());
	Идентификаторы = Новый Массив;
	
	Для Каждого СтрокаАудита Из Строки Цикл
		
		Если СтрокаАудита.НайденПользовательИБ И СтрокаАудита.АутентификацияСтандартная Тогда
			Идентификаторы.Добавить(СтрокаАудита.ИдентификаторПользователяИБ);
		КонецЕсли;
		
	КонецЦикла;
	
	Исполнитель = ИсполнительПроверкиПаролей();
	Проверка = Исполнитель.НоваяПроверка(Идентификаторы, ИдентификаторФормы, Истина, АдресКеша);
	
	Возврат Новый Структура("Прогресс,БазовыеСтроки", Проверка, Строки);
	
КонецФункции

